<style is:inline>
/* Desktop comments (Vishal 2026-10-19, Vercel toolbar) */
/* 1. "so much space on the right": the intro runs in two columns across the full width instead of one 66ch column */
@media (min-width:1100px){#page>p:not(.eyebrow){max-width:none;column-count:2;column-gap:56px}}
/* 2. "the desktop is looking like a tablet": the screen sits in a browser window (bar, three dots, address) not a grey bezel */
.lap{background:#F6EEEE!important;padding:0!important;border-radius:14px!important;overflow:hidden;box-shadow:0 0 0 1px #EBDADA,0 24px 60px rgba(131,26,26,.14)!important}
.lapbar{display:flex;align-items:center;gap:7px;height:40px;padding:0 16px;background:#F6EEEE;border-bottom:1px solid #EBDADA}
.lapbar i{width:11px;height:11px;border-radius:50%;background:#E3CFCF}
.lapbar span{margin:0 auto;padding:5px 18px;border-radius:8px;background:#fff;font:500 12px/1 var(--sans);color:#6E5555;transform:translateX(-27px)}
.lap .sc{border-radius:0!important}
/* 3. Assets "way too small": the day cards fill the band, and the deal cards join them */
figure.cut.pwbig img{max-width:none!important;width:100%}
figure.cut.pwbig img+img,figure.cut.pwbig span+span{margin-top:16px}
article>section>figure.cut.pwbig{display:block!important}
</style>

<style is:inline>
/* Results in Metropolis: numbers ExtraBold, labels Bold, one light panel on the red band (Vishal 19 Oct 13:05) */
#results{--band:#4A0B12}
#results .stats.big{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;background:#FFF5F4;border-radius:20px;padding:0;overflow:hidden}
#results .stats.big div{padding:32px 28px 30px;gap:10px;border:0;align-content:start}
#results .stats.big div+div{border-left:1px solid #F1D8D8}
#results .stats.big b{font-family:Metropolis,sans-serif;font-weight:800;font-size:clamp(30px,3.1vw,48px);line-height:1;letter-spacing:-.035em;color:#B31919;white-space:nowrap;min-width:0}
#results .stats.big span{font-family:Metropolis,sans-serif;font-weight:700;font-size:16px;line-height:1.4;color:#2A0F0F;max-width:22ch;text-wrap:balance}
@media (max-width:900px){#results .stats.big{grid-template-columns:1fr 1fr}#results .stats.big div:nth-child(3){border-left:0}#results .stats.big div:nth-child(n+3){border-top:1px solid #F1D8D8}}
@media (max-width:620px){#results .stats.big div{grid-template-columns:none;padding:20px 16px;gap:8px}#results .stats.big b{font-size:min(26px,6.6vw)}#results .stats.big span{font-size:14px}}
</style>

<style is:inline>
/* Universal (Vishal 19 Oct 13:09): project names in the footer are never white; a light tint of the page colour, like OneBanc */
.endsec .nextgrid b{color:#FFC9C9!important}.endsec .nextgrid a{background:#6B1C25!important;box-shadow:0 0 0 1px rgba(255,201,201,.18)!important}
</style>

<style is:inline>
/* Phones only (Vishal 19 Oct 13:09) */
@media (max-width:760px){
  #page .dvd,#page .lap{display:none}
  .stage{background:none;padding:0;border-radius:0}
  .stage .iph{border-radius:36px;min-width:0;flex:0 1 auto}.stage .iph>.sc{border-radius:31px;overflow-x:hidden}
  .pwbox{background:#8E1520}
  .pwp{height:1760px;background:#FEF5F6;position:absolute;left:0;top:0}
  .iph .sc .pwbg{inset:-2px auto auto 0}
  .pwflash::after{display:none}
  .pwflash{display:grid;grid-template-columns:1fr 1fr;gap:14px;overflow:visible}
  .iph .sc .pwflash img{width:100%;height:auto;aspect-ratio:157/284}
  :root{--disp:"Metropolis",ui-sans-serif,system-ui,sans-serif}
  section h2,.stats.big b,blockquote{font-weight:700;letter-spacing:-.02em}
  header.hero h1,.closing h2{font-family:"Sansita",Georgia,serif}
}
</style>

<style is:inline>
/* Marketing asset labels (Vishal 19 Oct 13:16): which one is what */
.mk figcaption.mkl{margin-top:12px;font:600 14px/1.3 Metropolis,sans-serif;letter-spacing:.02em;color:#831A1A;text-align:left}
</style>

<style is:inline>
/* Desktop phone (Vishal 19 Oct 13:20): smaller, sized to the window so it pins and the screen scrolls first; full screen shows the framed, working prototype */
.stage:fullscreen .iph{width:var(--pw)}
.pwfs{position:absolute;top:-52px;right:0;width:40px;height:40px;display:grid;place-items:center;border:0;border-radius:50%;background:#831A1A;color:#FFE9E9;cursor:pointer}
.pwfs:hover{background:#6B1C25}.pwfs:focus-visible{outline:2px solid #831A1A;outline-offset:3px}
.stage:fullscreen{--pw:min(440px,calc((100vh - 64px) / 2.143));align-items:center;padding:32px;border-radius:0;background:#1F0A0B}
.stage:fullscreen .pin-wrap{height:auto!important}.stage:fullscreen .screen{position:static!important}.stage:fullscreen .pm-scr{overflow-y:auto!important}
.stage:fullscreen .pwfs{position:fixed;top:16px;right:16px;width:44px;height:44px;background:rgba(255,233,233,.12);box-shadow:0 0 0 1px rgba(255,233,233,.28)}
@media (max-width:760px){.pwfs{display:none}}
</style>
<script is:inline>
(()=>{const b=document.querySelector('.pwfs'),st=b&&b.closest('.stage');if(!st)return;if(!document.fullscreenEnabled){b.hidden=true;return}
b.addEventListener('click',()=>document.fullscreenElement?document.exitFullscreen():st.requestFullscreen());
document.addEventListener('fullscreenchange',()=>b.setAttribute('aria-label',document.fullscreenElement===st?'Exit full screen':'Open the prototype full screen'))})();
</script>
<style is:inline>
/* Breathing space between assets (Vishal 19 Oct 13:29), desktop and phones */
figure.cut.pwbig>:is(img,span):not(:first-child){margin-top:48px}
.mk{row-gap:56px;column-gap:40px}
@media (max-width:760px){figure.cut.pwbig>:is(img,span):not(:first-child){margin-top:28px}.mk{row-gap:40px}}
</style>
