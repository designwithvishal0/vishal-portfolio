/* Vishal 2026-10-14 02:50: on desktop the screens were too small (400px cards tucked in the text column, a 340px phone for the full page).
   Section screens now sit on their own stage under the text, at full size; the full landing page is shown whole, in three tall columns, read top to bottom. Phones keep the phone. */
.strip{display:none}
@media (min-width:1100px){
  article>section:not(.wide)>figure.cut,article>section:not(.wide)>.cuts{grid-column:1/-1;margin-top:56px!important;padding:clamp(40px,4vw,64px);border-radius:28px;background:color-mix(in srgb,var(--acc) 7%,var(--band,#fff));display:flex;justify-content:center;gap:40px;align-items:flex-start}
  article>section:not(.wide)>figure.cut img{width:min(560px,100%);max-width:none}
  .cuts .cut{margin:0}.cuts .cut img{width:min(480px,100%)}
  #design .iph.lpd{display:none}
  .strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(20px,2.4vw,40px);margin-top:48px;max-width:1240px;margin-inline:auto}
  .strip>div{aspect-ratio:720/3587;overflow:hidden;border-radius:20px;box-shadow:0 0 0 1px rgba(255,255,255,.08),0 24px 60px rgba(0,0,0,.35);background:#fff}
  .strip img{display:block;width:100%;height:auto}
}
</style>
<style is:inline>
/* Phones only (Vishal 04:29, the ixigo hero pattern): hero heading bold (700) at the same size; a two line hook sits tight under it. Desktop unchanged. */
@media (max-width:640px){header.hero h1{font-weight:700}}
</style>
<script is:inline src="/js/pin-frames.js" defer></script>
<script is:inline src="/js/pin-screen.js" defer></script>
</html>

<style is:inline>
/* Phones (Vishal 04:31): project details as one row per fact, label left and value right, as on Split and Twelve, instead of squeezed or uneven columns */
@media (max-width:620px){
  .wrap>.facts{grid-template-columns:minmax(0,1fr)!important;gap:0;padding-block:4px}
  .wrap>.facts>div{grid-column:auto!important;display:grid;grid-template-columns:104px minmax(0,1fr);gap:12px;align-items:baseline;padding-block:14px}
  .wrap>.facts>div+div{border-top:1px solid var(--line)}
  .wrap>.facts>div>:not(.k){font-size:16px;line-height:1.45;text-wrap:pretty}
  .wrap>.facts .k{margin:0}
}
</style>

<script is:inline>(function(){var s=document.getElementById('tocsheet'),mq=matchMedia('(max-width:759px)'),root=document.documentElement,ty=0;if(!s)return;
function lock(e){root.classList.toggle('toclock',e.newState==='open'&&mq.matches)}s.addEventListener('beforetoggle',lock);s.addEventListener('toggle',lock);
addEventListener('touchstart',function(e){ty=e.touches[0].clientY},{passive:true});
addEventListener('touchmove',function(e){if(!root.classList.contains('toclock'))return;var dy=e.touches[0].clientY-ty;if(!s.contains(e.target)||(dy>0&&s.scrollTop<=0)||(dy<0&&s.scrollTop+s.clientHeight>=s.scrollHeight-1))e.preventDefault()},{passive:false});})();</script>
