<script is:inline>
(function(){
  if(!matchMedia('(max-width:620px)').matches)return;
  function btn(before,open){var b=document.createElement('button');b.type='button';b.className='rmore';b.textContent='Read more';b.setAttribute('aria-expanded','false');b.onclick=function(){open();b.remove()};before.parentNode.insertBefore(b,before);return b}
  // Section body: keep the first paragraph, fold the rest of the paragraphs and quotes
  document.querySelectorAll('article>section').forEach(function(sec){
    var body=[].filter.call(sec.children,function(e){return (e.tagName==='P'&&!e.classList.contains('eyebrow'))||e.tagName==='BLOCKQUOTE'});
    var rest=body.slice(1), words=rest.reduce(function(n,e){return n+e.textContent.split(/\s+/).length},0);
    if(!rest.length||words<30)return;
    rest.forEach(function(e){e.classList.add('rm-hid')});
    btn(rest[0],function(){rest.forEach(function(e){e.classList.remove('rm-hid')})});
  });
  // Long single paragraphs beside the screens: show four lines, then Read more
  document.querySelectorAll('.screen>div>p').forEach(function(p){
    p.classList.add('rm-clamp');if(p.scrollHeight<=p.clientHeight+2){p.classList.remove('rm-clamp');return}
    var b=btn(p,function(){p.classList.remove('rm-clamp')});p.after(b);
  });
})();
</script>
