---
import '@fontsource-variable/hanken-grotesk';
import '../../styles/components.css';
import Boot from '../../components/Boot.astro';
import Arrow from '../../components/Arrow.astro';
import { intro, work, live, email, social, loops, results, more, lead, pages, how, jobs } from '../../data/home';

// Look 1, Clean with motion: Clean, plus his real product loops playing in the hero one after another,
// each under the question its user is asking. His photo moves to About.
// The four questions are new copy from Direction C and still need his yes.
const sizes = ['wide', 'half', 'half', 'wide'];
// The resume button shows once the site copy of the CV exists.
const words = intro.positioning.split(' ');
const ctas = intro.links.filter(l => l.href !== '#').reverse();
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Look: Clean with motion, Vishal Yadav</title>
<meta name="robots" content="noindex" />
<meta name="color-scheme" content="light dark" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<Boot />
</head>
<body>
<div class="wrap">
  <header class="top">
    <div class="top-l">
      <h1>{intro.name}</h1>
      <span class="status"><span class="dot" aria-hidden="true"></span>{intro.availability}</span>
    </div>
    <nav class="topnav" aria-label="Sections"><a href="#work">Work</a><a href="#about">About</a><a href="#contact">Contact</a></nav>
    <button id="theme" type="button">Dark mode</button>
  </header>

  <main>
  <section class="hero">
    <p class="pos words"><span class="vh">{intro.positioning}</span>{words.map((w, i) => <><span class="w" aria-hidden="true"><span style={`--i:${i}`}>{w}</span></span>{i < words.length - 1 && ' '}</>)}</p>
    <div class="hero-row">
      <div class="hero-copy">
        <p class="sup enter" style="--d:260ms">{intro.supporting}</p>
        <ul class="aud enter" style="--d:320ms" aria-label="Start here">
          <li><a class="go" href="#work"><strong>Hiring a product designer</strong> <span>See the case studies</span><Arrow /></a></li>
          <li><a class="go" href="#results"><strong>Recruiting</strong> <span>The 30 second version</span><Arrow /></a></li>
          <li><a class="go" href="#pages"><strong>Founder</strong> <span>Need a page that sells</span><Arrow /></a></li>
        </ul>
        <div class="cta enter" style="--d:380ms">
          {ctas.map((l, i) => <a class={`btn${i ? '' : ' primary'}`} href={l.href}>{l.label}</a>)}
        </div>
      </div>
      <figure class="reel enter" style="--d:440ms" data-state="paused" aria-label="Previews of the four case studies">
        <div class="stage">
          {work.map((w, i) => (
            <div class={`slide${i ? '' : ' on'}`}>
              <a class="mlink" href={live(w.slug)} tabindex="-1" aria-hidden="true"></a>
              <img src={`/loops/${loops[i]}.jpg`} alt="" width="1200" height="900" loading={i ? 'lazy' : 'eager'} fetchpriority={i ? undefined : 'high'} decoding="async" />
              <video muted playsinline preload={i ? 'none' : 'auto'} aria-hidden="true" tabindex="-1"><source src={`/loops/${loops[i]}.mp4`} type="video/mp4" /><source src={`/loops/${loops[i]}.webm`} type="video/webm" /></video>
            </div>
          ))}
          <button class="vctl" type="button" aria-label="Play the previews">
            <svg class="i-pause" viewBox="0 0 14 14" aria-hidden="true"><rect x="2" y="1" width="3.5" height="12" rx="1" /><rect x="8.5" y="1" width="3.5" height="12" rx="1" /></svg>
            <svg class="i-play" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.6v10.8a.8.8 0 0 0 1.2.7l9-5.4a.8.8 0 0 0 0-1.4l-9-5.4A.8.8 0 0 0 3 1.6z" /></svg>
          </button>
        </div>
        <ol class="segs">{work.map((w, i) => <li><button class="seg" type="button" aria-label={`Show ${w.name}`} aria-current={i ? undefined : 'true'}></button></li>)}</ol>
        <figcaption class="caps">
          {work.map((w, i) => (
            <div class={`cap${i ? '' : ' on'}`}>
              <p class="q"><span class="vh">{w.question}</span>{w.question.split(' ').map((x, k) => <><span class="w" aria-hidden="true"><span style={`--i:${k}`}>{x}</span></span>{' '}</>)}</p>
              <a class="rn go" href={live(w.slug)}><strong>{w.name}</strong> <span>View the case study</span><Arrow /></a>
            </div>
          ))}
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="results" id="results" aria-labelledby="r-h">
    <h2 id="r-h">Shipped at CashKaro, for 25M+ users</h2>
    <div class="r-grid">
      {results.map(r => <div><div class="r-num" data-n={parseInt(r.n)}>{r.n}</div><div class="r-label">{r.label}</div></div>)}
    </div>
  </section>

  <div class="sec-head" id="work"><h2>Selected work</h2><span>4 case studies</span></div>
  <section class="work" aria-label="Selected work">
    {work.map((w, i) => (
      <article class={`tile reveal ${sizes[i]}`}>
        <div class="media" data-state="paused">
          <a class="mlink" href={live(w.slug)} tabindex="-1" aria-hidden="true"></a>
          <img src={`/loops/${loops[i]}.jpg`} alt={w.alt} width="1200" height="900" loading={i ? 'lazy' : 'eager'} decoding="async" />
          <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"><source src={`/loops/${loops[i]}.mp4`} type="video/mp4" /><source src={`/loops/${loops[i]}.webm`} type="video/webm" /></video>
          <button class="vctl" type="button" data-name={w.name} aria-label={`Play the ${w.name} preview`}>
            <svg class="i-pause" viewBox="0 0 14 14" aria-hidden="true"><rect x="2" y="1" width="3.5" height="12" rx="1" /><rect x="8.5" y="1" width="3.5" height="12" rx="1" /></svg>
            <svg class="i-play" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.6v10.8a.8.8 0 0 0 1.2.7l9-5.4a.8.8 0 0 0 0-1.4l-9-5.4A.8.8 0 0 0 3 1.6z" /></svg>
          </button>
        </div>
        <div class="meta"><span class="pname">{w.name}</span><span class="pill">{w.type.includes('B2B') ? 'B2B concept' : 'Concept'}</span><span>{w.year}</span></div>
        <h3><a href={live(w.slug)}>{w.headline}<span class="vh">, the {w.name} case study</span></a></h3>
        <p>{w.problem}</p>
        <p class="scope"><span>{w.role}</span><span>{w.detail}</span></p>
        <a class="more" href={live(w.slug)} tabindex="-1" aria-hidden="true">View the case study <Arrow /></a>
      </article>
    ))}
  </section>
  <ul class="morework reveal" aria-label="More work">
    {more.map(m => (
      <li><a class="mw go" href={m.href}>
        <img src={`/pages/${m.img}.webp`} alt="" width="56" height="56" loading="lazy" decoding="async" />
        <span class="mwt"><strong>{m.name}</strong><span>{m.line}</span></span>
        <span class="pill">Concept</span><Arrow />
      </a></li>
    ))}
  </ul>

  <div class="sec-head" id="pages"><h2>Pages that sell</h2><span>Campaigns, landing pages and product pages for commerce brands.</span></div>
  <section class="pages" aria-label="Pages that sell">
    <article class="page lead reveal">
      <div class="thumb"><img src={`/pages/${lead.img}.webp`} alt={`${lead.name}, preview`} width="960" height="1004" loading="lazy" decoding="async" /></div>
      <div class="ptext">
        <span class="ptag"><span class="pill shipped">{lead.tag}</span></span>
        <h3>{lead.name}</h3>
        <p>{lead.line}</p>
        <dl class="pstats">{lead.stats.map(([n, l]) => <div><dt>{l}</dt><dd>{n}</dd></div>)}</dl>
      </div>
    </article>
    <ul class="rail">
      {pages.map(p => (
        <li class="reveal"><a class="page go" href={p.href}>
          <div class="thumb"><img src={`/pages/${p.img}.webp`} alt={`${p.name}, preview`} width="960" height="1004" loading="lazy" decoding="async" /></div>
          <span class="ptag">{p.tag && <span class={`pill${p.tag.startsWith('Shipped') ? ' shipped' : ''}`}>{p.tag}</span>}</span>
          <h3>{p.name}</h3>
          <p>{p.line}</p>
          <span class="more">View on Behance <Arrow /></span>
        </a></li>
      ))}
    </ul>
  </section>
  <p class="freelance reveal">Need a page that sells? <a class="ul" href="#contact">See how I work with founders</a></p>

  <div class="sec-head"><h2>How I work</h2></div>
  <section class="how" aria-label="How I work">
    {how.map(x => <div class="reveal"><h3>{x.h}</h3><p>{x.p}</p><a class="more go" href={x.href}>{x.link} <Arrow /></a></div>)}
  </section>

  <div class="sec-head" id="about"><h2>About</h2></div>
  <section class="about reveal" aria-label="About">
    <div class="portrait"><img src="/me/vishal-600.webp" srcset="/me/vishal-600.webp 600w, /me/vishal-1200.webp 1200w" sizes="(min-width: 761px) 260px, 56vw" width="1200" height="1500" alt="Vishal Yadav" loading="lazy" decoding="async" /></div>
    <p class="lead-p">From October 2023 to August 2026 I designed app and web flows at CashKaro, India’s largest cashback platform, and built, in Figma, the design system its campaigns run on. Before that I was a graphic designer at an agency, which is why what I ship looks finished (that work lives in <a class="ul" href="https://www.behance.net/design_vishaly">the archive</a>). I studied Computer Science, so I know what engineers need at handoff, and I use AI to move faster through research and iteration while the design calls stay mine.</p>
    <dl class="jobs">{jobs.map(([c, r, y]) => <div><dt>{c}</dt><dd>{r}</dd><dd class="y">{y}</dd></div>)}</dl>
  </section>

  <section class="contact reveal" id="contact" aria-labelledby="c-h">
    <h2 id="c-h"><span class="vh">Hiring, or need a page that sells?</span>{'Hiring, or need a page that sells?'.split(' ').map((x, k) => <><span class="w" aria-hidden="true"><span style={`--i:${k}`}>{x}</span></span>{' '}</>)}</h2>
    <p>Email me at <button class="copy" type="button" data-copy={email}>{email} <span class="tag" aria-hidden="true"><span class="t-copy">Copy</span><span class="t-done">Copied</span></span></button> or book a call. I reply within a day.</p>
    <span class="vh" role="status" id="copied"></span>
    <div class="cta">
      <a class="btn primary" href="https://cal.com/designwvishal">Book a call</a>
      <a class="btn" href={`mailto:${email}`}>Email</a>
    </div>
    <p class="elsewhere">You can also find me on <a class="ul" href={social[0][1]}>LinkedIn</a> and <a class="ul" href={social[1][1]}>Behance</a>.</p>
  </section>
  </main>

  <footer>
    <nav aria-label="Elsewhere" class="social">{social.map(([l, h]) => <a class="ul" href={h}>{l}</a>)}</nav>
    <span class="toggles"><button id="calm" type="button" aria-pressed="false">Reduce motion</button></span>
  </footer>
</div>
<script>import '../../scripts/ui';</script>
<script>
  // The hero reel plays the four loops in turn while it is half in view. Each plays once, then hands over.
  // Under reduced motion nothing starts on its own; the play button and the bars still work.
  const reel = document.querySelector<HTMLElement>('.reel');
  if (reel) {
    const slides = [...reel.querySelectorAll<HTMLElement>('.slide')];
    const caps = [...reel.querySelectorAll<HTMLElement>('.cap')];
    const segs = [...reel.querySelectorAll<HTMLButtonElement>('.seg')];
    const btn = reel.querySelector<HTMLButtonElement>('.vctl')!;
    const vids = slides.map(s => s.querySelector('video')!);
    const osCalm = matchMedia('(prefers-reduced-motion: reduce)');
    const calm = () => osCalm.matches || document.documentElement.classList.contains('calm');
    let i = 0, shown = false, user: boolean | null = null, raf = 0;
    const fill = (k: number, p: number) => segs[k].style.setProperty('--p', String(p));
    const tick = () => { const v = vids[i]; if (v.duration) fill(i, v.currentTime / v.duration); raf = requestAnimationFrame(tick); };
    const sync = () => {
      const run = user === null ? shown && !calm() : user && shown;
      cancelAnimationFrame(raf);
      if (run) { vids[i].play().catch(() => {}); raf = requestAnimationFrame(tick); } else vids[i].pause();
      reel.dataset.state = run ? 'playing' : 'paused';
      btn.setAttribute('aria-label', `${run ? 'Pause' : 'Play'} the previews`);
    };
    const go = (k: number) => {
      vids[i].pause();
      slides[i].classList.remove('on'); caps[i].classList.remove('on'); segs[i].removeAttribute('aria-current');
      i = k;
      vids[i].currentTime = 0;
      vids[(i + 1) % vids.length].preload = 'auto';
      segs.forEach((_, n) => fill(n, n < i ? 1 : 0));
      slides[i].classList.add('on'); caps[i].classList.add('on'); segs[i].setAttribute('aria-current', 'true');
      reel.dataset.moved = '';
      sync();
    };
    vids.forEach((v, k) => {
      v.addEventListener('playing', () => slides[k].classList.add('started'), { once: true });
      v.addEventListener('ended', () => { if (k === i) go((i + 1) % vids.length); });
    });
    segs.forEach((s, k) => s.addEventListener('click', () => { if (k !== i) go(k); }));
    btn.addEventListener('click', () => { user = reel.dataset.state !== 'playing'; reel.dataset.user = ''; sync(); });
    new IntersectionObserver(([e]) => { shown = e.isIntersecting; sync(); }, { threshold: .5 }).observe(reel.querySelector('.stage')!);
    osCalm.addEventListener('change', sync);
    document.getElementById('calm')?.addEventListener('click', () => setTimeout(sync));
  }
</script>
</body>
</html>

<style>
  .morework{list-style:none;margin:0 0 var(--s32);padding:0;display:grid;gap:12px}
  @media (min-width:760px){.morework{grid-template-columns:1fr 1fr;gap:32px}}
  .mw{display:flex;align-items:center;gap:16px;padding:12px 0;border-top:1px solid var(--rule);text-decoration:none;min-height:80px}
  .mw img{flex:none;width:56px;height:56px;border-radius:12px;object-fit:cover;object-position:50% 0;background:var(--card)}
  .mwt{flex:1;display:flex;flex-direction:column;min-width:0}
  .mwt strong{font-weight:var(--w-strong)}
  .mwt span{color:var(--muted);font-size:var(--fs-meta)}

  .pages{display:grid;gap:72px}
  .page{display:block;text-decoration:none}
  .page.lead{display:grid;grid-template-columns:7fr 5fr;gap:48px;align-items:center}
  .thumb{background:var(--card);border-radius:var(--r-card);overflow:hidden;aspect-ratio:1;border:1px solid var(--rule);transition:border-color var(--hover) var(--ease-out)}
  .thumb img{width:100%;height:100%;object-fit:cover;object-position:50% 0;display:block;transition:transform var(--section) var(--ease-out)}
  .ptag{display:flex;align-items:center;min-height:28px;margin-top:18px}
  .lead .ptag{margin-top:0}
  .page h3{font-size:var(--fs-ui);font-weight:var(--w-strong);color:var(--muted);margin:10px 0 4px}
  .page p{margin:0;font-size:var(--fs-sup);font-weight:var(--w-head);line-height:var(--lh-head);letter-spacing:var(--track-head)}
  .lead p{font-size:var(--fs-h3)}
  .pstats{display:grid;grid-template-columns:repeat(3,auto);justify-content:start;gap:16px 40px;margin:28px 0 0;padding:20px 0 0;border-top:1px solid var(--rule)}
  .pstats div{display:flex;flex-direction:column-reverse}
  .pstats dt{font-size:var(--fs-meta);color:var(--muted)}
  .pstats dd{margin:0;font-size:var(--fs-h3);font-weight:var(--w-head);letter-spacing:var(--track-stat);font-variant-numeric:tabular-nums;white-space:nowrap}
  .page .more{margin-top:14px}
  @media (hover:hover) and (pointer:fine){a.page:hover .thumb{border-color:var(--ink)}a.page:hover .thumb img{transform:scale(1.03)}}
  .rail{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:32px}
  .rail li{min-width:0}
  @media (max-width:900px){.page.lead{grid-template-columns:1fr 1fr;gap:32px}.rail{grid-template-columns:1fr 1fr;gap:48px 24px}}
  @media (max-width:560px){
    .page.lead{grid-template-columns:1fr;gap:20px}
    .pstats{gap:16px 24px}
    .rail{grid-auto-flow:column;grid-template-columns:none;grid-auto-columns:78%;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;margin:0 calc(var(--gutter) * -1);padding:0 var(--gutter) 8px;scroll-padding:0 var(--gutter);scrollbar-width:none}
    .rail::-webkit-scrollbar{display:none}
    .rail li{scroll-snap-align:start}
  }
  .freelance{margin:72px 0 var(--s32);font-size:var(--fs-sup)}
  .freelance a{font-weight:var(--w-strong)}

  .how{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;padding:0 0 var(--s32)}
  .how div{display:flex;flex-direction:column;align-items:flex-start}
  .how h3{font-size:var(--fs-h3);line-height:var(--lh-head);letter-spacing:var(--track-head);font-weight:var(--w-head);margin:0 0 12px}
  .how p{margin:0 0 20px;color:var(--muted);max-width:34ch}
  .how .more{margin-top:auto}

  .about{display:grid;grid-template-columns:1.4fr 1fr;gap:56px;padding:0 0 var(--s32)}
  .lead-p{font-size:var(--fs-lead);margin:0;max-width:var(--measure)}
  .jobs{margin:0;display:grid;gap:20px;align-content:start}
  .jobs div{padding-top:16px;border-top:1px solid var(--rule)}
  .jobs dt{font-weight:var(--w-strong)}
  .jobs dd{margin:0;color:var(--muted)}

  .contact{border-top:1px solid var(--rule);padding:72px 0 var(--s32)}
  .contact h2{font-size:var(--fs-h1);line-height:1.02;letter-spacing:-.035em;font-weight:var(--w-head);margin:0 0 24px;max-width:16ch}
  .contact p{font-size:var(--fs-sup);margin:0 0 32px;max-width:56ch}
  .contact .elsewhere{font-size:var(--fs-ui);color:var(--muted);margin:32px 0 0}
  .elsewhere a{color:var(--ink)}

  .social{display:flex;flex-wrap:wrap;gap:0 20px}
  .social a{color:var(--ink);padding:9px 0;background-origin:content-box;background-clip:content-box}
  .toggles{display:flex;gap:var(--s2);flex-wrap:wrap}

  @media (max-width:760px){
    .how{grid-template-columns:1fr;gap:48px;padding-bottom:var(--s18)}
    .about{grid-template-columns:1fr;gap:40px;padding-bottom:var(--s18)}
    .morework,.freelance{margin-bottom:var(--s18)}
    .pages{gap:56px}
    .contact{padding:56px 0 var(--s18)}
  }
  @media (pointer:coarse){.social a{padding:11px 0}footer button{min-height:44px}}

  /* hero: the copy on the left, the reel on the right; on narrow screens the reel comes straight under the headline */
  .hero-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,520px);gap:56px;align-items:start}
  @media (max-width:900px){
    .hero-row{grid-template-columns:1fr;gap:32px}
    .reel{order:-1;max-width:600px}
  }

  /* the reel: one frame, four real product loops, each plays once and hands over to the next */
  .reel{margin:0}
  .stage{position:relative;isolation:isolate;aspect-ratio:4/3;border-radius:var(--r-card);overflow:hidden;background:var(--card)}
  .stage::after{content:"";position:absolute;inset:0;z-index:3;border-radius:inherit;pointer-events:none;box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--ink) 8%,transparent)}
  .slide{position:absolute;inset:0;opacity:0;transform:scale(1.04);transition:opacity 600ms var(--ease-out),transform 900ms var(--ease-out)}
  .slide.on{opacity:1;transform:none;z-index:1}
  .slide img,.slide video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .slide video{opacity:0;transition:opacity var(--enter) var(--ease-out)}
  .slide.started video{opacity:1}
  .slide .mlink{position:absolute;inset:0;z-index:2}
  .reel .vctl{z-index:4}
  .reel[data-state=paused] .vctl .i-play{opacity:1}
  .reel[data-state=paused] .vctl .i-pause{opacity:0}
  @media (hover:hover) and (pointer:fine){.reel:hover .vctl,.reel:focus-within .vctl,.reel[data-user] .vctl{opacity:1}}

  /* progress: one bar per project, the playing one fills as its loop runs, each bar jumps to its project */
  .segs{list-style:none;margin:10px 0 0;padding:0;display:flex;gap:6px}
  .segs li{flex:1}
  .seg{position:relative;display:block;width:100%;height:28px;padding:0;border:0;background:none;cursor:pointer}
  .seg::before,.seg::after{content:"";position:absolute;left:0;right:0;top:12px;height:3px;border-radius:2px}
  .seg::before{background:var(--edge)}
  .seg::after{background:var(--ink);transform:scaleX(var(--p,0));transform-origin:0 50%}
  @media (hover:hover) and (pointer:fine){.seg:hover::before{background:var(--muted)}}

  /* the question: all four share one cell so the reel never changes height; the active one rises in like the headline */
  .caps{display:grid;margin-top:6px}
  .cap{grid-area:1/1;visibility:hidden}
  .cap.on{visibility:visible}
  .q{font-size:var(--fs-h3);line-height:var(--lh-head);letter-spacing:var(--track-head);font-weight:var(--w-head);margin:0 0 6px}
  .q .w,.contact h2 .w{display:inline-block;overflow:hidden;vertical-align:top;padding-bottom:.1em;margin-bottom:-.1em}
  .q .w>span,.contact h2 .w>span{display:inline-block}
  .cap.on .q .w>span{animation:rise 700ms var(--ease-out) both;animation-delay:calc(var(--i) * 45ms + var(--qd,0ms))}
  .reel:not([data-moved]) .cap.on .q .w>span{--qd:620ms}
  .rn{display:inline-flex;align-items:center;gap:8px;min-height:36px;text-decoration:none;font-size:var(--fs-ui)}
  .rn strong{font-weight:var(--w-strong)}
  .rn span{color:var(--muted)}
  @media (pointer:coarse){.rn{min-height:44px}}
  @media (max-width:560px){.rn{flex-wrap:wrap;row-gap:2px;padding:6px 0}.rn strong{flex-basis:100%}}

  /* About carries the photo now: photo on the left, the story and the three jobs beside it; the crop sits on his face and leaves out the shirt print */
  .about{grid-template-columns:260px minmax(0,1fr);grid-template-rows:auto 1fr;column-gap:56px;row-gap:40px}
  .about .portrait{grid-row:1/-1}
  .about .jobs{grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
  @media (max-width:900px) and (min-width:761px){.about{grid-template-columns:200px minmax(0,1fr)}.about .jobs{grid-template-columns:1fr}}
  @media (max-width:760px){.about{grid-template-columns:1fr;row-gap:32px}.about .portrait{grid-row:auto}.about .jobs{grid-template-columns:1fr}}
  .portrait{width:100%;aspect-ratio:4/5;border-radius:var(--r-card);overflow:hidden;background:var(--card)}
  .portrait img{display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.3);transform-origin:50% 5%;filter:var(--photo)}
  @media (max-width:760px){.portrait{width:56%;max-width:260px}}

  /* one confident colour: the results card and the concept pills */
  .results{background:var(--cobalt);color:var(--on-cobalt);box-shadow:none}
  .results h2{color:var(--on-cobalt)}
  .r-label{color:var(--on-cobalt-soft)}
  .pill:not(.shipped){background:var(--pill-bg);border-color:transparent;color:var(--pill-ink)}
  /* outlined buttons draw their edge at 3:1 on the page; dividers keep the quiet rule colour */
  .btn,.top button,footer button,.copy .tag{--rule:var(--edge)}
</style>

<style is:global>
  /* work previews open from a slightly inset frame and settle as they scroll into view; stateless, so it plays back in reverse too */
  @supports (animation-timeline: view()){
    @media (prefers-reduced-motion:no-preference){
      /* the frame clips, so it is a scroll container of its own: the picture follows the frame's timeline, not its own */
      html:not(.calm) .work .media{view-timeline:--tile block;animation:unmask linear both;animation-timeline:--tile;animation-range:entry 0% entry 90%}
      html:not(.calm) .work .media img,html:not(.calm) .work .media video{animation:settle linear both;animation-timeline:--tile;animation-range:entry 0% cover 50%}
    }
  }
  @keyframes unmask{from{clip-path:inset(7% 5% round 32px)}to{clip-path:inset(0 round var(--r-card))}}
  @keyframes settle{from{transform:scale(1.14)}to{transform:none}}
  /* the closing headline rises word by word the first time it scrolls in */
  @media (prefers-reduced-motion:no-preference){
    html.js:not(.calm) .contact:not(.on) h2 .w>span{transform:translateY(110%)}
    html:not(.calm) .contact.on h2 .w>span{animation:rise 760ms var(--ease-out) both;animation-delay:calc(var(--i) * 45ms + 120ms)}
  }

  /* page tokens, both palettes, set the same way tokens.css sets them */
  :root{--pw:clamp(240px,22vw,304px);--cobalt:#2340B8;--on-cobalt:#FFFFFF;--on-cobalt-soft:#C9D3FF;--pill-bg:#E6EBFF;--pill-ink:#2340B8;--photo:none;--edge:#8A8A8E}
  @media (prefers-color-scheme:dark){:root:not([data-theme=light]){--pill-bg:#1C2C6E;--pill-ink:#D3DCFF;--photo:brightness(.9);--edge:#66666C}}
  :root[data-theme=dark]{--pill-bg:#1C2C6E;--pill-ink:#D3DCFF;--photo:brightness(.9);--edge:#66666C}
</style>
