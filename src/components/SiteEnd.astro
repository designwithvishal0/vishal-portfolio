---
// The home page ending (contact plus footer in one dark block), for pages that don't load kinetic.css.
// Markup and look copied from src/pages/looks/kinetic.astro and kinetic.css (.end); keep them in step.
import '@fontsource-variable/bricolage-grotesque/standard.css';
import { intro, email, social, contra } from '../data/home';
const book = intro.links.find(l => l.label === 'Book a call')!;
const resume = intro.links.find(l => l.label === 'Resume')!;
---
<div class="end">
  <section class="ct" id="contact" aria-labelledby="c-h">
    <div class="c">
      <h2 id="c-h">Hiring, or need a page that <span class="sells">sells?</span></h2>
      <div class="ct-r">
        <div class="cta">
          <a class="pill-btn primary" href={book.href}>{book.label}</a>
          <a class="pill-btn" href={resume.href} target="_blank" rel="noopener">{resume.label}</a>
        </div>
        <p class="cl">Email me at <a class="ul" href={`mailto:${email}`}>{email}</a> <button class="copy chip" type="button" data-copy={email} aria-label="Copy email address"><span class="tag" aria-hidden="true"><span class="t-copy">Copy</span><span class="t-done">Copied</span></span></button><br />I reply within a day.</p>
        <p class="cl">Want a page fixed? Send me the link, and I’ll bring my top three fixes to the call.</p>
        <span class="vh" role="status" id="copied"></span>
        <p class="here"><i aria-hidden="true"></i><span id="clock">Based in Gurugram, India</span></p>
        {contra && <p class="cl">You can also hire me on <a class="ul" href={contra}>Contra</a>.</p>}
      </div>
    </div>
  </section>
  <footer class="foot c">
    <nav aria-label="Elsewhere" class="social">{social.map(([l, h]) => <a class="ul" href={h}>{l}</a>)}</nav>
    <p class="copyr">© 2026 Vishal Yadav. All rights reserved.</p>
  </footer>
</div>
<script is:inline>(()=>{
const c=document.getElementById('clock'),f=new Intl.DateTimeFormat('en-IN',{timeZone:'Asia/Kolkata',hour:'numeric',minute:'2-digit',hour12:true}),t=()=>{c.textContent='It’s '+f.format(new Date()).toUpperCase()+' in Gurugram, India'};t();setInterval(t,30000);
const st=document.getElementById('copied');
document.querySelectorAll('.end [data-copy]').forEach(b=>b.addEventListener('click',async()=>{const x=b.dataset.copy;
  const legacy=()=>{const a=document.createElement('textarea');a.value=x;a.readOnly=true;a.style.cssText='position:fixed;opacity:0;top:0';document.body.append(a);a.select();a.setSelectionRange(0,x.length);const ok=document.execCommand('copy');a.remove();return ok};
  try{await navigator.clipboard.writeText(x)}catch{if(!legacy()){location.href='mailto:'+x;return}}
  b.classList.add('done');st.textContent='Email address copied';setTimeout(()=>{b.classList.remove('done');st.textContent=''},2000)}));
})()</script>
<style is:global>
.end{--bg:#141416;--ink:#F2F1EC;--muted:#A7A7AE;--edge:#6B6B72;--line:#2A2A30;--btn:#F2F1EC;--on-btn:#0C0C0E;--live:#4CC38A;--t-sells:#FF9A5C;
  --e-out:cubic-bezier(.23,1,.32,1);--e-max:1376px;--e-gut:32px;
  margin:160px calc(16px - var(--page-pad,0px)) 16px;border-radius:32px;background:var(--bg);color:var(--ink);color-scheme:dark;
  font:400 18px/1.5 'Bricolage Grotesque Variable',system-ui,sans-serif;font-optical-sizing:auto;-webkit-font-smoothing:antialiased}
.end *{box-sizing:border-box}
.end p,.end h2{margin:0}
.end .c{width:min(var(--e-max),100% - var(--e-gut) * 2);margin-inline:auto}
.end .vh{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.end .ul{color:inherit;text-decoration:none;background:linear-gradient(color-mix(in srgb,currentColor 32%,transparent),color-mix(in srgb,currentColor 32%,transparent)) no-repeat 0 100%/100% 1px,linear-gradient(currentColor,currentColor) no-repeat 100% 100%/0 1px;transition:background-size 200ms var(--e-out)}
.end .ul:hover,.end .ul:focus-visible{background-size:100% 1px,100% 1px;background-position:0 100%,0 100%}
.end .pill-btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 22px;border-radius:999px;font:inherit;font-size:15px;font-weight:650;line-height:1;text-decoration:none;color:var(--ink);background:transparent;border:1px solid var(--edge);transition:transform 120ms var(--e-out),background-color 200ms var(--e-out)}
.end .pill-btn.primary{background:var(--btn);color:var(--on-btn);border-color:var(--btn)}
.end .pill-btn:active{transform:scale(.97)}
@media (hover:hover) and (pointer:fine){
  .end .pill-btn:hover{background:color-mix(in oklab,var(--ink) 7%,transparent)}
  .end .pill-btn.primary:hover{background:color-mix(in oklab,var(--btn) 84%,var(--bg))}
}
.end .ct{padding:104px 0 0;display:block;max-width:none;margin:0}
.end .ct h2{font-size:clamp(56px,9vw,136px);font-weight:800;font-stretch:75%;line-height:.92;letter-spacing:-.025em;max-width:12ch;margin-bottom:40px;color:var(--ink)}
.end .sells{color:var(--t-sells)}
.end .cta{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:28px}
@media (min-width:1024px){
  .end .ct .c{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:32px;align-items:end}
  .end .ct h2{grid-column:1/8;margin:0}
  .end .ct-r{grid-column:8/13;padding-bottom:8px}
}
.end .cl{font-size:18px;line-height:1.5;margin-top:10px;max-width:60ch;color:var(--ink)}
.end .copy{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer;display:inline-flex;align-items:baseline;gap:8px;min-height:24px;text-decoration:none;position:relative;vertical-align:baseline}
.end .copy .tag{font-family:inherit;font-size:12px;font-weight:600;line-height:inherit;letter-spacing:normal;color:inherit;align-self:auto;border:1px solid var(--edge);border-radius:999px;padding:0 8px}
.end .copy .t-done,.end .copy.done .t-copy{display:none}
.end .copy.done .t-done{display:inline}
@media (pointer:coarse){.end .copy{padding-block:10px;margin-block:-10px}}
.end .here{line-height:1.5;display:flex;align-items:center;gap:10px;margin-top:22px;font-size:15px;color:var(--muted)}
.end .here i{flex:none;width:8px;height:8px;border-radius:50%;background:var(--live);box-shadow:0 0 0 4px color-mix(in srgb,var(--live) 22%,transparent)}
.end .foot{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px;margin-top:112px;padding:28px 0 32px;border-top:1px solid var(--line);font-size:15px}
.end .social{display:flex;flex-wrap:wrap;gap:8px 24px}
.end .social a{position:relative;padding:10px 8px;margin-inline:-8px;min-width:24px;text-align:center;background-origin:content-box;background-clip:content-box}
.end .copy.chip::after,.end .social a::after{content:"";position:absolute;inset:50% auto auto 50%;width:max(100%,44px);height:max(100%,44px);translate:-50% -50%}
.end .copyr{color:var(--muted)}
.end :focus-visible{outline:2px solid var(--ink);outline-offset:3px;border-radius:4px}
@media (max-width:759px){
  .end{--e-gut:16px;margin:112px calc(8px - var(--page-pad,0px)) 8px;border-radius:24px}
  .end .ct{padding-top:56px}
  .end .ct h2{font-size:52px;margin-bottom:28px}
  .end .cl{font-size:16px}
  .end .cta{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .end .cta .pill-btn{min-height:52px}
  .end .foot{flex-direction:column;align-items:flex-start;margin-top:56px;padding-bottom:calc(32px + env(safe-area-inset-bottom))}
}
</style>
