---
// Look 1, Poster: his name is the poster (Juhi Chitra), an opinion headline under it (Minh Pham),
// giant display words as section heads in one owned colour family (Lash, Doug Alves).
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/hanken-grotesk';
import display from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-standard-normal.woff2?url';
import '../../styles/looks-base.css';
import '../../styles/looks-poster.css';
import Boot from '../../components/Boot.astro';
import Arrow from '../../components/Arrow.astro';
import Loop from '../../components/Loop.astro';
import Words from '../../components/Words.astro';
import { intro, work, live, email, social, loops, results, more, lead, pages, how, jobs } from '../../data/home';

const [name, role] = intro.name.split(', ');
// The resume button shows once the site copy of the CV exists.
const ctas = intro.links.filter(l => l.href !== '#').reverse();
const facts = ['4.5 years in design, 2+ in core UI/UX', 'UI/UX and Graphic Designer at CashKaro, 2023 to 2026', 'Based in Gurugram'];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Look: Poster, Vishal Yadav</title>
<meta name="robots" content="noindex" />
<meta name="color-scheme" content="light dark" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preload" href={display} as="font" type="font/woff2" crossorigin />
<Boot />
</head>
<body>
<div class="pg">
  <header class="top">
    <p class="status"><span class="dot" aria-hidden="true"></span>{intro.availability}</p>
    <nav aria-label="Sections"><a href="#work">Work</a><a href="#about">About</a><a href="#contact">Contact</a></nav>
    <button id="theme" type="button">Dark mode</button>
  </header>

  <main>
  <section class="hero">
    <h1 class="name"><span class="n">{name}</span><span class="vh">, </span><span class="role">{role}</span></h1>
    <div class="lede">
      <Words text={intro.positioning} class="opinion" />
      <div class="hero-row">
        <div class="hero-l">
          <p class="sup enter" style="--d:260ms">{intro.supporting}</p>
          <div class="cta enter" style="--d:320ms">
            {ctas.map((l, i) => <a class={`btn${i ? '' : ' primary'}`} href={l.href}>{l.label}</a>)}
          </div>
        </div>
        <ul class="aud enter" style="--d:380ms" aria-label="Start here">
          <li><a class="go" href="#work"><strong>Hiring a product designer</strong> <span>See the case studies</span><Arrow /></a></li>
          <li><a class="go" href="#results"><strong>Recruiting</strong> <span>The 30 second version</span><Arrow /></a></li>
          <li><a class="go" href="#pages"><strong>Founder</strong> <span>Need a page that sells</span><Arrow /></a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="facts reveal" id="results" aria-labelledby="r-h">
    <h2 id="r-h">Shipped at CashKaro, for 25M+ users</h2>
    <ul class="fgrid">
      {results.map(r => <li class="f num"><span class="r-num" data-n={parseInt(r.n)}>{r.n}</span><span class="f-l">{r.label}</span></li>)}
      {facts.map(f => <li class="f txt">{f}</li>)}
    </ul>
  </section>

  <section class="work" id="work" aria-labelledby="w-h">
    <div class="shead reveal"><h2 id="w-h">Selected work</h2><span class="count">4 case studies</span></div>
    {work.map((w, i) => (
      <article class="project reveal">
        <div class="p-text">
          <p class="p-meta"><span class="p-name">{w.name}</span><span class="tag">{w.type.includes('B2B') ? 'B2B concept' : 'Concept'}</span><span>{w.year}</span></p>
          <h3><a class="p-link" href={live(w.slug)}>{w.headline}<span class="vh">, the {w.name} case study</span></a></h3>
          <p class="p-prob">{w.problem}</p>
          <p class="scope"><span>{w.role}</span><span>{w.detail}</span></p>
          <a class="more go" href={live(w.slug)} tabindex="-1" aria-hidden="true">View the case study <Arrow /></a>
        </div>
        {/* after the text so focus runs headline, then the loop's button; every loop is below the first screen, so all lazy */}
        <Loop href={live(w.slug)} loop={loops[i]} name={w.name} alt={w.alt} eager={false} />
      </article>
    ))}
    <div class="morework reveal">
      <h3 id="m-h">More work</h3>
      <ul aria-labelledby="m-h">
        {more.map(m => (
          <li><a class="mw go" href={m.href}><span class="mw-n">{m.name}</span><span class="mw-l">{m.line}</span><span class="tag">Concept</span><Arrow /></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="pages" id="pages" aria-labelledby="p-h">
    <div class="shead stack reveal"><h2 id="p-h">Pages that sell</h2><p class="count">Campaigns, landing pages and product pages for commerce brands.</p></div>
    <article class="lead reveal">
      <div class="thumb"><img src={`/pages/${lead.img}.webp`} alt={`${lead.name}, preview`} width="960" height="1004" loading="lazy" decoding="async" /></div>
      <div class="lead-t">
        <span class="tag solid">{lead.tag}</span>
        <h3>{lead.name}</h3>
        <p>{lead.line}</p>
        <dl class="stats">{lead.stats.map(([n, l]) => <div><dt>{l}</dt><dd>{n}</dd></div>)}</dl>
      </div>
    </article>
    <ul class="rail">
      {pages.map(p => (
        <li class="reveal"><a class="page go" href={p.href}>
          <div class="thumb"><img src={`/pages/${p.img}.webp`} alt={`${p.name}, preview`} width="960" height="1004" loading="lazy" decoding="async" /></div>
          <div class="pg-t">
            <span class="ptag">{p.tag && <span class={`tag${p.tag.startsWith('Shipped') ? ' solid' : ''}`}>{p.tag}</span>}</span>
            <h3>{p.name}</h3>
            <p>{p.line}</p>
            <span class="more">View on Behance <Arrow /></span>
          </div>
        </a></li>
      ))}
    </ul>
    <p class="freelance reveal">Need a page that sells? <a class="ul" href="#contact">See how I work with founders</a></p>
  </section>

  <section class="how" aria-labelledby="h-h">
    <h2 id="h-h" class="shead-m reveal">How I work</h2>
    <ul>
      {how.map(x => <li class="reveal"><h3>{x.h}</h3><div><p>{x.p}</p><a class="more go" href={x.href}>{x.link} <Arrow /></a></div></li>)}
    </ul>
  </section>

  <section class="about reveal" id="about" aria-labelledby="a-h">
    <h2 id="a-h" class="shead-m">About</h2>
    <p class="lead-p">From October 2023 to August 2026 I designed app and web flows at CashKaro, India’s largest cashback platform, and built, in Figma, the design system its campaigns run on. Before that I was a graphic designer at an agency, which is why what I ship looks finished (that work lives in <a class="ul" href="https://www.behance.net/design_vishaly">the archive</a>). I studied Computer Science, so I know what engineers need at handoff, and I use AI to move faster through research and iteration while the design calls stay mine.</p>
    <dl class="jobs">{jobs.map(([c, r, y]) => <div><dt>{c}</dt><dd>{r}</dd><dd class="y">{y}</dd></div>)}</dl>
  </section>

  <section class="contact reveal" id="contact" aria-labelledby="c-h">
    <h2 id="c-h">Hiring, or need a page that sells?</h2>
    <div class="c-body">
      <p>Email me at <button class="copy" type="button" data-copy={email}>{email} <span class="tag" aria-hidden="true"><span class="t-copy">Copy</span><span class="t-done">Copied</span></span></button> or book a call. I reply within a day.</p>
      <span class="vh" role="status" id="copied"></span>
      <div class="cta">
        <a class="btn primary" href="https://cal.com/designwvishal">Book a call</a>
        <a class="btn" href={`mailto:${email}`}>Email</a>
      </div>
      <p class="elsewhere">You can also find me on <a class="ul" href={social[0][1]}>LinkedIn</a> and <a class="ul" href={social[1][1]}>Behance</a>.</p>
    </div>
  </section>
  </main>

  <footer class="foot">
    <nav aria-label="Elsewhere" class="social">{social.map(([l, h]) => <a class="ul" href={h}>{l}</a>)}</nav>
    <button id="calm" type="button" aria-pressed="false">Reduce motion</button>
  </footer>
</div>
<script>import '../../scripts/ui';</script>
</body>
</html>
