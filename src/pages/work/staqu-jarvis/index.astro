---
// JARVIS Alerts case study. Moved from public/ so it can use the shared site header; the page itself is unchanged.
import SiteHeader from '../../../components/SiteHeader.astro';
import Boot from '../../../components/Boot.astro';
const title = 'JARVIS Alerts case study, Vishal Yadav, Product Designer';
const description = "A false alert flow for Staqu's AI CCTV platform that makes every correction visible, so the people woken up at 3 AM can see the system learning.";
const ld = [
  { '@context': 'https://schema.org', '@type': 'CreativeWork', name: 'JARVIS Alerts', headline: 'Alerts worth waking up for', description,
    author: { '@type': 'Person', name: 'Vishal Yadav' }, dateCreated: '2026-03', genre: 'B2B product design case study', image: '/work/staqu-jarvis/img/00-hero-poster.jpg' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: '/' },
    { '@type': 'ListItem', position: 2, name: 'JARVIS Alerts' } ] },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{title}</title>
<Boot />
<meta name="description" content={description}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:type" content="article">
<meta property="og:image" content="/work/staqu-jarvis/img/00-hero-poster.jpg"><meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600;700;800&display=swap">
<style is:inline>
/* Layout: text column of ~66ch beside a sticky contents rail on desktop; one column on phones.
   Single dark theme by choice: the calmer navy agreed for JARVIS. */
:root{
  --bg:#0C1631; --card:#17223F; --fg:#E6EAF2; --muted:#9AA8C4; --line:#26355C;
  --warm:#F2B35E; --cool:#86B4F0;
  --sans:"Geist",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
  --mono:"Geist Mono",ui-monospace,"SF Mono",Menlo,monospace;
  color-scheme:dark;
  /* tokens the shared site header reads */
  --ink:var(--fg); --edge:#5A6B92; --btn:var(--fg); --on-btn:var(--bg);
  --bar:56px; --gut:32px; --max:1376px; --out:cubic-bezier(.23,1,.32,1);
}
@media (max-width:759px){:root{--bar:52px;--gut:16px}}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
html.calm{scroll-behavior:auto}
body{background:var(--bg);color:var(--fg);font:400 17px/1.65 var(--sans);-webkit-font-smoothing:antialiased;padding-inline:20px}
a{color:inherit}
:focus-visible{outline:2px solid var(--cool);outline-offset:3px;border-radius:4px}
h1,h2,h3,h4{text-wrap:balance;margin:0;font-weight:600;letter-spacing:-.015em}
p{margin:0}
.mono,.eyebrow,.k{font-family:var(--mono)}
.eyebrow{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.k{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}

.progress{position:fixed;top:0;left:0;right:0;height:2px;z-index:10;padding-top:env(safe-area-inset-top,0px)}
.progress i{display:block;height:100%;width:0;background:var(--warm)}

.wrap{max-width:1120px;margin:0 auto;padding-block:56px 96px}
.top{display:flex;justify-content:space-between;gap:16px;font-size:14px;color:var(--muted);padding-bottom:56px}
.top a{text-decoration:none}.top a:hover{color:var(--fg)}

header.hero{max-width:66ch;display:grid;gap:20px}
h1{font-size:clamp(40px,7vw,68px);line-height:1.02;letter-spacing:-.03em}
.hook{font-size:clamp(22px,3vw,30px);font-weight:500;letter-spacing:-.015em;color:var(--warm);margin-top:-8px}
.dek{font-size:clamp(19px,2.2vw,22px);line-height:1.5;color:var(--fg)}
.alertline{font-family:var(--mono);font-size:13px;color:var(--warm);display:flex;gap:10px;align-items:center}
.alertline::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--warm)}

.facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;margin-top:40px;padding-block:24px;border-block:1px solid var(--line)}
.facts div{display:grid;gap:6px;min-width:0}
.facts p{font-size:15px;line-height:1.45}
.note{margin-top:16px;font-size:14px;color:var(--muted);max-width:72ch}

.summary{margin-top:48px;background:var(--card);border-radius:14px;padding:28px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px}
.summary h2{grid-column:1/-1;font-size:14px;font-family:var(--mono);font-weight:500;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.summary div{display:grid;gap:8px;align-content:start;min-width:0}
.summary p{font-size:15.5px;line-height:1.5}

.layout{display:grid;grid-template-columns:200px minmax(0,1fr);gap:64px;margin-top:80px}
nav.toc{position:sticky;top:calc(env(safe-area-inset-top,0px) + 32px);align-self:start;display:grid;gap:4px;font-size:14px}
nav.toc .k{margin-bottom:10px}
nav.toc a{text-decoration:none;color:var(--muted);padding:5px 0 5px 14px;border-left:1px solid var(--line)}
nav.toc a:hover{color:var(--fg)}
nav.toc a.on{color:var(--fg);border-left-color:var(--warm)}

article{display:grid;gap:104px;min-width:0}
section{display:grid;gap:22px;max-width:66ch;scroll-margin-top:32px}
section.wide{max-width:none}
section h2{font-size:clamp(28px,3.6vw,38px);line-height:1.12}
section p{color:#C9D1E2}
section p strong{color:var(--fg);font-weight:600}

blockquote{margin:8px 0 0;padding:4px 0 4px 20px;border-left:2px solid var(--warm);font-size:22px;line-height:1.4;color:var(--fg);font-weight:500;letter-spacing:-.01em}

.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;padding-top:8px}
.stats div{display:grid;gap:6px;align-content:start}
.stats b{font-size:32px;font-weight:600;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.stats span{font-size:15px;color:var(--muted);line-height:1.45}
.source{font-size:13px;color:var(--muted)}

.list{display:grid;gap:28px;counter-reset:n}
.list > div{display:grid;grid-template-columns:44px minmax(0,1fr);gap:4px 12px}
.list .n{font-family:var(--mono);font-size:13px;color:var(--muted);padding-top:4px}
.list h3{font-size:20px}
.list p{grid-column:2}

.goals{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.goals div{background:var(--card);border-radius:12px;padding:20px;display:grid;gap:8px}
.goals p{color:var(--fg)}

.options{display:grid;gap:12px}
.opt{border:1px solid var(--line);border-radius:12px;padding:20px 22px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px 20px}
.opt h3{font-size:18px}
.opt p{grid-column:1/-1;font-size:16px}
.tag{font-family:var(--mono);font-size:11px;letter-spacing:.08em;padding:3px 8px;border-radius:4px;align-self:start;color:var(--muted);border:1px solid var(--line)}
.opt.built{border-color:var(--warm)}
.opt.built .tag{color:var(--bg);background:var(--warm);border-color:var(--warm)}

figure{margin:0;display:grid;gap:10px}
.slot{background:var(--card);border:1px dashed var(--line);border-radius:12px;display:grid;place-items:center;text-align:center;padding:20px;color:var(--muted);font-family:var(--mono);font-size:12px;letter-spacing:.04em;max-width:100%}
.slot.flow{aspect-ratio:3/2}
.shot{display:block;max-width:100%;height:auto;border-radius:16px}
.shot.wide{width:100%}
.shot.phone{width:100%;max-width:300px;border-radius:32px;border:1px solid var(--line)}
.slot.phone{aspect-ratio:412/917;border-radius:28px;width:100%;max-width:300px}
figcaption{font-size:14px;color:var(--muted)}

.screen{display:grid;grid-template-columns:minmax(0,300px) minmax(0,1fr);gap:40px;align-items:start;max-width:880px}
.screen > div{display:grid;gap:14px;min-width:0}
.screen h3{font-size:24px;line-height:1.2}
.screens{display:grid;gap:72px}

.fixes{display:grid;gap:0;border-top:1px solid var(--line)}
.fix{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);gap:24px;padding-block:22px;border-bottom:1px solid var(--line)}
.fix h3{font-size:18px;line-height:1.35}
.fix p{font-size:16px}

.trades{display:grid;gap:0;border-top:1px solid var(--line)}
.trade{display:grid;grid-template-columns:28px minmax(0,1fr) minmax(0,1fr);gap:8px 20px;padding-block:20px;border-bottom:1px solid var(--line)}
.trade .n{font-family:var(--mono);font-size:13px;color:var(--muted);padding-top:3px}
.trade h3{font-size:17px;margin-bottom:6px}
.trade p{font-size:15.5px}
.trade .cost{color:var(--warm);font-size:15.5px}
.trade .cost .k{display:block;margin-bottom:4px}

.beforeafter{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.beforeafter div{border-radius:12px;padding:22px;display:grid;gap:10px;align-content:start}
.beforeafter .b{border:1px solid var(--line)}
.beforeafter .a{background:var(--card);box-shadow:inset 0 0 0 1px var(--cool)}
.beforeafter .a .k{color:var(--cool)}
.metric{display:grid;gap:6px;padding:22px 0 4px;border-top:1px solid var(--line)}
.metric b{font-size:clamp(24px,3vw,30px);font-weight:600;letter-spacing:-.02em;color:var(--warm)}
.measures{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.measures div{display:grid;gap:8px}

.closing{margin-top:120px;padding-top:48px;border-top:1px solid var(--line);display:grid;gap:18px}
.closing h2{font-size:clamp(32px,5vw,48px);letter-spacing:-.025em}
.closing > p{color:var(--muted);font-size:19px}
.btns{display:flex;flex-wrap:wrap;gap:14px;margin-top:8px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:54px;padding:0 24px;border-radius:100px;font-weight:600;font-size:18px;line-height:1.3;text-decoration:none;transition:transform .2s ease,opacity .2s ease}
.btn .ic{flex:none;width:16px;height:16px}
.btn.primary{background:#A9BBE6;color:var(--bg)}
.btn.ghost{border:1px solid #ffffff47;color:var(--fg)}
.btn:hover{transform:translateY(-1px);opacity:.92}
@media (max-width:620px){.btns{flex-direction:column}.btn{width:100%}}

.next{margin-top:64px;display:grid;gap:14px}
.nextgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.nextgrid a{background:var(--card);border-radius:12px;padding:20px;display:grid;gap:8px;text-decoration:none;align-content:start}
.nextgrid a:hover{box-shadow:inset 0 0 0 1px var(--line)}
.nextgrid b{font-size:18px;font-weight:600;letter-spacing:-.01em}
.nextgrid span{font-size:14px;color:var(--muted)}

@media (max-width:900px){
  .layout{grid-template-columns:minmax(0,1fr);gap:0}
  nav.toc{display:none}
  .summary{grid-template-columns:1fr 1fr}
  .screen{grid-template-columns:minmax(0,1fr);gap:20px}
  .slot.phone{max-width:240px}
}
@media (max-width:620px){
  body{font-size:16px}
  .wrap{padding-block:32px 64px}
  .top{padding-bottom:40px}
  .facts,.summary,.goals,.beforeafter,.measures,.nextgrid{grid-template-columns:minmax(0,1fr)}
  .facts{gap:18px}
  .stats{grid-template-columns:minmax(0,1fr)}
  .fix{grid-template-columns:minmax(0,1fr);gap:8px}
  .trade{grid-template-columns:28px minmax(0,1fr)}
  .trade .cost{grid-column:2}
  article{gap:80px}
  .summary{padding:22px}
}
</style>
<style is:inline>.proto{display:block;width:100%;aspect-ratio:16/10;border:0;border-radius:24px;background:var(--card)}@media (max-width:640px){.proto{aspect-ratio:9/16}}video.shot{background:var(--card)}
.reel{position:relative}
.pills{position:absolute;right:16px;bottom:16px;display:flex;gap:8px}
.pill{display:inline-flex;align-items:center;gap:6px;height:36px;padding:0 14px;border-radius:100px;border:1px solid rgba(255,255,255,.22);background:rgba(13,31,94,.78);color:#fff;font:600 12px/1 var(--sans);letter-spacing:.08em;cursor:pointer;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
.pill:hover{background:rgba(22,41,122,.9)}
.pill:focus-visible{outline:2px solid #AFC6FF;outline-offset:2px}
@media (max-width:620px){.pills{right:10px;bottom:10px}.pill{height:32px;padding:0 11px;font-size:11px}}
.up{opacity:0;transform:translateY(20px);transition:opacity .4s ease,transform .4s ease;transition-delay:var(--d,0ms)}
.up.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.up{opacity:1;transform:none;transition:none}}
html.calm .up{opacity:1;transform:none;transition:none}
</style>
<style is:inline>
/* Matched to the live Framer JARVIS page (measured 2026-10-09): Albert Sans, full width bands that swap
   navy and light, one 760px reading column, the screens as text left and a 360px phone right. */
:root{--sans:"Albert Sans",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;--mono:var(--sans);
  --bg:#0C1631;--card:#17223F;--fg:#E6EAF2;--body:#E6EAF2;--muted:#8C99B6;--acc:#A9BBE6;--warm:#E8A23B;--line:#26355C;--band:#0C1631}
.lt{--fg:#0E1424;--body:#3B4458;--muted:#5A6478;--acc:#2348C4;--card:#E2E6EE;--line:#D3D8E3;--band:#EEF0F5;--warm:#A35A00}
html{overflow-x:clip}
.eyebrow,.k{font-family:var(--sans);font-size:13px;font-weight:600;letter-spacing:.14em;color:var(--acc)}
.wrap{max-width:1080px}
.layout{display:block;margin-top:96px}
nav.toc{display:none}
article{gap:0}
article>section{padding-block:120px;max-width:760px;margin-inline:auto;color:var(--fg);border-image:conic-gradient(var(--band) 0 0) fill 0//0 100vmax}
article>section.wide{max-width:1080px}
section h2{font-size:clamp(32px,4vw,48px);font-weight:700;line-height:1.08;letter-spacing:-.02em;color:var(--fg)}
section h3{color:var(--fg)}
section p{color:var(--body);font-size:18px;line-height:1.6}
.stats b{color:var(--acc)}
#screens .screens{gap:120px;margin-top:56px}
#screens .screen{grid-template-columns:minmax(0,640px) 360px;justify-content:space-between;gap:48px;max-width:none;align-items:start}
#screens .screen>figure{order:2;margin:0}
#screens .screen h3{font-size:32px;line-height:1.2;letter-spacing:-.01em}
#screens .shot.phone{width:360px;max-width:100%;border:0;border-radius:40px;box-shadow:0 16px 40px rgba(13,31,94,.12)}
.lt :focus-visible{outline-color:#2348C4}
@media (max-width:900px){article>section{padding-block:80px}#screens .screen{grid-template-columns:minmax(0,1fr);gap:24px}#screens .screen>figure{order:0}}
article>section{width:100%}
/* site top bar, same as the home page; no theme toggle because this case study keeps its own fixed look */
.wrap{padding-top:40px}
.bar{margin-inline:calc(50% - 50vw)}
/* Vishal 2026-10-13: header keeps the frosted blur, same as the home page (the solid navy try is undone) */
/* Vishal 2026-10-13: header looks exactly like the home page header (its dark look, since this page is dark), with no navy tint.
   Same frosted blur; a touch more opaque than home so the navy page behind doesn't tint it blue. */
header.bar{--bg:#0C0C0E;--ink:#F2F1EC;--muted:#A7A7AE;--edge:#6B6B72;--line:#232328;--btn:#F2F1EC;--on-btn:#0C0C0E}
@supports ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){header.bar{background:color-mix(in srgb,#0C0C0E 90%,transparent)}}
body{margin-top:0}
.progress{z-index:30}
.summary{max-width:1080px;margin-inline:auto}
.summary h2{font-size:13px;font-family:var(--sans);font-weight:600;letter-spacing:.14em;color:var(--acc)}
.summary p{font-size:16px}
.pill[aria-pressed=true][data-act=cc]{background:#fff;color:#0C1631}
video::cue{font:500 18px/1.4 var(--sans);background:rgba(12,22,49,.82);color:#fff}
.beforeafter .a{box-shadow:inset 0 0 0 1px #2348C4}
.beforeafter .a .k{color:#2348C4}
.swipe{display:none}
@media (max-width:620px){
  #flow figure{display:none}
  .swipe{display:flex;gap:16px;list-style:none;margin:32px -28px 0;padding:0 28px 8px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-inline:28px;overscroll-behavior-x:contain}
  .swipe li{flex:0 0 260px;scroll-snap-align:start;display:grid;gap:8px;align-content:start}
  .swipe p{font-size:17px;font-weight:600;line-height:1.3;color:var(--fg);min-height:2.6em}
  .swipe img{width:100%;height:auto;border-radius:28px;margin-top:8px;box-shadow:0 12px 32px rgba(13,31,94,.12)}
}
@media (max-width:620px){article>section{padding-block:64px}.layout{margin-top:64px}#screens .screens{gap:72px}#screens .screen h3{font-size:26px}}

/* ---- audit Phase 2 and 3 ---- */
/* one break between two bands of the same colour, not two */
article>section.lt+section.lt,article>section:not(.lt)+section:not(.lt){padding-top:0}
/* desktop (Vishal 2026-10-13): the four navy sections after the 30 second version (hardest call, who, found, options) were one flat navy;
   each now sits on its own step of JARVIS indigo blue, getting lighter as the story builds, so section breaks read */
/* phones too since 2026-10-13 15:04 (Vishal: on phones the content blended into the page navy) */
article>section#hardest{--band:#0F1A3A;--card:#1A2850}
article>section#who{--band:#132045;--card:#1E2E5A}
article>section#found{--band:#17274F;--card:#223566}
article>section#options{--band:#1C2E5C;--card:#273D72}
article>section:is(#who,#found,#options){padding-top:120px}
@media (max-width:900px){article>section:is(#who,#found,#options){padding-top:80px}}
@media (max-width:620px){article>section:is(#who,#found,#options){padding-top:64px}}
/* type scale: 13 label, 16 small, 18 body, 22 lead, 32 titles, 48 sections, 68 page title */
.facts p,.stats span,.note,.source,figcaption,.opt p,.fix p,.trade p,.trade .cost,.nextgrid span{font-size:16px}
.list .n,.trade .n,.tag{font-size:13px}
.opt h3,.fix h3,.trade h3,.list h3,.nextgrid b{font-size:18px}
blockquote,.dek,.closing>p,.metric b,.next h2{font-size:22px}
.closing h2,.stats b{font-size:32px}
@media (min-width:621px){.closing h2{font-size:48px}}
/* what I'd change: each pair on its own card, Problem in amber */
.fixes{border-top:0;gap:12px}
.fix{background:var(--card);border:0;border-radius:16px;padding:24px 28px}
.fix>div{display:grid;gap:6px;align-content:start}
.k.pr{color:var(--warm)}
/* the closing line reads as the point, not a footnote */
.closing>p{font-weight:600;color:var(--acc)}
/* more work: a picture and a clear hover */
.nextgrid a{padding:0;overflow:hidden;gap:0;transition:transform .2s ease,box-shadow .2s ease}
.nextgrid img{display:block;width:100%;height:auto;aspect-ratio:800/837;object-fit:cover}
.nextgrid b{padding:16px 20px 20px;line-height:1.35}
.nextgrid a:hover,.nextgrid a:focus-visible{transform:translateY(-2px);box-shadow:0 0 0 1px var(--acc)}
.nextgrid a:hover b{text-decoration:underline;text-underline-offset:.2em}
/* prototype: a still and a way out while Figma loads */
.protowrap{position:relative;margin:0}
/* Desktop: the prototype fits one screen between the sticky header and the bottom dock (Vishal 2026-10-13 "going into two scrolls") */
@media (min-width:641px){.protowrap{width:min(100%,calc((100svh - 120px) * 16 / 10));margin-inline:auto}}
.protowait{position:absolute;inset:0;border-radius:24px;background:var(--card);display:grid;place-content:center;justify-items:center;gap:12px;text-align:center;transition:opacity .3s ease}
.protowait img{width:120px;height:auto;border-radius:16px;opacity:.9}
.protowait p{font-size:16px;color:var(--muted)}
.protowait a{font-size:16px;font-weight:600;color:var(--fg);padding:10px 4px}
.protowrap.ready .protowait{opacity:0;pointer-events:none}
@media (prefers-reduced-motion:reduce){.nextgrid a,.protowait{transition:none}}
html.calm .nextgrid a,html.calm .protowait{transition:none}
@media (max-width:620px){
  .opt{grid-template-columns:minmax(0,1fr)}
  .opt .tag{order:-1;justify-self:start}
  .fix{padding:20px}
}
</style>
</head>


<div class="progress" aria-hidden="true"><i id="bar"></i></div>

<SiteHeader home="/looks/kinetic/" theme={false} book />

<div class="wrap">

  <header class="hero">
    <p class="eyebrow">Case study · B2B product design</p>
    <h1>JARVIS Alerts</h1>
    <p class="hook">Alerts worth waking up for</p>
    <p class="dek">A false alert flow for Staqu’s AI CCTV platform that makes every correction visible, so the people who get woken up at 3 AM can finally see the system learning.</p>
  </header>

  <div class="facts">
    <div><span class="k">Role</span><p>Solo. Problem framing, flow, UI and copy</p></div>
    <div><span class="k">Type</span><p>Independent B2B concept</p></div>
    <div><span class="k">Timeline</span><p>1 day, March 2026</p></div>
