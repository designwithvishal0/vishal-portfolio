/* Phones: the prototype keeps its full app screen size, and the page keeps scrolling over it. A cover passes scrolls through to the page;
   tapping it hands touches to the prototype, and "Done" (or scrolling it out of view) gives them back. */
.protogo,.protodone{display:none}
