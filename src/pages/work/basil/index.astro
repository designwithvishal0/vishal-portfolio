---
// Basil case study (independent concept), ported word for word from Vishal's Behance boards onto the JARVIS template,
// copied from the finished OneBanc page. Colours come from the Basil boards.
import SiteHeader from '../../../components/SiteHeader.astro';
import Boot from '../../../components/Boot.astro';
const title = 'Basil product page set builder, Vishal Yadav, Product Designer';
const description = 'A set builder for Basil’s lunchbox product pages. It turns one lunchbox into a matching school kit in the same character print, and turns the existing Buy 2 and Buy 3 offer into a progress bar a parent can watch fill up.';
const canonical = new URL('/work/basil/', Astro.site).href;
const ld = [
  { '@context': 'https://schema.org', '@type': 'CreativeWork', name: 'Basil product page set builder', headline: 'Sell the set, not the second product.', description,
    author: { '@type': 'Person', name: 'Vishal Yadav' }, dateCreated: '2026', genre: 'Product design case study', image: '/work/basil/img/og.jpg' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: '/' },
    { '@type': 'ListItem', position: 2, name: 'Basil' } ] },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<Boot />
<meta name="description" content={description}>
<link rel="canonical" href={canonical}><meta property="og:url" content={canonical}>
<link rel="stylesheet" href="/css/iphone.css">
<link rel="stylesheet" href="/css/closing-cta.css">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:type" content="article">
<meta property="og:image" content="/work/basil/img/og.jpg"><meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap">
<style is:inline>
/* Layout: text column of ~66ch beside a sticky contents rail on desktop; one column on phones.
   Single dark theme by choice: the calmer navy agreed for JARVIS. */
:root{
  --bg:#1A332E; --card:#23413B; --fg:#F9F9EC; --muted:#A9B8B2; --line:#2F4B45;
  --warm:#C8E616; --cool:#C8E616;
  --sans:"Geist",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
  --mono:"Geist Mono",ui-monospace,"SF Mono",Menlo,monospace;
  color-scheme:dark;
  /* tokens the shared site header reads */
  --ink:var(--fg); --edge:#5F7A73; --btn:var(--fg); --on-btn:var(--bg);
  --bar:56px; --gut:32px; --max:1376px; --out:cubic-bezier(.23,1,.32,1);
}
@media (max-width:759px){:root{--bar:52px;--gut:16px}}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
html.calm{scroll-behavior:auto}
body{background:var(--bg);color:var(--fg);font:400 17px/1.65 var(--sans);-webkit-font-smoothing:antialiased;padding-inline:20px}
a{color:inherit}
:focus-visible{outline:2px solid var(--cool);outline-offset:3px;border-radius:4px}
h1,h2,h3,h4{text-wrap:balance;margin:0;font-weight:600;letter-spacing:-.015em}
p{margin:0}
.mono,.eyebrow,.k{font-family:var(--mono)}
.eyebrow{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);display:inline-block;margin-right:6px}
.k{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);display:inline-block;margin-right:6px}

.progress{position:fixed;top:0;left:0;right:0;height:2px;z-index:10;padding-top:env(safe-area-inset-top,0px)}
.progress i{display:block;height:100%;width:0;background:var(--warm)}

.wrap{max-width:1120px;margin:0 auto;padding-block:56px 96px}
.top{display:flex;justify-content:space-between;gap:16px;font-size:14px;color:var(--muted);padding-bottom:56px}
.top a{text-decoration:none}.top a:hover{color:var(--fg)}

header.hero{max-width:66ch;display:grid;gap:20px}
h1{font-size:clamp(40px,7vw,68px);line-height:1.02;letter-spacing:-.03em}
.hook{font-size:clamp(22px,3vw,30px);font-weight:500;letter-spacing:-.015em;color:var(--warm);margin-top:-8px}
.dek{font-size:clamp(19px,2.2vw,22px);line-height:1.5;color:var(--fg)}
.alertline{font-family:var(--mono);font-size:13px;color:var(--warm);display:flex;gap:10px;align-items:center}
.alertline::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--warm)}

.facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;margin-top:40px;padding-block:24px;border-block:1px solid var(--line)}
.facts div{display:grid;gap:6px;min-width:0}
.facts p{font-size:15px;line-height:1.45}
.note{margin-top:16px;font-size:14px;color:var(--muted);max-width:72ch}

.summary{margin-top:48px;background:var(--card);border-radius:14px;padding:28px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px}
.summary h2{grid-column:1/-1;font-size:14px;font-family:var(--mono);font-weight:500;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);display:inline-block;margin-right:6px}
.summary div{display:grid;gap:8px;align-content:start;min-width:0}
.summary p{font-size:15.5px;line-height:1.5}

.layout{display:grid;grid-template-columns:200px minmax(0,1fr);gap:64px;margin-top:80px}
nav.toc{position:sticky;top:calc(env(safe-area-inset-top,0px) + 32px);align-self:start;display:grid;gap:4px;font-size:14px}
nav.toc .k{margin-bottom:10px}
nav.toc a{text-decoration:none;color:var(--muted);padding:5px 0 5px 14px;border-left:1px solid var(--line)}
nav.toc a:hover{color:var(--fg)}
nav.toc a.on{color:var(--fg);border-left-color:var(--warm)}

article{display:grid;gap:104px;min-width:0}
section{display:grid;gap:22px;max-width:66ch;scroll-margin-top:32px}
section.wide{max-width:none}
section h2{font-size:clamp(28px,3.6vw,38px);line-height:1.12}
section p{color:#DCE3DA}
section p strong{color:var(--fg);font-weight:600}

blockquote{margin:8px 0 0;padding:4px 0 4px 20px;border-left:2px solid var(--warm);font-size:22px;line-height:1.4;color:var(--fg);font-weight:500;letter-spacing:-.01em}

.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;padding-top:8px}
.stats div{display:grid;gap:6px;align-content:start}
.stats b{font-size:32px;font-weight:600;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.stats span{font-size:15px;color:var(--muted);line-height:1.45}
.source{font-size:13px;color:var(--muted)}

.list{display:grid;gap:28px;counter-reset:n}
.list > div{display:grid;grid-template-columns:44px minmax(0,1fr);gap:4px 12px}
.list .n{font-family:var(--mono);font-size:13px;color:var(--muted);padding-top:4px}
.list h3{font-size:20px}
.list p{grid-column:2}

.goals{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.goals div{background:var(--card);border-radius:12px;padding:20px;display:grid;gap:8px}
.goals p{color:var(--fg)}

.options{display:grid;gap:12px}
.opt{border:1px solid var(--line);border-radius:12px;padding:20px 22px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px 20px}
.opt h3{font-size:18px}
.opt p{grid-column:1/-1;font-size:16px}
.tag{font-family:var(--mono);font-size:11px;letter-spacing:.08em;padding:3px 8px;border-radius:4px;align-self:start;color:var(--muted);border:1px solid var(--line)}
.opt.built{border-color:var(--warm)}
.opt.built .tag{color:var(--bg);background:var(--warm);border-color:var(--warm)}

figure{margin:0;display:grid;gap:10px}
.slot{background:var(--card);border:1px dashed var(--line);border-radius:12px;display:grid;place-items:center;text-align:center;padding:20px;color:var(--muted);font-family:var(--mono);font-size:12px;letter-spacing:.04em;max-width:100%}
.slot.flow{aspect-ratio:3/2}
.shot{display:block;max-width:100%;height:auto;border-radius:16px}
.shot.wide{width:100%}
.shot.phone{width:100%;max-width:300px;border-radius:32px;border:1px solid var(--line)}
.slot.phone{aspect-ratio:412/917;border-radius:28px;width:100%;max-width:300px}
figcaption{font-size:14px;color:var(--muted)}

.screen{display:grid;grid-template-columns:minmax(0,300px) minmax(0,1fr);gap:40px;align-items:start;max-width:880px}
.screen > div{display:grid;gap:14px;min-width:0}
.screen h3{font-size:24px;line-height:1.2}
.screens{display:grid;gap:72px}

.fixes{display:grid;gap:0;border-top:1px solid var(--line)}
.fix{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);gap:24px;padding-block:22px;border-bottom:1px solid var(--line)}
.fix h3{font-size:18px;line-height:1.35}
.fix p{font-size:16px}

.trades{display:grid;gap:0;border-top:1px solid var(--line)}
.trade{display:grid;grid-template-columns:28px minmax(0,1fr) minmax(0,1fr);gap:8px 20px;padding-block:20px;border-bottom:1px solid var(--line)}
.trade .n{font-family:var(--mono);font-size:13px;color:var(--muted);padding-top:3px}
.trade h3{font-size:17px;margin-bottom:6px}
.trade p{font-size:15.5px}
.trade .cost{color:var(--warm);font-size:15.5px}
.trade .cost .k{display:block;margin-bottom:4px}

.beforeafter{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.beforeafter div{border-radius:12px;padding:22px;display:grid;gap:10px;align-content:start}
.beforeafter .b{border:1px solid var(--line)}
.beforeafter .a{background:var(--card);box-shadow:inset 0 0 0 1px var(--cool)}
.beforeafter .a .k{color:var(--cool)}
.metric{display:grid;gap:6px;padding:22px 0 4px;border-top:1px solid var(--line)}
.metric b{font-size:clamp(24px,3vw,30px);font-weight:600;letter-spacing:-.02em;color:var(--warm)}
.measures{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.measures div{display:grid;gap:8px}

.closing{margin-top:120px;padding-top:48px;border-top:1px solid var(--line);display:grid;gap:18px}
.closing h2{font-size:clamp(32px,5vw,48px);letter-spacing:-.025em}
.closing > p{color:var(--muted);font-size:19px}
.btns{display:flex;flex-wrap:wrap;gap:14px;margin-top:8px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:54px;padding:0 24px;border-radius:100px;font-weight:600;font-size:18px;line-height:1.3;text-decoration:none;transition:transform .2s ease,opacity .2s ease}
.btn .ic{flex:none;width:16px;height:16px}
.btn.primary{background:#C8E616;color:var(--bg)}
.btn.ghost{border:1px solid #ffffff47;color:var(--fg)}
.btn:hover{transform:translateY(-1px);opacity:.92}
@media (max-width:620px){.btns{flex-direction:column}.btn{width:100%}}

.next{margin-top:64px;display:grid;gap:14px}
.nextgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.nextgrid a{background:var(--card);border-radius:12px;padding:20px;display:grid;gap:8px;text-decoration:none;align-content:start}
.nextgrid a:hover{box-shadow:inset 0 0 0 1px var(--line)}
.nextgrid b{font-size:18px;font-weight:600;letter-spacing:-.01em}
.nextgrid span{font-size:14px;color:var(--muted)}

@media (max-width:900px){
  .layout{grid-template-columns:minmax(0,1fr);gap:0}
  nav.toc{display:none}
  .summary{grid-template-columns:1fr 1fr}
  .screen{grid-template-columns:minmax(0,1fr);gap:20px}
  .slot.phone{max-width:240px}
}
@media (max-width:620px){
  body{font-size:16px}
  .wrap{padding-block:32px 64px}
  .top{padding-bottom:40px}
  .facts,.summary,.goals,.beforeafter,.measures,.nextgrid{grid-template-columns:minmax(0,1fr)}
  .facts{gap:18px}
  .stats{grid-template-columns:minmax(0,1fr)}
  .fix{grid-template-columns:minmax(0,1fr);gap:8px}
  .trade{grid-template-columns:28px minmax(0,1fr)}
  .trade .cost{grid-column:2}
  article{gap:80px}
  .summary{padding:22px}
}
</style>
<style is:inline>.proto{display:block;width:100%;aspect-ratio:16/10;border:0;border-radius:24px;background:var(--card)}@media (max-width:640px){.proto{aspect-ratio:9/16}}video.shot{background:var(--card)}
.reel{position:relative}
.pills{position:absolute;right:16px;bottom:16px;display:flex;gap:8px}
.pill{display:inline-flex;align-items:center;gap:6px;height:36px;padding:0 14px;border-radius:100px;border:1px solid rgba(255,255,255,.22);background:rgba(26,51,46,.78);color:#fff;font:600 12px/1 var(--sans);letter-spacing:.08em;cursor:pointer;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
.pill:hover{background:rgba(42,74,67,.9)}
.pill:focus-visible{outline:2px solid #C8E616;outline-offset:2px}
@media (max-width:620px){.pills{right:10px;bottom:10px}.pill{height:32px;padding:0 11px;font-size:11px}}
.up{opacity:0;transform:translateY(20px);transition:opacity .4s ease,transform .4s ease;transition-delay:var(--d,0ms)}
.up.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.up{opacity:1;transform:none;transition:none}}
html.calm .up{opacity:1;transform:none;transition:none}
</style>
<style is:inline>
/* Matched to the live Framer JARVIS page (measured 2026-10-09): Albert Sans, full width bands that swap
   navy and light, one 760px reading column, the screens as text left and a 360px phone right. */
/* Vishal 2026-10-14 02:28: the page uses the font of the design itself, as JARVIS does; loaded up to 700 so headings stay light rather than heavy */
:root{--sans:"Poppins",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;--mono:var(--sans);
  --bg:#1A332E;--card:#23413B;--fg:#F9F9EC;--body:#F9F9EC;--muted:#A9B8B2;--acc:#C8E616;--warm:#C8E616;--line:#2F4B45;--band:#1A332E}
.lt{--fg:#1A332E;--body:#46524E;--muted:#5F6B67;--acc:#A6480C;--card:#F3F4E3;--line:#E3E5D3;--band:#F9F9EC;--warm:#A6480C}
html{overflow-x:clip}
.eyebrow,.k{font-family:var(--sans);font-size:13px;font-weight:600;letter-spacing:.14em;color:var(--acc)}
.wrap{max-width:1080px}
.layout{display:block;margin-top:96px}
nav.toc{display:none}
article{gap:0}
article>section{padding-block:120px;max-width:760px;margin-inline:auto;color:var(--fg);border-image:conic-gradient(var(--band) 0 0) fill 0//0 100vmax}
article>section.wide{max-width:1080px}
section h2{font-size:clamp(32px,4vw,48px);font-weight:600;line-height:1.08;letter-spacing:-.02em;color:var(--fg)}
section h3{color:var(--fg)}
section p{color:var(--body);font-size:18px;line-height:1.6}
.stats b{color:var(--acc)}
.scr .screens{gap:120px;margin-top:56px}
.scr .screen{grid-template-columns:minmax(0,640px) 360px;justify-content:space-between;gap:48px;max-width:none;align-items:start}
.scr .screen>figure{order:2;margin:0}
.scr .screen h3{font-size:32px;line-height:1.2;letter-spacing:-.01em}
.lt :focus-visible{outline-color:#A6480C}
@media (max-width:900px){article>section{padding-block:80px}.scr .screen{grid-template-columns:minmax(0,1fr);gap:24px}.scr .screen>figure{order:0}}
article>section{width:100%}
/* site top bar, same as the home page; no theme toggle because this case study keeps its own fixed look */
.wrap{padding-top:40px}
.bar{margin-inline:calc(50% - 50vw)}
/* Vishal 2026-10-13: header keeps the frosted blur, same as the home page (the solid navy try is undone) */
/* Vishal 2026-10-13: header looks exactly like the home page header (its dark look, since this page is dark), with no navy tint.
   Same frosted blur; a touch more opaque than home so the navy page behind doesn't tint it blue. */
/* Vishal 2026-10-14 02:29: Basil's reel is light, so the top stays dark and the header keeps the dark bar */
body{margin-top:0}
.progress{z-index:30}
.summary{max-width:1080px;margin-inline:auto}
.summary h2{font-size:13px;font-family:var(--sans);font-weight:600;letter-spacing:.14em;color:var(--acc)}
.summary p{font-size:16px}
.pill[aria-pressed=true][data-act=cc]{background:#fff;color:#1A332E}
video::cue{font:500 18px/1.4 var(--sans);background:rgba(26,51,46,.82);color:#fff}
.beforeafter .a{box-shadow:inset 0 0 0 1px #A6480C}
.beforeafter .a .k{color:#A6480C}
.swipe{display:none}
@media (max-width:620px){
  #flow figure{display:none}
  .swipe{display:flex;gap:16px;list-style:none;margin:32px -28px 0;padding:0 28px 8px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-inline:28px;overscroll-behavior-x:contain}
  .swipe li{flex:0 0 260px;scroll-snap-align:start;display:grid;gap:8px;align-content:start}
  .swipe p{font-size:17px;font-weight:600;line-height:1.3;color:var(--fg);min-height:2.6em}
  .swipe img{width:100%;height:auto;border-radius:28px;margin-top:8px;box-shadow:0 12px 32px rgba(26,51,46,.12)}
}
@media (max-width:620px){article>section{padding-block:64px}.layout{margin-top:64px}.scr .screens{gap:72px}.scr .screen h3{font-size:26px}}

/* ---- audit Phase 2 and 3 ---- */
/* one break between two bands of the same colour, not two */
/* type scale: 13 label, 16 small, 18 body, 22 lead, 32 titles, 48 sections, 68 page title */
.facts p,.stats span,.note,.source,figcaption,.opt p,.fix p,.trade p,.trade .cost,.nextgrid span{font-size:16px}
.list .n,.trade .n,.tag{font-size:13px}
.opt h3,.fix h3,.trade h3,.list h3,.nextgrid b{font-size:18px}
blockquote,.dek,.closing>p,.metric b,.next h2{font-size:22px}
.closing h2,.stats b{font-size:32px}
@media (min-width:621px){.closing h2{font-size:48px}}
/* what I'd change: each pair on its own card, Problem in amber */
.fixes{border-top:0;gap:12px}
.fix{background:var(--card);border:0;border-radius:16px;padding:24px 28px}
.fix>div{display:grid;gap:6px;align-content:start}
.k.pr{color:var(--warm)}
/* the closing line reads as the point, not a footnote */
.closing>p{font-weight:600;color:var(--acc)}
/* more work: a picture and a clear hover */
.nextgrid a{padding:0;overflow:hidden;gap:0;transition:transform .2s ease,box-shadow .2s ease}
.nextgrid img{display:block;width:100%;height:auto;aspect-ratio:800/837;object-fit:cover}
.nextgrid b{padding:16px 20px 20px;line-height:1.35}
.nextgrid a:hover,.nextgrid a:focus-visible{transform:translateY(-2px);box-shadow:0 0 0 1px var(--acc)}
.nextgrid a:hover b{text-decoration:underline;text-underline-offset:.2em}
/* prototype: a still and a way out while Figma loads */
.protowrap{position:relative;margin:0}
/* Desktop: the prototype fits one screen between the sticky header and the bottom dock (Vishal 2026-10-13 "going into two scrolls") */
@media (min-width:641px){.protowrap{width:min(100%,calc((100svh - 120px) * 16 / 10));margin-inline:auto}}
.protowait{position:absolute;inset:0;border-radius:24px;background:var(--card);display:grid;place-content:center;justify-items:center;gap:12px;text-align:center;transition:opacity .3s ease}
.protowait img{width:120px;height:auto;border-radius:16px;opacity:.9}
.protowait p{font-size:16px;color:var(--muted)}
.protowait a{font-size:16px;font-weight:600;color:var(--fg);padding:10px 4px}
.protowrap.ready .protowait{opacity:0;pointer-events:none}
@media (prefers-reduced-motion:reduce){.nextgrid a,.protowait{transition:none}}
html.calm .nextgrid a,html.calm .protowait{transition:none}
@media (max-width:620px){
  .opt{grid-template-columns:minmax(0,1fr)}
  .opt .tag{order:-1;justify-self:start}
  .fix{padding:20px}
}
</style>

<style is:inline>
/* Basil only. Colours from the Basil boards: ink #1A332E, lime #C8E616, cream #F9F9EC, the rust eyebrow (deepened to #A6480C
   so it reads on cream), pale lime #EEF6C8 for the chosen option and amber #FCF1DC for the two AOV blocks of the audit.
   Light pattern (2026-10-13): dark top and 30 second version, light story sections, one dark band (The lever), light after. */
.vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.wrap>.facts{grid-template-columns:repeat(4,minmax(0,1fr))}
@media (min-width:1000px){.wrap>.facts.facts{grid-template-columns:repeat(4,minmax(0,max-content))}}
.goals>div{align-content:start}
.wrap>.endsec{margin-top:0}
.facts div{align-content:start}
article>section{padding-top:120px}
article>section#why{--band:#FDFDF6;--card:#F3F4E3}
article>section#audit{--band:#F3F4E3;--card:#FDFDF6}
article>section#lever{--band:#1A332E;--card:#23413B}
article>section#desktop{--band:#FDFDF6;--card:#F3F4E3}
article>section#mobile{--band:#F3F4E3;--card:#FDFDF6}
article>section#states{--band:#FDFDF6;--card:#F3F4E3}
article>section#rationale{--band:#F3F4E3;--card:#FDFDF6}
article>section#changed{--band:#FDFDF6;--card:#F3F4E3}
article>section#learned{--band:#F3F4E3;--card:#FDFDF6}
@media (max-width:900px){article>section{padding-top:80px}}
@media (max-width:620px){article>section{padding-top:64px}}
.wrap>.layout{margin-top:96px}
@media (max-width:620px){.wrap>.layout{margin-top:64px}}
/* section intros in the wide sections */
.intro{display:grid;gap:22px;max-width:66ch}
section h3{font-size:20px;line-height:1.3;letter-spacing:-.01em}
.sub{margin-top:56px;font-size:24px!important}
.role{background:var(--card);border-radius:16px;padding:20px 24px;display:grid;grid-template-columns:auto minmax(0,1fr);gap:16px;align-items:start}
.role .k{padding-top:4px}
.role p{color:var(--fg);font-weight:500}
.goals{margin-top:8px}
.goals h3{font-size:20px}
.goals p{color:var(--body)}
.goals>div>p+p{margin-top:4px}
.goals.three{grid-template-columns:repeat(3,minmax(0,1fr))}
.goals.plain p{color:var(--fg)}
#rationale .goals,#changed .goals{margin-top:40px}
#changed .sub+.goals{margin-top:24px}
/* audit */
.audit{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,8fr);gap:40px;margin-top:48px;align-items:start}
.bbox{display:grid;gap:12px}
.bbox ol{list-style:none;margin:0;padding:0;display:grid;gap:8px}
.bbox li{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px 16px;font-size:16px;line-height:1.4;color:var(--fg)}
.bbox li.btn-row{background:#1A332E;color:#F9F9EC;border-color:#1A332E;font-weight:600}
.bbox li.amb{background:#FCF1DC;border-color:#EBC98E;font-weight:600}
.bbox figcaption{font-size:16px}
.finds{display:grid;gap:12px}
.finds>div{background:var(--card);border-radius:16px;padding:22px 24px;display:grid;grid-template-columns:44px minmax(0,1fr);gap:6px 12px}
.finds .n{font-size:20px;font-weight:700;color:var(--acc);line-height:1.3}
.finds p{grid-column:2;font-size:16px}
.finds .keep{background:#EEF6C8;display:grid;grid-template-columns:minmax(0,1fr);gap:8px}
.finds .keep p{grid-column:1;color:#1A332E}
/* lever: the set, then levers and behaviour */
.set{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr) auto minmax(0,1fr) minmax(0,1.6fr);gap:16px;align-items:center;margin-top:48px;background:#F9F9EC;border-radius:24px;padding:28px}
.set figure{gap:10px;align-self:start}
.set img{width:100%;height:auto;border-radius:14px}
.set figcaption{display:grid;gap:2px;color:#1A332E}
.set figcaption b{font-size:16px;font-weight:600}
.set figcaption span{font-size:14px;color:#5F6B67}
.set>i{font-style:normal;font-size:28px;font-weight:700;color:#5F6B67;margin-top:-40px}
.set .total{background:#1A332E;border-radius:16px;padding:24px;display:grid;gap:4px;color:#F9F9EC}
.set .total .k{color:#C8E616}
.set .total s{font-size:20px;color:#A9B8B2}
.set .total b{font-size:clamp(36px,4vw,52px);font-weight:700;line-height:1.1;letter-spacing:-.02em}
.set .total p{color:#F9F9EC;font-size:16px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:40px}
.two .sub{margin-bottom:20px}
.options .opt h3{font-size:18px}
.opt.built{background:#EEF6C8;border-color:#EEF6C8}
.opt.built h3,.opt.sec h3{color:#1A332E}.opt.built p,.opt.sec p{color:#46524E}
.opt.built .tag{background:#1A332E;color:#F9F9EC;border-color:#1A332E}
.opt.sec{background:#EEF6C8;border-color:#EEF6C8}
.opt.sec .tag{background:#C8E616;color:#1A332E;border-color:#C8E616}
.beh{display:grid;gap:12px}
.beh>div{background:var(--card);border-radius:14px;padding:20px 22px;display:grid;gap:6px}
.beh h3{font-size:18px}
.beh p{font-size:16px}
/* desktop screen beside its five changes */
.dsk{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:48px;margin-top:48px;align-items:start}
.dsk .shot{border-radius:16px;box-shadow:0 20px 50px rgba(26,51,46,.14)}
.dsk>div{position:sticky;top:120px;display:grid;gap:16px}
.dsk .finds>div{padding:18px 20px}
.dsk .finds .n{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#1A332E;color:#C8E616;font-size:15px}
/* mobile: three phones, full length, each scrolls inside its frame */
.mob{display:grid;grid-template-columns:repeat(3,minmax(0,300px));justify-content:center;column-gap:clamp(24px,5vw,72px);row-gap:48px;margin-top:56px}
.mob figure{gap:20px;align-content:start}
.mob figcaption{display:grid;gap:8px}
.mob figcaption p{font-size:16px;color:var(--body)}
/* states */
.states{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;margin-top:40px;align-items:start}
.states figure{gap:12px}
.states .k{color:var(--fg);letter-spacing:.02em;text-transform:none;font-size:15px}
.states img{width:100%;height:auto;border-radius:14px}
.states figcaption{font-size:15px;line-height:1.5}
#states .sub+.states{margin-top:24px}
/* what changed */
.tbl{width:100%;border-collapse:collapse;font-size:16px;line-height:1.45;margin-top:40px}
.tbl th{text-align:left;font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--acc);padding:0 16px 12px 0}
.tbl td{padding:16px 16px 16px 0;border-top:1px solid var(--line);color:var(--body);vertical-align:top}
.tbl td:first-child,.tbl td.aft{color:var(--fg);font-weight:600}
.test{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:24px}
.test>div{background:var(--card);border-radius:16px;padding:22px;display:grid;gap:8px;align-content:start}
.test p{font-size:16px}
.test .setup{background:#1A332E}.test .setup .k{color:#C8E616}.test .setup p{color:#F9F9EC}
/* learned */
#learned .list{margin-top:40px;gap:0;border-top:1px solid var(--line)}
#learned .list>div{grid-template-columns:72px minmax(0,1fr);padding-block:24px;border-bottom:1px solid var(--line)}
#learned .list .n{font-size:28px;font-weight:700;color:var(--acc);font-family:var(--sans);line-height:1.1;padding-top:0}
#learned .list h3{font-size:22px}
@media (max-width:1100px){.set{grid-template-columns:minmax(0,1fr) auto minmax(0,1fr) auto minmax(0,1fr)}.set .total{grid-column:1/-1}}
@media (max-width:900px){
  .goals.three,.audit,.two,.dsk{grid-template-columns:minmax(0,1fr)}
  .dsk>div{position:static}
  .states,.test{grid-template-columns:1fr 1fr}
  .mob{grid-template-columns:minmax(0,300px);justify-content:center}
}
@media (max-width:620px){
  .wrap>.facts{grid-template-columns:1fr 1fr}
  .role{grid-template-columns:minmax(0,1fr);gap:8px;padding:18px}
  .finds>div{padding:18px;grid-template-columns:36px minmax(0,1fr)}
  .set{grid-template-columns:minmax(0,1fr) auto minmax(0,1fr) auto minmax(0,1fr);gap:8px;padding:16px;border-radius:18px}
  .set>i{font-size:18px;margin-top:-56px}
  .set figcaption b{font-size:13px;line-height:1.3}.set figcaption span{font-size:12px}
  /* phones: the states and the three phones are one swipe row each, the next card peeking in */
  .states,.mob{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;margin-inline:-28px;padding:0 28px 8px;scroll-padding-inline:28px;gap:16px;overscroll-behavior-x:contain}
  .states>figure{flex:0 0 78%;scroll-snap-align:start}
  .mob>figure{flex:0 0 74%;scroll-snap-align:start}
  .mob{margin-top:40px;justify-content:flex-start}
  .states figcaption{font-size:14px}
  .test{grid-template-columns:minmax(0,1fr)}
  .tbl,.tbl tbody,.tbl tr,.tbl td{display:block}.tbl thead{display:none}
  .tbl tr{padding:14px 0;border-top:1px solid var(--line)}.tbl td{border:0;padding:2px 0}
  .tbl td[data-l]::before{content:attr(data-l) " ";font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);display:inline-block;margin-right:6px}
  #learned .list>div{grid-template-columns:56px minmax(0,1fr)}
  #learned .list .n{font-size:22px}
}
