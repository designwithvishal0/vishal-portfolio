---
import '@fontsource-variable/hanken-grotesk';
import { intro, work, caseHeader } from '../../data/home';
// Layout per /mnt/project-files/research/visual-research.md: priority sized tiles,
// headline led tiles with a metadata line, hero proven by a live moment, one motion system.
const sizes = ['wide', 'half', 'half', 'wide'];
const results = [
  { n: 60, label: 'conversion lift on critical flows' },
  { n: 50, label: 'click through lift on landing pages, rebuilt from Hotjar and Clarity recordings' },
  { n: 30, label: 'faster campaign turnaround from the Figma design system I built' },
];
---
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title>Direction B2, Quiet with motion</title>
<style>
  :root{
    --bg:#F7F7F6;--ink:#1D1D1F;--muted:#6E6E73;--rule:#E2E2E0;--accent:#2B54D6;--card:#EDEDEB;--dark:#16171A;
    --sans:'Hanken Grotesk Variable',system-ui,sans-serif;
    --ease-out:cubic-bezier(.23,1,.32,1);--ease-io:cubic-bezier(.77,0,.175,1);
    --press:120ms;--hover:180ms;--enter:360ms;--section:500ms;
  }
  @media (prefers-color-scheme:dark){:root{--bg:#111113;--ink:#F2F2F3;--muted:#A1A1A6;--rule:#26262A;--accent:#7D9BFF;--card:#1C1C1F;--dark:#000}}
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--bg);color:var(--ink);font:400 18px/1.45 var(--sans);-webkit-font-smoothing:antialiased}
  .wrap{max-width:1200px;margin:0 auto;padding:0 24px}
  a{color:inherit}
  :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:4px}
  .ul{text-decoration:none;background:linear-gradient(currentColor,currentColor) 0 100%/0 1px no-repeat;transition:background-size var(--hover) var(--ease-out)}
  .ul:hover,.ul:focus-visible{background-size:100% 1px}

  /* top bar */
  .top{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:24px 0;font-size:15px}
  .top h1{font-size:15px;font-weight:600;margin:0}
  .status{color:var(--muted);display:inline-flex;align-items:center;gap:8px}
  .dot{position:relative;width:7px;height:7px;border-radius:50%;background:#1F9D55}
  .dot::after{content:"";position:absolute;inset:0;border-radius:50%;background:#1F9D55;animation:ping 2.4s var(--ease-out) infinite}
  @keyframes ping{from{transform:scale(1);opacity:.6}to{transform:scale(3);opacity:0}}
  @media (max-width:640px){.top{flex-direction:column;align-items:flex-start}}

  /* hero */
  .hero{display:grid;grid-template-columns:1.25fr .75fr;gap:56px;align-items:end;padding:96px 0 112px}
  @media (max-width:900px){.hero{grid-template-columns:1fr;padding:56px 0 80px}}
  .pos{font-size:clamp(46px,7vw,104px);line-height:.98;letter-spacing:-.045em;font-weight:650;margin:0 0 32px}
  .sup{font-size:19px;color:var(--muted);max-width:50ch;margin:0 0 28px}
  .aud{display:flex;flex-direction:column;gap:6px;margin:0 0 32px;padding:0;list-style:none;font-size:16px}
  .aud a{font-weight:600}
  .aud span{color:var(--muted);font-weight:400}
  .cta{display:flex;gap:10px;flex-wrap:wrap}
  .btn{display:inline-block;padding:12px 22px;border-radius:999px;text-decoration:none;font-weight:600;font-size:16px;border:1px solid var(--rule);background:var(--bg);transition:background-color var(--hover) var(--ease-out),border-color var(--hover) var(--ease-out),transform var(--press) var(--ease-out)}
  .btn:hover{border-color:var(--ink)}
  .btn:active{transform:scale(.97)}
  .btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
  .btn.primary:hover{background:color-mix(in srgb,var(--accent) 88%,#000)}
  @media (prefers-color-scheme:dark){.btn.primary{color:#0B1230}}

  /* the moment card: a live illustration of an unsure moment */
  .moment{background:var(--dark);color:#F2F2F3;border-radius:24px;padding:24px;box-shadow:0 30px 60px -30px rgba(20,24,40,.45)}
  .moment small{display:block;color:#9A9AA0;font-size:13px;margin-bottom:18px}
  .m-row{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
  .m-train{font-weight:600}
  .m-state{font-size:40px;line-height:1.05;letter-spacing:-.03em;font-weight:650;margin:18px 0 6px;min-height:2.1em}
  .m-sub{color:#B8B8BE;font-size:15px;min-height:3em;margin:0 0 18px}
  .m-bar{height:4px;border-radius:4px;background:#2C2D33;overflow:hidden}
  .m-bar i{display:block;height:100%;width:var(--p,8%);background:#F2F2F3;border-radius:4px;transition:width var(--section) var(--ease-io)}
  .m-steps{display:flex;justify-content:space-between;font-size:12px;color:#8A8A90;margin-top:8px}
  .m-steps b{color:#F2F2F3;font-weight:600}
  .m-btn{margin-top:20px;width:100%;padding:12px;border-radius:12px;border:0;background:#F2F2F3;color:#16171A;font:600 15px var(--sans);cursor:pointer;transition:transform var(--press) var(--ease-out),opacity var(--hover)}
  .m-btn:active{transform:scale(.97)}
  .swap{animation:swap var(--enter) var(--ease-out)}
  @keyframes swap{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

  /* work */
  .sec-head{display:flex;justify-content:space-between;align-items:baseline;border-top:1px solid var(--rule);padding:20px 0 32px;font-size:15px;color:var(--muted)}
  .sec-head h2{font-size:15px;font-weight:600;color:var(--ink);margin:0}
  .work{display:grid;grid-template-columns:1fr 1fr;gap:72px 32px;padding:0 0 128px}
  .tile{display:block;text-decoration:none}
  .tile.wide{grid-column:1/-1}
  @media (max-width:760px){.work{grid-template-columns:1fr;gap:56px}}
  .meta{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:14px;color:var(--muted);margin:0 0 14px}
  .pill{border:1px solid var(--rule);border-radius:999px;padding:1px 10px;color:var(--ink)}
  .media{position:relative;background:var(--card);border-radius:20px;overflow:hidden;aspect-ratio:4/3;border:1px solid transparent;transition:border-color var(--hover) var(--ease-out),transform var(--enter) var(--ease-out)}
  .tile.wide .media{aspect-ratio:16/8}
  @media (max-width:760px){.tile.wide .media{aspect-ratio:4/3}}
  .media img,.media video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 0}
  .media img{transition:object-position 6s linear}
  .play{position:absolute;left:16px;bottom:16px;font-size:13px;font-weight:600;background:color-mix(in srgb,var(--bg) 85%,transparent);backdrop-filter:blur(8px);padding:6px 12px;border-radius:999px;opacity:0;transform:translateY(4px);transition:opacity var(--hover) var(--ease-out),transform var(--hover) var(--ease-out)}
  .tile h3{font-size:clamp(26px,2.6vw,36px);line-height:1.1;letter-spacing:-.025em;font-weight:650;margin:22px 0 8px}
  .tile.wide h3{font-size:clamp(30px,3.6vw,48px)}
  .tile p{margin:0;color:var(--muted);max-width:52ch}
  .tile .more{display:inline-block;margin-top:14px;font-weight:600;font-size:16px}
  .tile .more::after{content:"";display:inline-block;width:.5em;height:.5em;border-top:2px solid currentColor;border-right:2px solid currentColor;transform:rotate(45deg);margin-left:.45em;transition:transform var(--hover) var(--ease-out)}
  @media (hover:hover) and (pointer:fine){
    .tile:hover .media{border-color:var(--ink)}
    .tile:hover .media img{object-position:50% 100%}
    .tile:hover .play,.tile:focus-visible .play{opacity:1;transform:none}
    .tile:hover .more::after{transform:translateX(4px) rotate(45deg)}
  }
  .tile.inview .media img{object-position:50% 100%}
  @media (hover:hover) and (pointer:fine){.tile.inview .media img{object-position:50% 0}.tile.inview:hover .media img{object-position:50% 100%}}

  /* results */
  .results{background:var(--dark);color:#F2F2F3;border-radius:28px;padding:56px 48px;margin:0 0 128px}
  .results h2{font-size:15px;font-weight:600;color:#A1A1A6;margin:0 0 40px}
  .r-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px}
  @media (max-width:760px){.results{padding:40px 24px}.r-grid{grid-template-columns:1fr}}
  .r-num{font-size:clamp(56px,7vw,96px);line-height:1;letter-spacing:-.05em;font-weight:650;font-variant-numeric:tabular-nums}
  .r-label{color:#B8B8BE;margin-top:12px;max-width:30ch}

  /* case header */
  .case{padding:0 0 140px}
  .eyebrow{font-size:15px;color:var(--accent);font-weight:600;margin:0 0 20px}
  .case h2{font-size:clamp(40px,6vw,84px);line-height:1.02;letter-spacing:-.035em;font-weight:650;margin:0 0 32px;max-width:14ch}
  .sum{font-size:21px;max-width:60ch;margin:0 0 48px}
  .facts{display:grid;grid-template-columns:repeat(4,auto);justify-content:start;gap:16px 56px;margin:0 0 56px;padding:20px 0;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}
  @media (max-width:640px){.facts{grid-template-columns:1fr 1fr}}
  .facts dt{font-size:14px;color:var(--muted)}
  .facts dd{margin:4px 0 0;font-weight:600}

  footer{border-top:1px solid var(--rule);padding:24px 0 48px;display:flex;justify-content:space-between;gap:16px;font-size:15px;color:var(--muted)}
  footer button{font:inherit;color:var(--ink);background:none;border:1px solid var(--rule);border-radius:999px;padding:6px 14px;cursor:pointer}

  /* entrance and reveal: content is visible without JS */
  .js .reveal{opacity:0;transform:translateY(12px)}
  .js .reveal.on{opacity:1;transform:none;transition:opacity var(--section) var(--ease-out),transform var(--section) var(--ease-out)}
  .enter{animation:enter var(--enter) var(--ease-out) both}
  @keyframes enter{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

  /* reduced motion: OS setting or the footer toggle */
  @media (prefers-reduced-motion:reduce){
    *,*::before,*::after{animation:none!important;transition-duration:150ms!important;scroll-behavior:auto!important}
    .js .reveal{transform:none}
    .media img{object-position:50% 0!important}
  }
  .calm *,.calm *::before,.calm *::after{animation:none!important;transition-duration:150ms!important}
  .calm .js .reveal,.calm .reveal{transform:none!important}
  .calm .media img{object-position:50% 0!important}
</style>
<script is:inline>document.documentElement.classList.add('js');try{if(localStorage.getItem('calm')==='1')document.documentElement.classList.add('calm')}catch(e){}</script>
</head>
<body>
<div class="wrap">
  <div class="top">
    <h1>{intro.name}</h1>
    <span class="status"><span class="dot" aria-hidden="true"></span>{intro.availability}</span>
  </div>

  <section class="hero">
    <div>
      <p class="pos enter">{intro.positioning}</p>
      <p class="sup enter" style="animation-delay:60ms">{intro.supporting}</p>
      <ul class="aud enter" style="animation-delay:120ms" aria-label="Start here">
        <li><a class="ul" href="#work">Hiring a product designer</a> <span>See the case studies</span></li>
        <li><a class="ul" href="#results">Recruiting</a> <span>The 30 second version</span></li>
        <li><a class="ul" href="#work">Founder</a> <span>Need a page that sells</span></li>
      </ul>
      <div class="cta enter" style="animation-delay:180ms">
        <a class="btn primary" href={intro.links[1].href}>{intro.links[1].label}</a>
        <a class="btn" href={intro.links[0].href}>{intro.links[0].label}</a>
      </div>
    </div>

    <div class="moment enter" style="animation-delay:120ms" aria-live="polite">
      <small>An unsure moment, from the ixigo case study</small>
      <div class="m-row"><span class="m-train">Chart prepares at 5:40 PM</span><span id="m-time" style="font-variant-numeric:tabular-nums">3:59:59</span></div>
      <p class="m-state" id="m-state">Waitlist 24, 70 percent</p>
      <p class="m-sub" id="m-sub">Honest odds, a countdown to the chart, and a backup seat held on the 12138. Nothing is charged now.</p>
      <div class="m-bar"><i id="m-bar"></i></div>
      <div class="m-steps" aria-hidden="true"><span>Booked</span><b id="m-s2">Waiting</b><span id="m-s3">Chart</span><span id="m-s4">Decided</span></div>
      <button class="m-btn" id="m-btn" type="button">Skip to chart time</button>
    </div>
  </section>

  <div class="sec-head" id="work"><h2>Selected work</h2><span>4 case studies</span></div>
  <section class="work" aria-label="Selected work">
    {work.map((w, i) => (
      <a class={`tile reveal ${sizes[i]}`} href={`#${w.slug}`}>
        <div class="meta"><span class="pill">{w.type.includes('B2B') ? 'B2B concept' : 'Concept'}</span><span>{w.year}</span><span>{w.role}</span></div>
        <div class="media">
          <img src={w.image} alt={w.alt} width="1464" height="1532" loading={i ? 'lazy' : 'eager'} decoding="async" />
          <span class="play" aria-hidden="true">{w.detail}</span>
        </div>
        <h3>{w.headline}</h3>
        <p>{w.problem}</p>
        <span class="more">View the case study</span>
      </a>
    ))}
  </section>

  <section class="results reveal" id="results" aria-labelledby="r-h">
    <h2 id="r-h">Shipped at CashKaro, for 25M+ users</h2>
    <div class="r-grid">
      {results.map(r => (
        <div><div class="r-num" data-n={r.n}>{r.n}%</div><div class="r-label">{r.label}</div></div>
      ))}
    </div>
  </section>

  <section class="case reveal" aria-labelledby="case">
    <div class="sec-head" style="padding-bottom:56px"><span>Case study header, shown here for review only</span></div>
    <p class="eyebrow">{caseHeader.eyebrow}</p>
    <h2 id="case">{caseHeader.title}</h2>
    <p class="sum">{caseHeader.summary}</p>
    <dl class="facts">{caseHeader.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
  </section>

  <footer>
    <span>Direction B2 preview</span>
    <button id="calm" type="button" aria-pressed="false">Reduce motion</button>
  </footer>
</div>

<script is:inline>
(() => {
  const root = document.documentElement;
  const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches || root.classList.contains('calm');

  // Reduce motion toggle
  const calm = document.getElementById('calm');
  const sync = () => { const on = root.classList.contains('calm'); calm.setAttribute('aria-pressed', on); calm.textContent = on ? 'Motion off' : 'Reduce motion'; };
  calm.addEventListener('click', () => { root.classList.toggle('calm'); try { localStorage.setItem('calm', root.classList.contains('calm') ? '1' : '0'); } catch (e) {} sync(); });
  sync();

  // Reveal once, and on touch screens pan a tile while it is in view
  const io = new IntersectionObserver(es => es.forEach(e => {
    if (e.isIntersecting) e.target.classList.add('on');
    if (e.target.classList.contains('tile')) e.target.classList.toggle('inview', e.intersectionRatio > .6);
  }), { threshold: [0, .15, .6] });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  // Count up the results once
  const nums = document.querySelectorAll('.r-num');
  const cio = new IntersectionObserver(es => es.forEach(e => {
    if (!e.isIntersecting) return; cio.unobserve(e.target);
    if (reduced()) return;
    const n = +e.target.dataset.n, t0 = performance.now(), d = 900;
    const tick = t => { const p = Math.min((t - t0) / d, 1); e.target.textContent = Math.round(n * (1 - Math.pow(1 - p, 4))) + '%'; if (p < 1) requestAnimationFrame(tick); };
    requestAnimationFrame(tick);
  }), { threshold: .5 });
  nums.forEach(n => cio.observe(n));

  // The unsure moment: a countdown that resolves into a decision
  const $ = id => document.getElementById(id);
  const states = [
    { s: 'Waitlist 24, 70 percent', sub: 'Honest odds, a countdown to the chart, and a backup seat held on the 12138. Nothing is charged now.', p: '8%', step: 2, btn: 'Skip to chart time' },
    { s: 'The chart did not clear', sub: 'Said plainly, no softening. Your refund is already moving.', p: '62%', step: 3, btn: 'Show the way out' },
    { s: 'Take the held seat on the 12138', sub: 'One tap and you are booked. The refund comes separately, so you never wait for money to travel again.', p: '100%', step: 4, btn: 'Start again' },
  ];
  let i = 0, secs = 4 * 3600 - 1;
  const fmt = s => `${Math.floor(s / 3600)}:${String(Math.floor(s / 60) % 60).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
  const render = () => {
    const st = states[i];
    $('m-state').textContent = st.s; $('m-sub').textContent = st.sub; $('m-btn').textContent = st.btn;
    $('m-bar').style.setProperty('--p', st.p);
    ['m-s2', 'm-s3', 'm-s4'].forEach((id, k) => { const el = $(id); el.style.color = k + 2 === st.step ? '#F2F2F3' : ''; el.style.fontWeight = k + 2 === st.step ? '600' : '400'; });
    if (!reduced()) { $('m-state').classList.remove('swap'); void $('m-state').offsetWidth; $('m-state').classList.add('swap'); }
    if (i) $('m-time').textContent = '0:00:00';
  };
  setInterval(() => { if (i === 0 && secs > 0 && !reduced()) $('m-time').textContent = fmt(--secs); }, 1000);
  $('m-btn').addEventListener('click', () => { i = (i + 1) % states.length; if (!i) secs = 4 * 3600 - 1; render(); });
})();
</script>
</body>
</html>
