            <a class="btn popen" href="https://www.figma.com/proto/lC9pdClUznIhehVGRnLVMb/?node-id=217:191&amp;starting-point-node-id=217:191&amp;scaling=scale-down-width&amp;content-scaling=fixed" target="_blank" rel="noopener">Open the prototype</a>
          </div>
        </div>
        <script is:inline>(()=>{
          const s=document.currentScript.previousElementSibling,fr=s.querySelector('iframe'),w=s.querySelector('.pwrap'),op=s.querySelector('.popen'),bs=[...s.querySelectorAll('.flows button[data-n]')];
          const q=n=>'?node-id='+n+'&starting-point-node-id='+n+'&scaling=scale-down-width&content-scaling=fixed';
          fr.addEventListener('load',()=>w.classList.add('ready'));
          const src=n=>'https://embed.figma.com/proto/lC9pdClUznIhehVGRnLVMb/'+q(n)+'&hide-ui=1&embed-host=share';
          /* Desktop full screen (Vishal 03:53, as on ixigo): the prototype at its real size with Figma's own zoom controls */
          const fsrc=n=>'https://www.figma.com/embed?embed_host=share&url='+encodeURIComponent('https://www.figma.com/proto/lC9pdClUznIhehVGRnLVMb/'+q(n));
          let cur='217:191';
          bs.forEach(b=>b.onclick=()=>{bs.forEach(x=>x.setAttribute('aria-pressed',String(x===b)));w.classList.remove('ready');cur=b.dataset.n;fr.src=w.classList.contains('fs')?fsrc(cur):src(cur);op.href='https://www.figma.com/proto/lC9pdClUznIhehVGRnLVMb/'+q(cur)});
          const fs=on=>{if(on===w.classList.contains('fs'))return;w.classList.remove('ready');w.classList.toggle('fs',on);fr.src=on?fsrc(cur):src(cur);(on?w.querySelector('.protofsx'):s.querySelector('.protofs')).focus({preventScroll:true})};
          s.querySelector('.protofs').onclick=()=>fs(true);op.addEventListener('click',e=>{if(matchMedia('(min-width:901px)').matches){e.preventDefault();fs(true)}});w.querySelector('.protofsx').onclick=()=>fs(false);addEventListener('keydown',e=>{if(e.key==='Escape'&&w.classList.contains('fs'))fs(false)});
