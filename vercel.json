{
  "git": {
    "deploymentEnabled": {
      "claude/**": false
    }
  },
  "redirects": [
    {
      "source": "/looks",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/looks/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/directions",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/directions/(.*)",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "vishal-designs-preview.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "vishal-preview.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "vishal-portfolio-pink-ten.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
