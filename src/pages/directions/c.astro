---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/instrument-sans';
import { intro, work, caseHeader } from '../../data/home';
---
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title>Direction C, The unsure moment</title>
<style>
  :root{--bg:#F8F9FB;--ink:#0F2140;--muted:#4D5B73;--rule:#D9DEE7;--amber:#F2B33D;--panel:#ECEFF4;
    --display:'Bricolage Grotesque Variable',system-ui,sans-serif;--sans:'Instrument Sans Variable',system-ui,sans-serif}
  @media (prefers-color-scheme:dark){:root{--bg:#0B1628;--ink:#EEF2F8;--muted:#A6B2C6;--rule:#21324D;--panel:#13223A}}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font:400 18px/1.45 var(--sans)}
  .wrap{max-width:1160px;margin:0 auto;padding:0 24px}
  a{color:inherit}
  a:focus-visible{outline:3px solid var(--amber);outline-offset:4px}

  header{padding:104px 0 96px;display:grid;grid-template-columns:1.4fr 1fr;gap:48px;align-items:end}
  @media (max-width:860px){header{grid-template-columns:1fr;padding-top:64px}}
  h1{font:700 17px/1.2 var(--sans);margin:0 0 28px}
  .pos{font:700 clamp(44px,6.8vw,96px)/.98 var(--display);letter-spacing:-.035em;margin:0;font-variation-settings:"wdth" 90}
  .pos mark{background:var(--amber);color:#0F2140;padding:0 .04em}
  .sup{color:var(--muted);margin:0 0 24px;max-width:46ch}
  .status{display:flex;align-items:center;gap:10px;font-weight:600;margin:0 0 20px}
  .dot{width:9px;height:9px;border-radius:50%;background:var(--amber);outline:2px solid var(--ink);outline-offset:1px}
  .links a{font-weight:600;margin-right:22px;text-decoration-thickness:2px;text-decoration-color:var(--amber);text-underline-offset:5px}

  .work{border-top:2px solid var(--ink)}
  .row{display:grid;grid-template-columns:1.3fr 1fr;gap:48px;padding:64px 0;border-bottom:1px solid var(--rule);text-decoration:none;align-items:center}
  @media (max-width:860px){.row{grid-template-columns:1fr;gap:24px;padding:48px 0}}
  .q{font:600 clamp(32px,4.4vw,56px)/1.04 var(--display);letter-spacing:-.025em;margin:0 0 24px}
  .q::before{content:"“"}.q::after{content:"”"}
  .row h3{font-size:20px;margin:0 0 6px}
  .row .name{color:var(--muted);font-size:15px;margin:0 0 14px}
  .row p{margin:0 0 14px;max-width:50ch}
  .row .meta{font-size:15px;color:var(--muted)}
  .row .cta{display:inline-block;margin-top:18px;font-weight:600;text-decoration:underline;text-decoration-color:var(--amber);text-decoration-thickness:2px;text-underline-offset:5px}
  .row .img{background:var(--panel);border-radius:20px;overflow:hidden;display:grid;place-items:center;padding:32px 0 0;aspect-ratio:1/1}
  .row img{width:72%;height:auto;align-self:end}

  .case{padding:120px 0 140px}
  .note{font-size:15px;color:var(--muted);margin:0 0 56px}
  .eyebrow{display:inline-block;background:var(--amber);color:#0F2140;font-weight:600;font-size:15px;padding:4px 10px;border-radius:6px;margin:0 0 24px}
  .case h2{font:700 clamp(40px,6vw,84px)/1 var(--display);letter-spacing:-.035em;margin:0 0 32px;max-width:14ch}
  .sum{font-size:21px;max-width:60ch;margin:0 0 48px}
  .facts{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:0 0 56px}
  @media (max-width:640px){.facts{grid-template-columns:1fr 1fr}}
  .facts div{background:var(--panel);border-radius:12px;padding:16px}
  .facts dt{font-size:14px;color:var(--muted)}
  .facts dd{margin:4px 0 0;font-weight:600}
  .case .img{background:var(--panel);border-radius:20px;overflow:hidden;display:grid;place-items:center;padding:48px 0 0}
  .case .img img{width:min(560px,80%);height:auto}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div>
      <h1>{intro.name}</h1>
      <p class="pos">I design for the moment people are <mark>unsure.</mark></p>
    </div>
    <div>
      <p class="sup">{intro.supporting}</p>
      <p class="status"><span class="dot" aria-hidden="true"></span>{intro.availability}</p>
      <p class="links">{intro.links.map(l => <a href={l.href}>{l.label}</a>)}</p>
    </div>
  </header>

  <section class="work" aria-label="Selected work">
    {work.map(w => (
      <a class="row" href={`#${w.slug}`}>
        <div>
          <p class="q">{w.question}</p>
          <h3>{w.headline}</h3>
          <p class="name">{w.name}</p>
          <p>{w.problem}</p>
          <span class="meta">{w.role} · {w.type}, {w.year}</span><br />
          <span class="cta">View the case study</span>
        </div>
        <div class="img"><img src={w.image} alt={w.alt} width="480" height="502" loading="lazy" decoding="async" /></div>
      </a>
    ))}
  </section>

  <section class="case" aria-labelledby="case">
    <p class="note">Case study header</p>
    <p class="eyebrow">{caseHeader.eyebrow}</p>
    <h2 id="case">{caseHeader.title}</h2>
    <p class="sum">{caseHeader.summary}</p>
    <dl class="facts">{caseHeader.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
    <div class="img"><img src={caseHeader.image} alt={work[0].alt} width="1464" height="1532" /></div>
  </section>
</div>
</body>
</html>
