.lede{font-size:22px!important;line-height:1.5!important;color:var(--body);max-width:66ch}
.k.sub{display:block;margin-top:48px}
.intro{display:grid;gap:22px;max-width:66ch}
.cards{display:grid;gap:16px;grid-template-columns:repeat(var(--n,3),minmax(0,1fr))}
.cards>div{background:var(--card);border-radius:16px;padding:24px;display:grid;gap:10px;align-content:start;min-width:0}
.cards h3{font-size:20px;line-height:1.3}
.cards h3.g{color:var(--acc)}
.cards p{font-size:16px;line-height:1.55}
.cards .num{font-size:28px;font-weight:700;line-height:1;color:var(--acc);font-variant-numeric:tabular-nums}
.cards .lbl{font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.cards .hit{color:var(--acc);font-weight:600}
.cards .hl{color:var(--fg);font-weight:500}
.under{background:var(--card);border-radius:16px;padding:28px;display:grid;gap:14px}
.under .big{font-size:22px;line-height:1.45;color:var(--fg);font-weight:500}
.qs{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.qs li{display:flex;gap:12px;align-items:baseline;font-size:19px;font-weight:600;color:var(--fg)}
.qs li::before{content:"";flex:none;width:8px;height:8px;border-radius:50%;background:var(--acc);transform:translateY(-2px)}
.plist{display:grid;gap:14px}
.plist>div{display:grid;grid-template-columns:44px minmax(0,1fr);gap:12px;align-items:baseline}
.plist .n{font-size:20px;font-weight:700;color:var(--acc);font-variant-numeric:tabular-nums}
.plist p{color:var(--fg)}
/* Structure: the five buckets and how a reward moves */
.bk>div{gap:6px}
.bk .id{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:700;color:var(--muted);font-variant-numeric:tabular-nums}
.dot{width:10px;height:10px;border-radius:50%;background:#7C7C88;flex:none}
.dot.w{background:#E9E9EE}.dot.c{background:#FF6A55}.dot.m{background:#C9C9D1}
.bk .act{font-size:15px;font-weight:600;color:var(--muted)}
.bk .act.w{color:#E9E9EE}.bk .act.c{color:#FF6A55}
.moves{display:grid;gap:14px}
.moves>div{display:grid;grid-template-columns:180px minmax(0,1fr);gap:16px;align-items:center}
.moves b{font-size:17px;font-weight:600;color:var(--fg)}
.chain{display:flex;flex-wrap:wrap;align-items:center;gap:8px 10px;margin:0;padding:0;list-style:none}
.chain li{display:inline-flex;align-items:center;gap:8px;height:38px;padding:0 16px;border-radius:100px;box-shadow:inset 0 0 0 1px #2E2E38;background:#141419;font-size:15px;font-weight:500;color:#E9E9EE}
.chain li{position:relative}
.chain li+li{margin-left:18px}
.chain li+li::before{content:"→";position:absolute;left:-20px;color:#7C7C88}
.goldline{color:var(--acc)!important;font-size:19px!important;font-weight:500}
/* flat visuals and dark cards inside light sections */
.darkcard{background:#0A0A0C;border-radius:20px;padding:clamp(16px,3vw,32px);margin:0}
.darkcard img{display:block;width:100%;height:auto}
.wf{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;align-items:start;margin:0;padding:0;list-style:none}
.wf li{display:grid;gap:12px;min-width:0}
.wf b{font-size:17px;font-weight:600;color:var(--fg)}
.wf img{display:block;width:100%;height:auto;border-radius:10px;box-shadow:0 0 0 1px var(--line),0 12px 30px rgba(10,10,12,.08)}
.hf{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(20px,3vw,40px);margin:0;padding:0;list-style:none}
.hf li{display:grid;gap:6px;align-content:start;min-width:0}
.hf b{font-size:19px;font-weight:600;color:var(--fg)}
.hf span{font-size:16px;color:var(--muted);margin-bottom:12px}
.proto-note{background:var(--card);border-radius:16px;padding:24px 28px;display:grid;gap:10px;margin-top:56px;max-width:880px}
.proto-note h3{font-size:20px;color:var(--acc)}
.trades{border-top:0;gap:18px}
.trades>div{display:grid;gap:4px}
.trades h4{margin:0;font-size:17px;font-weight:700;color:var(--acc);letter-spacing:-.005em}
.tbl{width:100%;border-collapse:collapse;font-size:16px;line-height:1.45;background:var(--card);border-radius:16px;overflow:hidden}
.tbl th{text-align:left;font-size:13px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);padding:18px 16px 14px 20px}
.tbl td{padding:16px 16px 16px 20px;border-top:1px solid var(--line);color:var(--body);vertical-align:top}
.tbl td:first-child{color:var(--fg);font-weight:600}
.tag{font-size:13px;font-weight:600;letter-spacing:.02em;padding:4px 10px;border-radius:100px;border:1px solid var(--line);color:var(--fg);justify-self:end}
.met>div{grid-template-columns:minmax(0,1fr) auto}
.met>div>:not(.mid,.tag){grid-column:1/-1}
.met .mid{font-size:15px;font-weight:700;color:var(--muted)}
.guard{margin-top:16px;border-radius:16px;padding:24px 28px;box-shadow:inset 0 0 0 2px var(--acc);display:grid;gap:10px;background:var(--card)}
.guard p{font-size:19px;color:var(--fg)}
@media (max-width:1100px){.cards{--n:2!important}.bk,.met{--n:3!important}}
@media (max-width:900px){.wf,.hf{grid-template-columns:repeat(2,minmax(0,1fr))}.moves>div{grid-template-columns:minmax(0,1fr);gap:8px}}
@media (max-width:620px){
  .cards{--n:1!important}
  .lede{font-size:19px!important}
  .under{padding:22px}.under .big{font-size:19px}
  .chain li{height:34px;padding:0 12px;font-size:14px}
  /* the flow is a wide picture: on phones it scrolls sideways inside its card instead of shrinking to unreadable */
  .darkcard.flowpic{overflow-x:auto;margin-inline:-8px}.darkcard.flowpic img{width:760px;max-width:none}
  .wf,.hf{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;margin-inline:-28px;padding:0 28px 8px;scroll-padding-inline:28px;gap:16px}
  .wf li{flex:0 0 72%;scroll-snap-align:start}
  .hf li{flex:0 0 70%;scroll-snap-align:start}
  .tbl,.tbl tbody,.tbl tr,.tbl td{display:block}.tbl thead{display:none}
  .tbl tr{padding:14px 18px;border-top:1px solid var(--line)}.tbl tr:first-child{border-top:0}.tbl td{border:0;padding:2px 0}
  .tbl td[data-l]::before{content:attr(data-l) ": ";font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
}
</style>
</head>


