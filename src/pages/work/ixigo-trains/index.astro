/* Vishal 2026-10-14 02:28: case studies use the product's own type. The ixigo screens are set only in Inter (his Figma), and its orange is #FF6200.
   Inter runs wider and darker than Albert Sans, so the heaviest weights drop one step to stay crisp, not heavy. */
.big{font-weight:700}
.closing h2{font-weight:700;letter-spacing:-.04em}
h1,h2{letter-spacing:-.025em}
/* Flow full screen on phones (his 03:44) */
.flowfig{position:relative}.flowfs{display:none}
@media (max-width:900px){.flowfs{display:inline-flex;position:absolute;right:10px;bottom:10px;align-items:center;gap:6px;padding:9px 12px;border:0;border-radius:999px;background:rgba(13,15,23,.86);color:#F2F1EC;font:600 13px/1 var(--sans);box-shadow:0 6px 18px rgba(0,0,0,.25)}}
.flowdlg{position:fixed;inset:0;width:100%;height:100%;max-width:none;max-height:none;margin:0;padding:0;border:0;background:#0D0F17}
.flowdlg::backdrop{background:#0D0F17}
.flowpan{position:absolute;inset:0;overflow:auto;-webkit-overflow-scrolling:touch;touch-action:pan-x pan-y pinch-zoom;display:grid;place-items:center}
.flowpan img{display:block;width:100%;height:auto;max-width:none;transition:width .2s ease}
.flowdlg.zoom .flowpan{place-items:start}.flowdlg.zoom .flowpan img{width:260%}
.flowx{position:fixed;top:max(12px,env(safe-area-inset-top));right:12px;z-index:2;width:44px;height:44px;display:grid;place-items:center;border:0;border-radius:50%;background:rgba(13,15,23,.86);color:#F2F1EC;box-shadow:0 0 0 1px rgba(255,255,255,.18)}
.flowhint{position:fixed;left:50%;transform:translateX(-50%);bottom:max(14px,env(safe-area-inset-bottom));margin:0;padding:9px 14px;border-radius:999px;background:rgba(13,15,23,.86);color:#F2F1EC;font:500 13px/1 var(--sans);white-space:nowrap;pointer-events:none}
/* Phones: flow chips inside the open prototype (his 03:50) */
.livechaps{display:none}
@media (max-width:640px){
  .protowrap.live .livechaps{display:flex;gap:8px;width:100%;overflow-x:auto;scrollbar-width:none;padding:2px 2px 4px;flex:none;scroll-snap-type:x proximity}
  .livechaps::-webkit-scrollbar{display:none}
  .livechaps{-webkit-mask-image:linear-gradient(90deg,transparent,#000 16px,#000 calc(100% - 16px),transparent);mask-image:linear-gradient(90deg,transparent,#000 16px,#000 calc(100% - 16px),transparent)}
  .livechaps button{flex:none;scroll-snap-align:center;display:inline-flex;gap:6px;align-items:center;padding:10px 14px;border:0;border-radius:999px;background:rgba(242,241,236,.12);color:#F2F1EC;font:600 14px/1 var(--sans);white-space:nowrap}
  .livechaps button span{color:#FF9A57}
  .livechaps button[aria-pressed="true"]{background:#F2F1EC;color:#0D0F17}
  .livechaps button[aria-pressed="true"] span{color:#C24E00}
  .protowrap.live .proto{width:min(100%,calc((100dvh - 170px) * 412 / 917))}
  .protowrap.live{background:#0D0F17}
}
/* Desktop prototype: bigger, plus full screen with zoom (his 03:47) */
.protofs,.protofsx{display:none}
@media (min-width:901px){
  #try .proto{height:min(860px,calc(100svh - 180px))}
  #try .protowrap{display:flex;flex-direction:column;align-items:center;gap:14px}
  .protofs{display:inline-flex;justify-self:start;align-items:center;gap:8px;padding:13px 18px;border:0;border-radius:999px;background:#1A140F;color:#FFFDFA;font:600 14px/1 var(--sans);cursor:pointer}
  .protofs:hover{background:#3A2F27}
  #try .protowrap.fs{position:fixed;inset:0;z-index:1000;margin:0;padding:24px;background:#0D0F17;justify-content:center}
  #try .protowrap.fs .proto{width:min(1280px,100%);height:calc(100dvh - 48px);aspect-ratio:auto;border-radius:16px}
  #try .protowrap.fs .protowait{display:none}
  #try .protowrap:not(.fs) .protowait{inset:0 auto auto 50%;transform:translateX(-50%);height:min(860px,calc(100svh - 180px));aspect-ratio:412/917}
  .protowrap.fs .protofsx{display:grid;place-items:center;position:fixed;top:20px;right:20px;z-index:2;width:44px;height:44px;border:0;border-radius:50%;background:rgba(13,15,23,.86);color:#F2F1EC;box-shadow:0 0 0 1px rgba(255,255,255,.2);cursor:pointer}
  html:has(.protowrap.fs){overflow:hidden}
  /* Real iPhone frame around the prototype: the same slim iPhone 16 Pro frame as the other case studies (his 04:05, slimmer at 04:08) */
  #try .protowrap:not(.fs) .proto{box-sizing:border-box;border:5px solid #0B0B0B;border-radius:46px;background:#0B0B0B;box-shadow:0 0 0 1.5px #C4C1B9,0 0 0 2.5px #8F8C85,0 24px 50px rgba(60,30,10,.16)}
  #try .protowrap:not(.fs) .protowait{border-radius:46px;border:5px solid #0B0B0B;box-sizing:border-box}
  #try .protowrap:not(.fs)::after{content:"";position:absolute;top:16px;left:50%;width:86px;height:25px;margin-left:-43px;border-radius:99px;background:#0B0B0B;pointer-events:none;z-index:2}
  #try .protowrap:not(.fs)::before{content:"";position:absolute;left:calc(50% - min(860px,calc(100svh - 180px)) * 206 / 917 - 4.5px);top:calc(min(860px,calc(100svh - 180px)) * .19);width:3px;height:calc(min(860px,calc(100svh - 180px)) * .09);border-radius:2px;background:#ABA8A0;box-shadow:calc(min(860px,calc(100svh - 180px)) * 412 / 917 + 6px) calc(min(860px,calc(100svh - 180px)) * .06) 0 0 #ABA8A0}
}
