}
/* decisions: Why and Rejected labelled on every row */
.trade p .k,.trade .cost .k{display:block;margin-bottom:4px}
.trade .cost{color:var(--body)}
.funtest{margin-top:32px;background:var(--card);border-radius:16px;padding:24px 28px;display:grid;gap:10px}
.meask,.still{margin-top:32px}
.still{display:grid;gap:10px}
@media (max-width:620px){.closing h2{white-space:normal!important;font-size:min(44px,11.4vw)!important}}
.list>div{align-items:baseline}
@media (max-width:620px){.funtest{padding:20px}}

/* Vishal 2026-10-13: screens exactly as on Framer. Text left and centred on its screen, screen right at 320px
   (radius 34, 1px #E7E9EE border, soft shadow), a hairline between rows, text and screen fade up 20px */
.screens{gap:0}
.screens .screen{grid-template-columns:minmax(0,560px) 320px;align-items:center;padding-block:60px;border-top:1px solid #E7E9EE}
.screens .screen:first-child{border-top:0;padding-top:0}
.screens .screen:last-child{padding-bottom:0}
#scale .screens .screen{border-top-color:rgba(255,255,255,.1)}
.screens .screen>div{position:static}
.screens .shot.phone,.pop,.pair .shot.phone,.crop{width:320px;max-width:100%;border-radius:34px;border:1px solid #E7E9EE;box-shadow:0 10px 30px rgba(0,0,0,.1)}
.screens .screen>figure.pop{width:320px}
.crop .shot.phone{border:0;border-radius:0;box-shadow:none;width:100%}
.pair{gap:24px}
.screen.owes .right{display:grid;gap:40px;width:320px}
.screen.owes .locks{margin-top:0;gap:40px}
.screen.owes .locks img{max-width:100%}
@media (max-width:900px){
  .screens .screen{grid-template-columns:minmax(0,1fr);gap:28px;padding-block:44px}
  .screens .screen>figure{order:2;justify-self:center}
  .screens .shot.phone,.pop,.screens .screen>figure.pop,.pair .shot.phone,.crop,.pair>*{width:min(260px,100%)!important}
  .screen.owes .right{width:100%;max-width:390px}
  .screen.owes .right>img{width:min(260px,100%);justify-self:center}
}

/* Product type (Vishal 2026-10-14): the Split screens are set in Google Sans, so the page is too, at Google's
   lighter weights. The shared header keeps its own font. */
h1,h2,h3,h4,section h2,.stats b,.metric b,.nextgrid b{font-weight:500}
section h2{letter-spacing:-.01em}
h1{letter-spacing:-.02em}
.closing h2{font-weight:500;letter-spacing:-.025em}

/* User flow full screen on phones (Vishal 03:53, as on ixigo): pinch and double tap zoom */
.flowfs{display:none}
@media (max-width:900px){.flowfs{display:inline-flex;position:absolute;right:10px;top:10px;align-items:center;gap:6px;padding:9px 12px;border:0;border-radius:999px;background:rgba(13,15,23,.86);color:#F2F1EC;font:500 13px/1 var(--sans);box-shadow:0 6px 18px rgba(0,0,0,.25)}.zi{display:none}}
figure:has(>.flowfs){position:relative}
.flowdlg{position:fixed;inset:0;width:100%;height:100%;max-width:none;max-height:none;margin:0;padding:0;border:0;background:#0D0F17}
.flowdlg::backdrop{background:#0D0F17}
.flowpan{position:absolute;inset:0;overflow:auto;-webkit-overflow-scrolling:touch;touch-action:pan-x pan-y pinch-zoom;display:grid;place-items:center}
.flowpan img{display:block;width:100%;height:auto;max-width:none;transition:width .2s ease}
.flowdlg.zoom .flowpan{place-items:start}.flowdlg.zoom .flowpan img{width:260%}
.flowx{position:fixed;top:max(12px,env(safe-area-inset-top));right:12px;z-index:2;width:44px;height:44px;display:grid;place-items:center;border:0;border-radius:50%;background:rgba(13,15,23,.86);color:#F2F1EC;box-shadow:0 0 0 1px rgba(255,255,255,.18)}
.flowhint{position:fixed;left:50%;transform:translateX(-50%);bottom:max(14px,env(safe-area-inset-bottom));margin:0;padding:9px 14px;border-radius:999px;background:rgba(13,15,23,.86);color:#F2F1EC;font:500 13px/1 var(--sans);white-space:nowrap;pointer-events:none}
/* Desktop prototype: bigger, plus full screen with zoom (Vishal 03:53, as on ixigo) */
.flows button.protofs,.protofsx{display:none}
@media (min-width:901px){
  .tryit{grid-template-columns:minmax(0,1fr) auto}
  .pframe{height:min(860px,calc(100svh - 180px));width:auto;aspect-ratio:340/700}
  .flows button.protofs{display:inline-flex;justify-self:start;min-height:0;box-shadow:none;align-items:center;gap:8px;margin-top:8px;padding:13px 18px;border:0;border-radius:999px;background:#0E1424;color:#fff;font:500 14px/1 var(--sans);cursor:pointer}
  .flows button.protofs:hover{background:#0B57D0;box-shadow:none}
  .flows button.protofs:focus-visible{outline:2px solid #0B57D0;outline-offset:3px}
  .pwrap.fs{position:fixed;inset:0;z-index:1000;margin:0;padding:24px;background:#0D0F17;display:flex;justify-content:center;align-items:center}
  .pwrap.fs .pframe{width:min(1280px,100%);height:calc(100dvh - 48px);aspect-ratio:auto;padding:0;border-radius:16px;background:transparent}
  .pwrap.fs .pembed{border-radius:16px}
  .pwrap.fs .pwait{display:none}
  .pwrap.fs .protofsx{display:grid;place-items:center;position:fixed;top:20px;right:20px;z-index:2;width:44px;height:44px;border:0;border-radius:50%;background:rgba(13,15,23,.86);color:#F2F1EC;box-shadow:0 0 0 1px rgba(255,255,255,.2);cursor:pointer}
  html:has(.pwrap.fs){overflow:hidden}
}
/* Phones: flow chips inside the open prototype, solid backdrop (Vishal 03:53, as on ixigo) */
.livechaps{display:none}
@media (max-width:640px){
  .pwrap.live{background:#0D0F17}
  .pwrap.live .livechaps{display:flex;gap:8px;width:100%;overflow-x:auto;scrollbar-width:none;padding:2px 2px 4px;flex:none;scroll-snap-type:x proximity;-webkit-mask-image:linear-gradient(90deg,transparent,#000 16px,#000 calc(100% - 16px),transparent);mask-image:linear-gradient(90deg,transparent,#000 16px,#000 calc(100% - 16px),transparent)}
  .livechaps::-webkit-scrollbar{display:none}
  .livechaps button{all:unset;box-sizing:border-box;flex:none;scroll-snap-align:center;padding:10px 14px;border-radius:999px;background:rgba(242,241,236,.12);color:#F2F1EC;font:500 14px/1 var(--sans);white-space:nowrap;cursor:pointer}
  .livechaps button[aria-pressed="true"]{background:#F2F1EC;color:#0B57D0}
  .pwrap.live .pframe{width:min(100%,calc((100dvh - 170px) * 340 / 700))}
}
/* Prototype frame (Vishal 04:10): the slim iPhone frame used on the other case studies. The Split screens are light, so the frame stays dark. */
.pwrap:not(.fs) .pframe{padding:5px;border-radius:46px;background:#0B0B0B;box-shadow:0 0 0 1.5px #C4C1B9,0 0 0 2.5px #8F8C85,0 24px 50px rgba(11,40,90,.16)}
.pwrap:not(.fs) .pembed{border-radius:41px}
.pwrap:not(.fs) .pwait{inset:5px;border-radius:41px}
.pwrap:not(.fs) .pframe::before{content:"";position:absolute;top:16px;left:50%;width:86px;height:25px;margin-left:-43px;border-radius:99px;background:#0B0B0B;pointer-events:none;z-index:2}
.pwrap:not(.fs):not(.live)::before,.pwrap:not(.fs):not(.live)::after{content:"";position:absolute;width:3px;border-radius:2px;background:#ABA8A0;pointer-events:none}
.pwrap:not(.fs):not(.live)::before{left:-4.5px;top:19%;height:9%}
.pwrap:not(.fs):not(.live)::after{right:-4.5px;top:25%;height:9%}
/* Phones only (Vishal 04:27, same as ixigo): hero heading bolder at the same size, hook line set tight under it */
@media (max-width:640px){header.hero h1{font-weight:700}header.hero .hook{line-height:1.2}}
/* Phones (Vishal 04:31): project details as one row each, label left and value right, instead of three squeezed columns */
@media (max-width:620px){
  .wrap>.facts{grid-template-columns:minmax(0,1fr);gap:0;padding-block:4px}
  .wrap>.facts div{grid-template-columns:72px minmax(0,1fr);gap:16px;align-items:baseline;padding-block:14px}
  .wrap>.facts div+div{border-top:1px solid var(--line)}
}
/* Flow 1 starts a new band (white after the pale blue flow map), so it gets its own top space instead of the merged 0 (Vishal 04:40) */
article>section#flow{padding-top:clamp(64px,8vw,120px)}
/* Full screen opens in this tab everywhere; tall phone screens open at a readable width and scroll (Vishal 04:41) */
.flowdlg.tall .flowpan{place-items:start center}
.flowdlg.tall .flowpan img{width:min(480px,100%)}
.flowdlg.tall.zoom .flowpan img{width:min(960px,200%)}
</style>
<script is:inline>(()=>{const d=document.querySelector('.flowdlg'),b=document.querySelector('.flowfs');if(!d||!b)return;const pan=d.querySelector('.flowpan'),a=b.previousElementSibling;
const open=e=>{if(e)e.preventDefault();d.classList.remove('zoom');d.showModal();document.documentElement.style.overflow='hidden'};
const di=pan.querySelector('img'),hint=d.querySelector('.flowhint'),fine=matchMedia('(hover:hover) and (pointer:fine)').matches;
const show=(src,alt,w,h)=>{di.src=src;di.alt=alt;di.width=w;di.height=h;d.classList.toggle('tall',h>w*1.3);hint.textContent=fine?'Double click to zoom, Esc to close':'Pinch or double tap to zoom'};
b.onclick=()=>{show(a.getAttribute('href'),a.querySelector('img').alt,5000,3722);open()};
/* Every Full screen on the page opens here, in this tab, on desktop and phones (Vishal 04:41) */
document.querySelectorAll('a.zoom').forEach(z=>{z.removeAttribute('target');z.addEventListener('click',e=>{const i=z.querySelector('img');show(z.getAttribute('href'),i.alt,+i.getAttribute('width'),+i.getAttribute('height'));open(e)})});
d.addEventListener('close',()=>{document.documentElement.style.overflow=''});d.querySelector('.flowx').onclick=()=>d.close();
let t=0;pan.addEventListener('click',e=>{const n=Date.now();if(n-t<320){const r=pan.getBoundingClientRect(),fx=(e.clientX-r.left+pan.scrollLeft)/pan.scrollWidth,fy=(e.clientY-r.top+pan.scrollTop)/pan.scrollHeight;d.classList.toggle('zoom');pan.scrollLeft=fx*pan.scrollWidth-r.width/2;pan.scrollTop=fy*pan.scrollHeight-r.height/2;t=0}else t=n});
pan.addEventListener('dblclick',e=>e.preventDefault())})();</script>
</html>
