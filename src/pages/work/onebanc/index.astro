.sintro>p:not(.eyebrow){max-width:60ch}
.scr .screen>div.scol{position:static}
@media (min-width:901px){.scr .screen>div.scol{position:sticky;top:80px}}
/* blocks 1 to 4 appear one after another as the screen beside them scrolls */
html.steps .scr .blk{opacity:.0;transform:translateY(14px);transition:opacity .35s ease,transform .35s ease}
html.steps .scr .blk.on{opacity:1;transform:none}
/* the left titles no longer slide down while their section scrolls; the text beside them is short */
@media (min-width:1100px){article>section:not(.wide)>.lhead{position:static}}
/* wide sections: eyebrow and title left, paragraph right, like Split */
@media (min-width:1000px){
  article>section.wide:not(.scr)>div:first-child{max-width:none!important;grid-template-columns:minmax(0,5fr) minmax(0,7fr);column-gap:clamp(48px,6vw,120px);row-gap:16px;grid-auto-flow:row dense;align-items:start}
  article>section.wide:not(.scr)>div:first-child>.eyebrow{grid-column:1;grid-row:1}
  article>section.wide:not(.scr)>div:first-child>h2{grid-column:1;grid-row:2}
  article>section.wide:not(.scr)>div:first-child>p:nth-of-type(2),article>section.wide:not(.scr)>div:first-child>.pcol{grid-row:1/span 2}
  article>section.wide:not(.scr)>div:first-child>.pcol{grid-column:2}
  article>section.wide:not(.scr)>div:first-child>p:not(.eyebrow){grid-column:2}
  article>section.wide:not(.scr)>div:first-child>p:not(.eyebrow):nth-of-type(2){margin-top:30px}
}
.foundline{max-width:none}
.pcol{display:grid;gap:22px}
/* Vishal 2026-10-19: on phones Screens 1 to 3 had too much text; each point keeps its label and headline, the paragraph is hidden */
/* the font samples load Satoshi and Switzer from Fontshare, which run wider than the fallback; on phones they pushed the page wider than the screen (Vishal 2026-10-19). Smaller sample on phones so all four fit */
@media (max-width:620px){.fonts div{padding:16px}.fonts b{font-size:19px;white-space:nowrap;overflow:hidden;text-overflow:clip}}
@media (max-width:620px){.scr .blk>p{display:none}.scr .blks{gap:20px}.scr .blk{gap:6px}}
/* arc: the nav bar stays on the frame's bottom edge while the screen scrolls under it, as on Reward Centre */
.iph>.navfix{position:absolute;left:5px;right:5px;bottom:5px;background-repeat:no-repeat;background-size:100% auto;background-position:bottom;border-radius:0 0 41px 41px;pointer-events:none}
.iph:has(.navfix)>.fsb{bottom:auto;top:20px;right:20px}
/* Vishal 2026-10-19: the Full screen icon sat on the phone's status bar; it now sits just above the frame's top right corner */
.arc3 .iph:has(.navfix)>.fsb{top:-44px;right:0}
@media (min-width:621px){.arc3{margin-top:72px}}
/* top of the page: a little more room around the concept line */
.wrap>p.note{margin-top:28px;max-width:none}
.wrap>.summary{margin-top:56px}

/* Vishal 2026-10-19 (all case studies): the concept line under the facts opens with a small label, not body text */
.note .nlab{display:inline-flex;align-items:center;vertical-align:1px;margin-right:12px;padding:4px 10px;border:1px solid currentColor;border-radius:999px;font-size:11px;line-height:1;font-weight:600;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}
</style>
<script is:inline>
/* Vishal 2026-10-19: on desktop the four blocks beside each long screen appear 1, 2, 3, 4 as the screen scrolls */
(()=>{if(!matchMedia('(min-width:901px)').matches||matchMedia('(prefers-reduced-motion:reduce)').matches||document.documentElement.classList.contains('calm'))return;
const rows=[...document.querySelectorAll('.scr .screen')].map(sc=>({f:sc.querySelector('figure'),b:[...sc.querySelectorAll('.blk')]})).filter(r=>r.f&&r.b.length);
if(!rows.length)return;document.documentElement.classList.add('steps');
const u=()=>{const h=innerHeight;rows.forEach(r=>{const g=r.f.getBoundingClientRect(),span=Math.max(240,g.height-h+200),t=Math.min(1,Math.max(0,(200-g.top)/span));const n=Math.max(1,Math.ceil(t*r.b.length+.001));r.b.forEach((b,i)=>b.classList.toggle('on',i<n))})};
addEventListener('scroll',u,{passive:true});addEventListener('resize',u);u()})();
</script>

<style is:inline>
/* Universal (Vishal 19 Oct 13:09): project names in the footer are never white; a light tint of the page colour, like OneBanc */
.endsec .nextgrid b{color:#F3DFB2!important}
</style>
