  .dks button{position:relative}
  .dks button::after{content:attr(data-name);position:absolute;left:50%;bottom:calc(100% + 29px);transform:translate(-50%,4px);white-space:nowrap;padding:8px 12px;border-radius:10px;background:#F2F1EC;color:#0F3C1F;font:600 13px/1 var(--sans);box-shadow:0 8px 24px rgba(0,0,0,.3);opacity:0;pointer-events:none;transition:opacity .15s ease,transform .15s ease}
