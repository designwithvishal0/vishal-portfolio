---
import '@fontsource-variable/hanken-grotesk';
import '../styles/components.css';
import Boot from '../components/Boot.astro';
import { intro, work } from '../data/home';

// Approved home copy, Phase 1 doc. Layout is direction B2 on the design system.
const title = 'Vishal Yadav, Product Designer in Gurugram';
const description = 'Vishal Yadav is a product (UI/UX) designer in Gurugram. Case studies in travel, fintech, ecommerce and B2B, plus shipped campaign work for CashKaro.';

// Preview: case studies still live on the Framer site until each one moves here.
const live = (slug: string) => `https://designwvishal.framer.website/work/${slug}`;
const behance = (id: string) => `https://www.behance.net/gallery/${id}`;
const email = 'design.vishaly@gmail.com';
const social = [
  ['LinkedIn', 'https://www.linkedin.com/in/vishaldesigns'],
  ['Behance', 'https://www.behance.net/design_vishaly'],
  ['X', 'https://x.com/design_vishaly'],
  ['Instagram', 'https://www.instagram.com/vishal.y0109'],
];

const sizes = ['wide', 'half', 'half', 'wide'];
const loops = ['ixigo', 'split', 'twelve', 'jarvis'];
const results = [
  { n: 60, label: 'conversion lift on critical flows' },
  { n: 50, label: 'click through lift on landing pages, after I rebuilt them from Hotjar and Clarity recordings' },
  { n: 30, label: 'faster campaign turnaround, from the Figma design system I built' },
];
const pages = [
  { img: 'pwl', name: 'Profit Wala Love, CashKaro', tag: 'Shipped, 2026', line: "Valentine's campaign across app, web and social.", stats: [['1,542', 'transactions'], ['₹9.89 lakh', 'GMV'], ['13,707', 'shares']] },
  { img: 'bbb', name: 'Big Birthday Bash, EarnKaro', tag: 'Shipped, July 2026', line: 'A week long campaign landing page plus the 777 Jackpot game, one deal a day.', href: behance('256577531') },
  { img: 'basil', name: 'Basil product page', tag: 'Concept', line: 'Sell the set, not the second product.', href: behance('256493837') },
  { img: 'pdp', name: 'Beauty product page', tag: 'Concept', line: 'Will this shade match me?', href: behance('256556067') },
  { img: 'cosiq', name: 'CosIQ landing page', line: 'Build your own routine.', href: behance('230420275') },
];
const how = [
  { h: 'Start where people drop off', p: 'I read the recordings and the reviews before I draw anything. At CashKaro that meant hours of Hotjar and Clarity sessions, and the landing pages I rebuilt from them got 50% more clicks.', link: 'About me', href: '#about' },
  { h: 'Design the uncertain moment', p: "The waitlist before the chart. The request nobody has paid. The alert at 3 AM. That's where people give up, so that's where I spend the work.", link: 'ixigo Trains', href: live('ixigo-trains') },
  { h: 'Honest copy over comforting copy', p: "If the odds are 70%, the screen says 70%. A promise the product can't keep costs more trust than saying nothing.", link: 'Twelve', href: live('twelve') },
];
const jobs = [
  ['CashKaro', 'UI/UX and Graphic Designer', '2023 to 2026'],
  ['Fabulous Media', 'Graphic Designer', '2022 to 2023'],
  ['EKarma India', 'UI/UX Design Trainee', '2021 to 2022'],
];
const words = intro.positioning.split(' ');

const person = {
  '@context': 'https://schema.org', '@type': 'Person', name: 'Vishal Yadav', jobTitle: 'Product Designer',
  description, email: `mailto:${email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Gurugram', addressCountry: 'IN' },
  alumniOf: 'Guru Jambheshwar University of Science and Technology',
  sameAs: social.map(s => s[1]),
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="color-scheme" content="light dark" />
<meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" />
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" set:html={JSON.stringify(person)} />
<Boot />
</head>
<body>
<div class="wrap">
  <header class="top">
    <h1>{intro.name}</h1>
    <span class="status"><span class="dot" aria-hidden="true"></span>{intro.availability}</span>
  </header>

  <main>
  <section class="hero">
    <p class="pos words" aria-label={intro.positioning}>{words.map((w, i) => <><span class="w" aria-hidden="true"><span style={`--i:${i}`}>{w}</span></span>{i < words.length - 1 && ' '}</>)}</p>
    <p class="sup enter" style="animation-delay:260ms">{intro.supporting}</p>
    <ul class="aud enter" style="animation-delay:320ms" aria-label="Start here">
      <li><a class="ul" href="#work">Hiring a product designer</a> <span>See the case studies</span></li>
      <li><a class="ul" href="#results">Recruiting</a> <span>The 30 second version</span></li>
      <li><a class="ul" href="#pages">Founder</a> <span>Need a page that sells</span></li>
    </ul>
    <div class="cta enter" style="animation-delay:380ms">
      <a class="btn primary" href={intro.links[1].href}><span class="roll" data-t={intro.links[1].label}><span>{intro.links[1].label}</span></span></a>
      <a class="btn" href={intro.links[0].href}><span class="roll" data-t={intro.links[0].label}><span>{intro.links[0].label}</span></span></a>
    </div>
  </section>

  <section class="results" id="results" aria-labelledby="r-h">
    <h2 id="r-h">Shipped at CashKaro, for 25M+ users</h2>
    <div class="r-grid">
      {results.map(r => <div><div class="r-num" data-n={r.n}>{r.n}%</div><div class="r-label">{r.label}</div></div>)}
    </div>
  </section>

  <div class="sec-head" id="work"><h2>Selected work</h2><span>4 case studies</span></div>
  <section class="work" aria-label="Selected work">
    {work.map((w, i) => (
      <a class={`tile reveal ${sizes[i]}`} href={live(w.slug)}>
        <div class="meta"><span class="pill">{w.type.includes('B2B') ? 'B2B concept' : 'Concept'}</span><span>{w.year}</span><span>{w.role}</span></div>
        <div class="media">
          <img src={`/loops/${loops[i]}.jpg`} alt={w.alt} width="1200" height="900" loading={i ? 'lazy' : 'eager'} decoding="async" />
          <video muted loop playsinline preload="none" poster={`/loops/${loops[i]}.jpg`} aria-hidden="true" tabindex="-1"><source src={`/loops/${loops[i]}.webm`} type="video/webm" /><source src={`/loops/${loops[i]}.mp4`} type="video/mp4" /></video>
          <span class="play" aria-hidden="true">{w.detail}</span>
        </div>
        <h3>{w.headline}</h3>
        <p>{w.problem}</p>
        <span class="more">View the case study</span>
      </a>
    ))}
  </section>
  <p class="morework reveal">More work: <a class="ul" href={behance('256413187')}>Unified Reward Centre · Every reward. One place.</a> <a class="ul" href={live('onebanc')}>OneBanc · A month, not a balance.</a></p>

  <div class="sec-head" id="pages"><h2>Pages that sell</h2><span>Campaigns, landing pages and product pages for commerce brands.</span></div>
  <section class="pages" aria-label="Pages that sell">
    {pages.map((p, i) => {
      const Tag = p.href ? 'a' : 'div';
      return (
        <Tag class={`page reveal${i ? '' : ' lead'}`} href={p.href}>
          <div class="thumb"><img src={`/pages/${p.img}.webp`} alt={`${p.name}, preview`} width="960" height="1004" loading="lazy" decoding="async" /></div>
          <div class="ptext">
            {p.tag && <span class="pill">{p.tag}</span>}
            <h3>{p.name}</h3>
            <p>{p.line}</p>
            {p.stats && <dl class="pstats">{p.stats.map(([n, l]) => <div><dt>{l}</dt><dd>{n}</dd></div>)}</dl>}
            {p.href && <span class="more">View on Behance</span>}
          </div>
        </Tag>
      );
    })}
  </section>
  <p class="freelance reveal">Need a page that sells? <a class="ul" href="#contact">See how I work with founders</a></p>

  <div class="sec-head"><h2>How I work</h2></div>
  <section class="how" aria-label="How I work">
    {how.map(x => <div class="reveal"><h3>{x.h}</h3><p>{x.p}</p><a class="ul" href={x.href}>{x.link}</a></div>)}
  </section>

  <div class="sec-head" id="about"><h2>About</h2></div>
  <section class="about reveal" aria-label="About">
    <p class="lead-p">From October 2023 to August 2026 I designed app and web flows at CashKaro, India's largest cashback platform, and built the Figma design system its campaigns run on. Before that I was a graphic designer at an agency, which is why what I ship looks finished (that work lives in the archive). I studied Computer Science, so I know what engineers need at handoff, and I use AI to move faster through research and iteration while the design calls stay mine.</p>
    <dl class="jobs">{jobs.map(([c, r, y]) => <div><dt>{c}</dt><dd>{r}</dd><dd class="y">{y}</dd></div>)}</dl>
  </section>

  <section class="contact reveal" id="contact" aria-labelledby="c-h">
    <h2 id="c-h">Hiring, or need a page that sells?</h2>
    <p>Email me at <button class="copy" type="button" data-copy={email}>{email} <span class="tag" aria-live="polite">Copy</span></button> or book a call. I reply within a day.</p>
    <div class="cta">
      <a class="btn primary" href="https://cal.com/designwvishal"><span class="roll" data-t="Book a call"><span>Book a call</span></span></a>
      <a class="btn" href={`mailto:${email}`}><span class="roll" data-t="Email"><span>Email</span></span></a>
    </div>
  </section>
  </main>

  <footer>
    <nav aria-label="Elsewhere" class="social">{social.map(([l, h]) => <a class="ul" href={h}>{l}</a>)}</nav>
    <span class="toggles"><button id="theme" type="button">Dark mode</button><button id="calm" type="button" aria-pressed="false">Reduce motion</button></span>
  </footer>
</div>
<script>import '../scripts/ui';</script>
</body>
</html>

<style>
  .morework{margin:-80px 0 128px;color:var(--muted);display:flex;flex-wrap:wrap;gap:8px 24px}
  .morework a{color:var(--ink);font-weight:var(--w-strong)}
  .pages{display:grid;grid-template-columns:repeat(3,1fr);gap:56px 32px}
  .page{display:block;text-decoration:none}
  .page.lead{grid-column:span 2;display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start}
  .thumb{background:var(--card);border-radius:var(--r-card);overflow:hidden;aspect-ratio:1;border:1px solid transparent;transition:border-color var(--hover) var(--ease-out)}
  .thumb img{width:100%;height:100%;object-fit:cover;object-position:50% 0;display:block;transition:transform var(--section) var(--ease-out)}
  .ptext{padding-top:18px}
  .page.lead .ptext{padding-top:0}
  .ptext .pill{font-size:var(--fs-meta);color:var(--ink)}
  .ptext h3{font-size:var(--fs-ui);font-weight:var(--w-strong);color:var(--muted);margin:12px 0 4px}
  .ptext p{margin:0;font-size:var(--fs-sup);font-weight:var(--w-head);line-height:var(--lh-head);letter-spacing:var(--track-head)}
  .page.lead .ptext p{font-size:var(--fs-h3)}
  .pstats{display:grid;gap:16px;margin:28px 0 0;padding:20px 0 0;border-top:1px solid var(--rule)}
  .pstats dt{font-size:var(--fs-meta);color:var(--muted);order:2}
  .pstats div{display:flex;flex-direction:column}
  .pstats dd{margin:0;font-size:var(--fs-h3);font-weight:var(--w-head);letter-spacing:var(--track-stat);font-variant-numeric:tabular-nums}
  .page .more{display:inline-block;margin-top:12px;font-weight:var(--w-strong);font-size:var(--fs-meta)}
  @media (hover:hover) and (pointer:fine){a.page:hover .thumb{border-color:var(--ink)}a.page:hover .thumb img{transform:scale(1.03)}}
  @media (max-width:900px){.pages{grid-template-columns:1fr 1fr}.page.lead{grid-column:1/-1}}
  @media (max-width:560px){.pages{grid-template-columns:1fr}.page.lead{grid-template-columns:1fr;gap:0}.page.lead .ptext{padding-top:18px}}
  .freelance{margin:72px 0 128px;font-size:var(--fs-sup)}
  .freelance a{font-weight:var(--w-strong)}
  .how{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;padding:0 0 128px}
  .how h3{font-size:var(--fs-sup);font-weight:var(--w-head);margin:0 0 12px;letter-spacing:var(--track-head)}
  .how p{margin:0 0 16px;color:var(--muted)}
  .how a{font-weight:var(--w-strong);font-size:var(--fs-ui)}
  @media (max-width:760px){.how{grid-template-columns:1fr;gap:40px}}
  .about{display:grid;grid-template-columns:1.4fr 1fr;gap:56px;padding:0 0 128px}
  .lead-p{font-size:var(--fs-lead);margin:0;max-width:var(--measure)}
  .jobs{margin:0;display:grid;gap:20px;align-content:start}
  .jobs div{padding-top:16px;border-top:1px solid var(--rule)}
  .jobs dt{font-weight:var(--w-strong)}
  .jobs dd{margin:0;color:var(--muted)}
  @media (max-width:760px){.about{grid-template-columns:1fr;gap:40px}}
  .contact{border-top:1px solid var(--rule);padding:72px 0 128px}
  .contact h2{font-size:var(--fs-h1);line-height:1.02;letter-spacing:-.035em;font-weight:var(--w-head);margin:0 0 24px;max-width:16ch}
  .contact p{font-size:var(--fs-sup);margin:0 0 32px;max-width:52ch}
  .social{display:flex;flex-wrap:wrap;gap:8px 20px}
  .social a{color:var(--ink)}
  footer{flex-wrap:wrap;align-items:center}
  .toggles{display:flex;gap:var(--s2);flex-wrap:wrap}
  footer button{white-space:nowrap}
</style>
