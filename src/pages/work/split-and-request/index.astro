    sb.onclick=()=>{chose=true;v.muted=!v.muted;if(!v.muted&&v.paused)v.play()};
    // Sound on by default: browsers only allow sound after a tap or key press, so autoplay starts muted and the first tap anywhere turns sound on
    const wake=e=>{if(!chose&&!(e.target.closest&&e.target.closest('.reel .pill'))){v.muted=false;if(e.target!==v)blocked=false}removeEventListener('pointerdown',wake,true);removeEventListener('keydown',wake,true)};
    addEventListener('pointerdown',wake,true);addEventListener('keydown',wake,true);
    ['play','pause','volumechange'].forEach(e=>v.addEventListener(e,paint));
    if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&!document.documentElement.classList.contains('calm')){v.muted=false;v.play().catch(e=>{if(e.name==='NotAllowedError'){blocked=true;v.muted=true;v.play().catch(()=>{})}})}paint();
  })()</script>

  <section class="summary" aria-labelledby="sum">
    <h2 id="sum">The 30 second version</h2>
    <div><span class="k">Problem</span><p>Google Pay opens only when money has to move. A nicer split screen improves that moment but never creates a second one, and retention needs a second moment.</p></div>
    <div><span class="k">Decision</span><p>Kill the reminder. The request becomes a board both people see, and social visibility does the reminder’s job.</p></div>
    <div><span class="k">How I would measure it</span><p>Weekly opens that no money request triggered, in the 21 to 30 cohort.</p></div>
    <div><span class="k">What I learned</span><p>The fix for retention was not a new feature but a longer life for one people already use.</p></div>
  </section>

