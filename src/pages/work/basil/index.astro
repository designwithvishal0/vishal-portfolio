   On phones each step keeps its own phone, one swipe row as before. */
.mobstory{margin-top:56px}
.ms-steps{list-style:none;margin:0;padding:0;counter-reset:none}
.ms-steps li{display:grid;gap:10px;align-content:start}
.ms-steps .n{font-size:14px;font-weight:600;letter-spacing:.14em;color:var(--acc)}
.ms-steps h3{font-size:clamp(24px,2.4vw,32px);line-height:1.15;font-weight:600;letter-spacing:-.015em;color:var(--fg);margin:0}
.ms-steps p{font-size:18px;line-height:1.6;color:var(--body);margin:0;max-width:44ch}
@media (min-width:901px){
  .mobstory{display:grid;grid-template-columns:minmax(0,340px) minmax(0,1fr);column-gap:clamp(56px,8vw,140px);align-items:start;max-width:1040px;margin-inline:auto}
  .ms-phone{position:sticky;top:calc(var(--bar) + max(24px,(100vh - var(--bar) - 740px)/2))}
  .ms-phone .sc{position:relative;overflow:hidden}
  .ms-phone .sc img{position:absolute;inset:0 0 auto;width:100%;height:auto;opacity:0;transition:opacity .45s var(--out)}
  .ms-phone .sc img.on{opacity:1}
  .ms-steps li{min-height:78vh;align-content:center;padding-block:40px;opacity:.32;transition:opacity .4s var(--out)}
  .ms-steps li.on{opacity:1}
  .ms-steps li:first-child{min-height:60vh;align-content:start;padding-top:120px}
  .ms-steps li>.iph{display:none}
}
@media (max-width:900px){
  .ms-phone{display:none}
  .ms-steps{display:flex;overflow-x:auto;contain:inline-size;scroll-snap-type:x mandatory;margin-inline:-28px;padding:0 28px 8px;scroll-padding-inline:28px;gap:20px;overscroll-behavior-x:contain;scrollbar-width:none}
  .ms-steps::-webkit-scrollbar{display:none}
