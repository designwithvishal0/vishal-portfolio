          w.querySelector('.pgo').onclick=()=>live(true);w.querySelector('.pdone').onclick=()=>{live(false);w.querySelector('.pgo').focus({preventScroll:true})};addEventListener('keydown',e=>{if(e.key==='Escape'&&w.classList.contains('live'))live(false)});
