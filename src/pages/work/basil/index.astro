<script is:inline>/* Vishal 2026-10-19: phones get the same Read more trim as the other case studies. Basil's text sits in lists and cards, not loose paragraphs, so: long lists show their first two items, cards show their first paragraph. No words are cut */
(function(){
  if(!matchMedia('(max-width:620px)').matches)return;
  function btn(after,open){var b=document.createElement('button');b.type='button';b.className='rmore';b.textContent='Read more';b.setAttribute('aria-expanded','false');b.onclick=function(){open();b.remove()};after.after(b);return b}
  document.querySelectorAll('#audit .finds,#desktop .finds,#lever .options,#lever .beh').forEach(function(list){
    var rest=[].slice.call(list.children,2);if(!rest.length)return;
    rest.forEach(function(e){e.classList.add('rm-hid')});
    btn(list,function(){rest.forEach(function(e){e.classList.remove('rm-hid')})});
  });
  document.querySelectorAll('#rationale .goals>div').forEach(function(card){
    var rest=[].slice.call(card.querySelectorAll(':scope>p'),1);if(!rest.length)return;
    rest.forEach(function(e){e.classList.add('rm-hid')});
