          bs.forEach(o=>{const c=o.cloneNode(true);c.onclick=()=>{o.click();sync();c.scrollIntoView({inline:'center',block:'nearest',behavior:'smooth'})};lc.append(c)});
          const sync=()=>bs.forEach((o,i)=>lc.children[i].setAttribute('aria-pressed',o.getAttribute('aria-pressed')));w.prepend(lc);
