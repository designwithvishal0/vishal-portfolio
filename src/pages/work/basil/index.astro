<script is:inline>
(()=>{
  const box=document.querySelector('.mobstory');if(!box)return;
  const steps=[...box.querySelectorAll('.ms-steps li')],sc=box.querySelector('.ms-phone .sc'),imgs=[...sc.querySelectorAll('img')];
  const wide=matchMedia('(min-width:901px)');let cur=-1;
  const tick=()=>{
    if(!wide.matches)return;
    const mid=innerHeight/2;let i=0;
    steps.forEach((li,k)=>{if(li.getBoundingClientRect().top<mid)i=k});
    if(i!==cur){cur=i;steps.forEach((li,k)=>li.classList.toggle('on',k===i));imgs.forEach((im,k)=>im.classList.toggle('on',k===i))}
    // the page scroll runs the active screen from top to bottom while its step crosses the middle of the window
    const r=steps[i].getBoundingClientRect(),img=imgs[i];
    const p=Math.min(1,Math.max(0,(mid-r.top)/r.height));
    const room=Math.max(0,img.offsetHeight-sc.clientHeight);
    img.style.transform=`translateY(${-p*room}px)`;
  };
  addEventListener('scroll',()=>requestAnimationFrame(tick),{passive:true});addEventListener('resize',tick);wide.addEventListener('change',tick);tick();
})();
</script>
