/* Vishal 2026-10-14 02:14: on desktop the flows sit in one list on the left and the prototype phone on the right, as on Framer */
#try .trygrid,#try .trytext{display:grid;gap:22px;min-width:0}
@media (max-width:900px){#try .trytext{display:contents}#try .protolink{order:1}}
@media (min-width:901px){
  #try .trygrid{grid-template-columns:minmax(0,560px) auto;justify-content:center;column-gap:clamp(64px,9vw,140px);align-items:center}
