#claim .tw{background:#062219;--acc:#CDE86F}
#claim .tw .say{color:#F2EFE4}
#claim .tw em{font-style:normal;box-shadow:inset 0 -.12em 0 #CDE86F}
#claim .say{font-size:clamp(28px,3.4vw,40px);line-height:1.15}
