.dock{display:none}
.dockfade{display:none}
@media (min-width:1280px){
  .tocpill{display:none!important}
  .dock{display:flex;position:fixed;left:50%;bottom:24px;z-index:20;align-items:center;gap:14px;padding:10px 12px;border-radius:16px;background:rgba(8,16,38,.88);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);box-shadow:0 0 0 1px rgba(255,255,255,.1),0 16px 40px rgba(0,0,0,.3);font:600 14px/1 var(--sans);color:#F2F1EC;opacity:0;visibility:hidden;transform:translate(-50%,16px);transition:opacity .3s ease,transform .3s ease,visibility .3s}
  .dock.show{opacity:1;visibility:visible;transform:translate(-50%,0)}
  /* audit 2026-10-13: text slides under a soft fade of the section colour instead of colliding with the dock */
  .dockfade{display:block;position:fixed;left:0;right:0;bottom:0;height:104px;z-index:19;pointer-events:none;background:linear-gradient(to bottom,transparent,var(--fade,#0C1631) 78%);opacity:0;transition:opacity .3s ease}
  .dock.show~.dockfade,.dockfade.show{opacity:1}
  /* Vishal 2026-10-13: the contents bar stays on screen while scrolling down too, so first time readers see it */
  .dkb{all:unset;cursor:pointer;width:36px;height:36px;border-radius:10px;display:grid;place-items:center;background:rgba(255,255,255,.07);transition:background .2s}
  .dkb:hover{background:rgba(255,255,255,.14)}.dkb:disabled{opacity:.35;cursor:default}
  .dkb:focus-visible,.dkn:focus-visible,.dks button:focus-visible{outline:2px solid #E9A23B;outline-offset:2px}
  .dkm{display:flex;flex-direction:column;gap:9px;width:420px}
  .dkt{display:flex;justify-content:space-between;gap:12px}.dkt i{font-style:normal;color:#8F9BB8;font-variant-numeric:tabular-nums}
  .dks{display:flex;gap:4px}
  .dks button{all:unset;cursor:pointer;flex:1;height:14px;display:flex;align-items:center}
  .dks button::before{content:"";flex:1;height:4px;border-radius:2px;background:linear-gradient(90deg,#E9A23B var(--f,0%),rgba(242,241,236,.18) var(--f,0%))}
  .dks button:hover::before{background:linear-gradient(90deg,#E9A23B var(--f,0%),rgba(242,241,236,.36) var(--f,0%))}
  .dkn{display:flex;flex-direction:column;gap:4px;min-width:118px;padding-left:14px;border-left:1px solid rgba(255,255,255,.12);color:#F2F1EC;text-decoration:none}
  .dkn small{font-size:10px;letter-spacing:.12em;color:#8F9BB8}
  .dkn.end{visibility:hidden}
  /* hover a segment to see which section it is (Vishal 2026-10-13) */
  .dks button{position:relative}
  .dks button::after{content:attr(data-name);position:absolute;left:50%;bottom:calc(100% + 34px);transform:translate(-50%,4px);white-space:nowrap;padding:8px 12px;border-radius:10px;background:#F2F1EC;color:#0E1424;font:600 13px/1 var(--sans);box-shadow:0 8px 24px rgba(0,0,0,.3);opacity:0;pointer-events:none;transition:opacity .15s ease,transform .15s ease}
  .dks button:hover::after,.dks button:focus-visible::after{opacity:1;transform:translate(-50%,0)}
}
html.calm nav.toc,html.calm .tocpill,html.calm .tocpill::after,html.calm .dock{transition:none}
</style>
<script is:inline>
(function(){
  var rail=document.querySelector('nav.toc'), pill=document.querySelector('.tocpill'), sheet=document.getElementById('tocsheet'), art=document.querySelector('article');
  var links=[].slice.call(rail.querySelectorAll('a')), secs=links.map(function(a){return document.querySelector(a.getAttribute('href'))});
  var items=links.map(function(a,i){var b=document.createElement('a');b.href=a.getAttribute('href');b.innerHTML='<span>'+String(i+1).padStart(2,'0')+'</span>'+a.textContent;b.onclick=function(){sheet.hidePopover()};sheet.appendChild(b);return b});
  var last=-1;
  function tick(){
    var r=art.getBoundingClientRect(), on=secs[0].getBoundingClientRect().top<innerHeight*.3&&r.bottom>innerHeight*.4;
    rail.classList.toggle('show',on);pill.classList.toggle('show',on);
    var hd=document.querySelector('header.bar');if(hd&&!document.documentElement.classList.contains('hdr-hide')&&!hd.style.transform){var hb=hd.getBoundingClientRect().bottom;if(hb>20)document.documentElement.style.setProperty('--hb',hb+'px')}
    rail.style.setProperty('--p',Math.min(100,Math.max(0,(-r.top+innerHeight*.3)/(r.height)*100))+'%');
    pill.style.setProperty('--p',Math.min(100,Math.max(0,(-r.top+innerHeight*.3)/(r.height)*100))+'%');
    var cur=0;secs.forEach(function(s,i){if(s&&s.getBoundingClientRect().top<innerHeight*.35)cur=i});
    if(cur!==last){last=cur;links.forEach(function(a,i){a.classList.toggle('on',i===cur)});items.forEach(function(a,i){a.classList.toggle('on',i===cur)});
      pill.querySelector('b').textContent=links[cur].textContent;pill.querySelector('i').textContent=(cur+1)+' / '+links.length;}
    var mid=null;secs.forEach(function(s){if(s){var b=s.getBoundingClientRect();if(b.top<=innerHeight/2&&b.bottom>innerHeight/2)mid=s}});
    rail.classList.toggle('light',!!(mid&&mid.classList.contains('lt')));
  }
  // Desktop dock
  var dock=document.querySelector('.dock'),fade=document.querySelector('.dockfade'),bands=[].slice.call(document.querySelectorAll('article>section')),segs=links.map(function(a,i){var b=document.createElement('button');b.type='button';b.setAttribute('aria-label',(i+1)+'. '+a.textContent);b.dataset.name=a.textContent;b.onclick=function(){go(i)};dock.querySelector('.dks').appendChild(b);return b}),
      dn=dock.querySelector('.dkn'),pv=dock.querySelector('[data-go="-1"]'),nx=dock.querySelector('[data-go="1"]'),dc=0;
  function go(i){i=Math.max(0,Math.min(secs.length-1,i));secs[i].scrollIntoView({behavior:document.documentElement.classList.contains('calm')||matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'})}
  pv.onclick=function(){go(dc-1)};nx.onclick=function(){go(dc+1)};dn.onclick=function(e){e.preventDefault();go(dc+1)};
  function dtick(){
    var r=art.getBoundingClientRect(),y=innerHeight*.35,shown=secs[0].getBoundingClientRect().top<innerHeight*.3&&r.bottom>innerHeight*.6;dock.classList.toggle('show',shown);fade.classList.toggle('show',shown);
    if(shown){var yb=innerHeight-8,c='';bands.forEach(function(s){var q=s.getBoundingClientRect();if(q.top<=yb&&q.bottom>yb)c=getComputedStyle(s).getPropertyValue('--band').trim()});if(c)fade.style.setProperty('--fade',c)}
    dc=0;secs.forEach(function(s,i){if(s.getBoundingClientRect().top<y)dc=i});
    segs.forEach(function(b,i){var f=i<dc?100:i>dc?0:(function(){var t=secs[i].getBoundingClientRect(),e=i<secs.length-1?secs[i+1].getBoundingClientRect().top:r.bottom;return Math.max(0,Math.min(100,(y-t.top)/(e-t.top)*100))})();b.style.setProperty('--f',f+'%');b.toggleAttribute('aria-current',i===dc)});
    dock.querySelector('.dkt b').textContent=links[dc].textContent;dock.querySelector('.dkt i').textContent=(dc+1)+' / '+links.length;
    var n=links[dc+1];dn.classList.toggle('end',!n);if(n){dn.href=n.getAttribute('href');dn.querySelector('span').textContent=n.textContent}
    pv.disabled=dc===0;nx.disabled=dc===links.length-1;
  }
  addEventListener('scroll',dtick,{passive:true});addEventListener('resize',dtick);dtick();
  addEventListener('scroll',tick,{passive:true});addEventListener('resize',tick);tick();
})();
</script>
<script is:inline>
(function(){
  var mq=matchMedia('(max-width:759px)'),root=document.documentElement,last=scrollY,hd=document.querySelector('header.bar');
  addEventListener('scroll',function(){
    var y=scrollY,d=y-last;
    if(!mq.matches||y<120||(hd&&hd.contains(document.activeElement))){root.classList.remove('hdr-hide');last=y;return}
    if(d>6){root.classList.add('hdr-hide');last=y}else if(d<-6){root.classList.remove('hdr-hide');last=y}
  },{passive:true});
})();
</script>
<script is:inline>
(function(){
  if(!matchMedia('(max-width:620px)').matches)return;
  function btn(before,open){var b=document.createElement('button');b.type='button';b.className='rmore';b.textContent='Read more';b.setAttribute('aria-expanded','false');b.onclick=function(){open();b.remove()};before.parentNode.insertBefore(b,before);return b}
  // Section body: keep the first paragraph, fold the rest of the paragraphs and quotes
  document.querySelectorAll('article>section').forEach(function(sec){
    var body=[].filter.call(sec.children,function(e){return (e.tagName==='P'&&!e.classList.contains('eyebrow'))||e.tagName==='BLOCKQUOTE'});
    var rest=body.slice(1), words=rest.reduce(function(n,e){return n+e.textContent.split(/\s+/).length},0);
    if(!rest.length||words<30)return;
    rest.forEach(function(e){e.classList.add('rm-hid')});
    btn(rest[0],function(){rest.forEach(function(e){e.classList.remove('rm-hid')})});
  });
  // Long single paragraphs beside the screens: show four lines, then Read more
  document.querySelectorAll('.screen>div>p').forEach(function(p){
    p.classList.add('rm-clamp');if(p.scrollHeight<=p.clientHeight+2){p.classList.remove('rm-clamp');return}
    var b=btn(p,function(){p.classList.remove('rm-clamp')});p.after(b);
  });
})();
</script>
