.flowhint{position:fixed;left:50%;transform:translateX(-50%);bottom:max(14px,env(safe-area-inset-bottom));margin:0;padding:9px 14px;border-radius:999px;background:rgba(13,15,23,.86);color:#F2F1EC;font:500 13px/1 var(--sans);white-space:nowrap;pointer-events:none}
</style>
<script is:inline>(()=>{const d=document.querySelector('.flowdlg');if(!d)return;const pan=d.querySelector('.flowpan'),im=pan.querySelector('img');
document.querySelectorAll('.flowfs').forEach(b=>b.onclick=()=>{const s=b.closest('figure').querySelector('img');im.src=s.currentSrc||s.src;im.alt=s.alt;d.classList.remove('zoom');d.showModal();document.documentElement.style.overflow='hidden'});
d.addEventListener('close',()=>{document.documentElement.style.overflow=''});d.querySelector('.flowx').onclick=()=>d.close();
let t=0;pan.addEventListener('click',e=>{const n=Date.now();if(n-t<320){const r=pan.getBoundingClientRect(),fx=(e.clientX-r.left+pan.scrollLeft)/pan.scrollWidth,fy=(e.clientY-r.top+pan.scrollTop)/pan.scrollHeight;d.classList.toggle('zoom');pan.scrollLeft=fx*pan.scrollWidth-r.width/2;pan.scrollTop=fy*pan.scrollHeight-r.height/2;t=0}else t=n});
pan.addEventListener('dblclick',e=>e.preventDefault())})();</script>
<script is:inline src="/js/pin-screen.js" defer></script>
</html>
