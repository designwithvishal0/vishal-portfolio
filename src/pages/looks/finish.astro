---
import '@fontsource-variable/hanken-grotesk';
import '../../styles/components.css';
import '../../styles/finish.css';
import Boot from '../../components/Boot.astro';
import Arrow from '../../components/Arrow.astro';
import { intro, work, live, email, social, loops, results, more, lead, pages, how, jobs } from '../../data/home';

// Finish: the clean-2 layout and copy, unchanged. Each project sits in a world drawn in its own product's colour
// (ixigo saffron, Google Pay blue, Twelve forest, JARVIS navy) with the real screen rising from the bottom edge.
// Cobalt is his own colour: the hand drawn mark under the first and the last headline, the results, the portrait, the contact.
const sizes = ['wide', 'half', 'half', 'wide'];
const words = intro.positioning.split(' ');
const cwords = 'Hiring, or need a page that sells?'.split(' ');
const ctas = intro.links.filter(l => l.href !== '#').reverse();

// Decorative art behind each loop, one idea per project, drawn in CSS colour tokens so both themes get their own.
// ixigo: a clock face with four hours lit. Google Pay: three people sharing one bill. Twelve: twelve months, one marked.
// JARVIS: an alert pinging out from one corner. No product screens, logos or numbers.
const tick = (k: number) => { const a = (k * 30 - 90) * Math.PI / 180; return [200 + Math.cos(a) * 120, 150 + Math.sin(a) * 120, 200 + Math.cos(a) * (k % 3 ? 111 : 102), 150 + Math.sin(a) * (k % 3 ? 111 : 102)].map(n => n.toFixed(1)); };
const art = [
  `<circle class="ln" cx="200" cy="150" r="120"/><circle class="ln" cx="200" cy="150" r="84"/>${Array.from({ length: 12 }, (_, k) => { const [a, b, c, d] = tick(k); return `<line class="ln" x1="${a}" y1="${b}" x2="${c}" y2="${d}"/>`; }).join('')}<path class="hi" d="M200 30A120 120 0 0 1 303.9 210"/><circle class="dt" cx="303.9" cy="210" r="5"/>`,
  `<circle class="fl" cx="132" cy="128" r="104"/><circle class="ln" cx="132" cy="128" r="104"/><circle class="ln" cx="268" cy="128" r="104"/><circle class="ln" cx="200" cy="232" r="104"/>`,
  `${Array.from({ length: 12 }, (_, k) => `<line class="ln" x1="${(16 + k * 33.45).toFixed(1)}" y1="44" x2="${(16 + k * 33.45).toFixed(1)}" y2="300"/>`).join('')}<line class="hi" x1="317.1" y1="24" x2="317.1" y2="210"/><circle class="dt" cx="317.1" cy="24" r="5"/>`,
  `<path class="fl" d="M108 60L408 60A300 300 0 0 1 320.1 272.1Z"/>${[50, 100, 150, 200, 250, 300, 350].map(r => `<circle class="ln" cx="108" cy="60" r="${r}"/>`).join('')}<circle class="dt" cx="108" cy="60" r="5"/>`,
];
// His one hand drawn mark: a double stroke, drawn under the last word of the first and the last headline.
const mark = `<svg class="scribble" viewBox="0 0 300 30" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" d="M5 19C48 10 118 5 190 6c44 1 78 4 102 9" /><path pathLength="1" style="--k:1" d="M58 27c52-7 118-9 190-4" /></svg>`;
const Art = (i: number) => `<svg class="art" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">${art[i]}</svg>`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Look: Finish, Vishal Yadav</title>
<meta name="robots" content="noindex" />
<meta name="color-scheme" content="light dark" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<Boot />
</head>
<body>
<div class="wrap">
  <header class="top">
    <div class="top-l">
      <h1>{intro.name}</h1>
      <span class="status"><span class="dot" aria-hidden="true"></span>{intro.availability}</span>
    </div>
    <nav class="topnav" aria-label="Sections"><a href="#work">Work</a><a href="#about">About</a><a href="#contact">Contact</a></nav>
    <button id="theme" type="button">Dark mode</button>
  </header>

  <main>
  <section class="hero">
    <p class="pos words"><span class="vh">{intro.positioning}</span>{words.map((w, i) => i < words.length - 1
      ? <><span class="w" aria-hidden="true"><span style={`--i:${i}`}>{w}</span></span>{' '}</>
      : <span class="mk"><span class="w" aria-hidden="true"><span style={`--i:${i}`}>{w}</span></span><Fragment set:html={mark} /></span>)}</p>
    <div class="hero-row">
      <div class="hero-copy">
        <p class="sup enter" style="--d:260ms">{intro.supporting}</p>
        <ul class="aud enter" style="--d:320ms" aria-label="Start here">
          <li><a class="go" href="#work"><strong>Hiring a product designer</strong> <span>See the case studies</span><Arrow /></a></li>
          <li><a class="go" href="#results"><strong>Recruiting</strong> <span>The 30 second version</span><Arrow /></a></li>
          <li><a class="go" href="#pages"><strong>Founder</strong> <span>Need a page that sells</span><Arrow /></a></li>
        </ul>
        <div class="cta enter" style="--d:380ms">
          {ctas.map((l, i) => <a class={`btn${i ? '' : ' primary'}`} href={l.href}>{l.label}</a>)}
        </div>
      </div>
      <figure class={`reel enter w-${loops[0]}`} style="--d:440ms" data-state="paused" data-i="0" aria-label="Previews of the four case studies">
        <div class="stage">
          {work.map((w, i) => (
            <div class={`slide world w-${loops[i]}${i ? '' : ' on'}`}>
              <Fragment set:html={Art(i)} />
              <div class="win">
                <img src={`/loops/${loops[i]}.jpg`} alt="" width="1200" height="900" loading={i ? 'lazy' : 'eager'} fetchpriority={i ? undefined : 'high'} decoding="async" />
                <video muted playsinline preload={i ? 'none' : 'auto'} aria-hidden="true" tabindex="-1"><source src={`/loops/${loops[i]}.mp4`} type="video/mp4" /><source src={`/loops/${loops[i]}.webm`} type="video/webm" /></video>
              </div>
              <a class="mlink" href={live(w.slug)} tabindex="-1" aria-hidden="true"></a>
            </div>
          ))}
          <button class="vctl" type="button" aria-label="Play the previews">
            <svg class="i-pause" viewBox="0 0 14 14" aria-hidden="true"><rect x="2" y="1" width="3.5" height="12" rx="1" /><rect x="8.5" y="1" width="3.5" height="12" rx="1" /></svg>
            <svg class="i-play" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.6v10.8a.8.8 0 0 0 1.2.7l9-5.4a.8.8 0 0 0 0-1.4l-9-5.4A.8.8 0 0 0 3 1.6z" /></svg>
          </button>
        </div>
        <ol class="segs">{work.map((w, i) => <li><button class="seg" type="button" aria-label={`Show ${w.name}`} aria-current={i ? undefined : 'true'}></button></li>)}</ol>
        <figcaption class="caps">
          {work.map((w, i) => (
            <div class={`cap${i ? '' : ' on'}`}>
              <p class="q"><span class="vh">{w.question}</span>{w.question.split(' ').map((x, k) => <><span class="w" aria-hidden="true"><span style={`--i:${k}`}>{x}</span></span>{' '}</>)}</p>
              <a class="rn go" href={live(w.slug)}><strong>{w.name}</strong> <span>View the case study</span><Arrow /></a>
            </div>
          ))}
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="results" id="results" aria-labelledby="r-h">
    <h2 id="r-h">Shipped at CashKaro, for 25M+ users</h2>
    <div class="r-grid">
      {results.map(r => <div><div class="r-stat"><span class="vh">{r.n}</span><span class="r-vis" aria-hidden="true"><span class="r-num" data-n={parseInt(r.n)} data-suf="">{parseInt(r.n)}</span><span class="pct">%</span></span></div><div class="r-label">{r.label}</div></div>)}
    </div>
  </section>

  <div class="sec-head" id="work"><h2>Selected work</h2><span>4 case studies</span></div>
  <section class="work" aria-label="Selected work">
    {work.map((w, i) => (
      <article class={`tile reveal ${sizes[i]} w-${loops[i]}`}>
        <div class="media world" data-state="paused">
          <Fragment set:html={Art(i)} />
          <div class="win">
            <img src={`/loops/${loops[i]}.jpg`} alt={w.alt} width="1200" height="900" loading={i ? 'lazy' : 'eager'} decoding="async" />
            <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"><source src={`/loops/${loops[i]}.mp4`} type="video/mp4" /><source src={`/loops/${loops[i]}.webm`} type="video/webm" /></video>
          </div>
          <a class="mlink" href={live(w.slug)} tabindex="-1" aria-hidden="true"></a>
          <button class="vctl" type="button" data-name={w.name} aria-label={`Play the ${w.name} preview`}>
            <svg class="i-pause" viewBox="0 0 14 14" aria-hidden="true"><rect x="2" y="1" width="3.5" height="12" rx="1" /><rect x="8.5" y="1" width="3.5" height="12" rx="1" /></svg>
            <svg class="i-play" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.6v10.8a.8.8 0 0 0 1.2.7l9-5.4a.8.8 0 0 0 0-1.4l-9-5.4A.8.8 0 0 0 3 1.6z" /></svg>
          </button>
        </div>
        <div class="meta"><span class="pname">{w.name}</span><span class="pill">{w.type.includes('B2B') ? 'B2B concept' : 'Concept'}</span><span>{w.year}</span></div>
        <h3><a href={live(w.slug)}>{w.headline}<span class="vh">, the {w.name} case study</span></a></h3>
        <p>{w.problem}</p>
        <p class="scope"><span>{w.role}</span><span class="proof">{w.detail}</span></p>
        <a class="more" href={live(w.slug)} tabindex="-1" aria-hidden="true">View the case study <Arrow /></a>
      </article>
    ))}
  </section>
  <ul class="morework reveal" aria-label="More work">
    {more.map(m => (
      <li><a class="mw go" href={m.href}>
        <img src={`/pages/${m.img}.webp`} alt="" width="56" height="56" loading="lazy" decoding="async" />
        <span class="mwt"><strong>{m.name}</strong><span>{m.line}</span></span>
        <span class="pill">Concept</span><Arrow />
      </a></li>
    ))}
  </ul>

  <div class="sec-head" id="pages"><h2>Pages that sell</h2><span>Campaigns, landing pages and product pages for commerce brands.</span></div>
  <section class="pages" aria-label="Pages that sell">
    <article class="page lead reveal">
      <div class="thumb"><img src={`/pages/${lead.img}.webp`} alt={`${lead.name}, preview`} width="960" height="1004" loading="lazy" decoding="async" /></div>
      <div class="ptext">
        <span class="ptag"><span class="pill shipped">{lead.tag}</span></span>
        <h3>{lead.name}</h3>
        <p>{lead.line}</p>
        <dl class="pstats">{lead.stats.map(([n, l]) => <div><dt>{l}</dt><dd>{n}</dd></div>)}</dl>
      </div>
    </article>
    <ul class="rail">
      {pages.map(p => (
        <li class="reveal"><a class="page go" href={p.href}>
          <div class="thumb"><img src={`/pages/${p.img}.webp`} alt={`${p.name}, preview`} width="960" height="1004" loading="lazy" decoding="async" /></div>
          <span class="ptag">{p.tag && <span class={`pill${p.tag.startsWith('Shipped') ? ' shipped' : ''}`}>{p.tag}</span>}</span>
          <h3>{p.name}</h3>
          <p>{p.line}</p>
          <span class="more">View on Behance <Arrow /></span>
        </a></li>
      ))}
    </ul>
  </section>
  <p class="freelance reveal">Need a page that sells? <a class="ul" href="#contact">See how I work with founders</a></p>

  <div class="sec-head"><h2>How I work</h2></div>
  <section class="how" aria-label="How I work">
    {how.map((x, i) => <div class={`reveal h-${i}`}><h3>{x.h}</h3><p>{x.p}</p><a class="more go" href={x.href}>{x.link} <Arrow /></a></div>)}
  </section>

  <div class="sec-head" id="about"><h2>About</h2></div>
  <section class="about reveal" aria-label="About">
    <div class="portrait"><div class="ph"><img src="/me/vishal-600.webp" srcset="/me/vishal-600.webp 600w, /me/vishal-1200.webp 1200w" sizes="(min-width: 761px) 240px, 50vw" width="1200" height="1500" alt="Vishal Yadav" loading="lazy" decoding="async" /></div></div>
    <p class="lead-p">From October 2023 to August 2026 I designed app and web flows at CashKaro, India’s largest cashback platform, and built the Figma design system its campaigns run on. Before that I was a graphic designer at an agency, which is why what I ship looks finished (that work lives in <a class="ul" href="https://www.behance.net/design_vishaly">the archive</a>). I studied Computer Science, so I know what engineers need at handoff, and I use AI to move faster through research and iteration while the design calls stay mine.</p>
    <dl class="jobs">{jobs.map(([c, r, y]) => <div><dt>{c}</dt><dd>{r}</dd><dd class="y">{y}</dd></div>)}</dl>
  </section>

  <section class="contact reveal" id="contact" aria-labelledby="c-h">
    <h2 id="c-h"><span class="vh">Hiring, or need a page that sells?</span>{cwords.map((x, k) => k < cwords.length - 1
      ? <><span class="w" aria-hidden="true"><span style={`--i:${k}`}>{x}</span></span>{' '}</>
      : <span class="mk"><span class="w" aria-hidden="true"><span style={`--i:${k}`}>{x}</span></span><Fragment set:html={mark} /></span>)}</h2>
    <div class="c-side">
    <p>Email me at <button class="copy" type="button" data-copy={email}>{email} <span class="tag" aria-hidden="true"><span class="t-copy">Copy</span><span class="t-done">Copied</span></span></button> or book a call. I reply within a day.</p>
    <span class="vh" role="status" id="copied"></span>
    <div class="cta">
      <a class="btn primary" href="https://cal.com/designwvishal">Book a call</a>
      <a class="btn" href={`mailto:${email}`}>Email</a>
    </div>
    <p class="elsewhere">You can also find me on <a class="ul" href={social[0][1]}>LinkedIn</a> and <a class="ul" href={social[1][1]}>Behance</a>.</p>
    </div>
  </section>
  </main>

  <footer>
    <nav aria-label="Elsewhere" class="social">{social.map(([l, h]) => <a class="ul" href={h}>{l}</a>)}</nav>
    <span class="toggles"><button id="calm" type="button" aria-pressed="false">Reduce motion</button></span>
  </footer>
</div>
<script>import '../../scripts/ui';</script>
<script>
  // The hero reel plays the four loops in turn while it is half in view. Each plays once, then hands over,
  // and the surround takes the colour of the project on screen (data-i).
  // Under reduced motion nothing starts on its own; the play button and the bars still work.
  // keyboard focus on a card in the phone rail scrolls that card into place
  document.querySelector('.rail')?.addEventListener('focusin', e => (e.target as HTMLElement).closest('li')?.scrollIntoView({ inline: 'start', block: 'nearest' }));

  const reel = document.querySelector<HTMLElement>('.reel');
  if (reel) {
    const names = ['ixigo', 'split', 'twelve', 'jarvis'];
    const slides = [...reel.querySelectorAll<HTMLElement>('.slide')];
    const caps = [...reel.querySelectorAll<HTMLElement>('.cap')];
    const segs = [...reel.querySelectorAll<HTMLButtonElement>('.seg')];
    const btn = reel.querySelector<HTMLButtonElement>('.vctl')!;
    const vids = slides.map(s => s.querySelector('video')!);
    const osCalm = matchMedia('(prefers-reduced-motion: reduce)');
    const calm = () => osCalm.matches || document.documentElement.classList.contains('calm');
    let i = 0, shown = false, user: boolean | null = null, raf = 0;
    const fill = (k: number, p: number) => segs[k].style.setProperty('--p', String(p));
    const tick = () => { const v = vids[i]; if (v.duration) fill(i, v.currentTime / v.duration); raf = requestAnimationFrame(tick); };
    const sync = () => {
      const run = user === null ? shown && !calm() : user && shown;
      cancelAnimationFrame(raf);
      if (run) { vids[i].play().catch(() => {}); raf = requestAnimationFrame(tick); } else vids[i].pause();
      reel.dataset.state = run ? 'playing' : 'paused';
      btn.setAttribute('aria-label', `${run ? 'Pause' : 'Play'} the previews`);
    };
    const go = (k: number) => {
      vids[i].pause();
      slides[i].classList.remove('on'); caps[i].classList.remove('on'); segs[i].removeAttribute('aria-current');
      reel.classList.replace(`w-${names[i]}`, `w-${names[k]}`);
      i = k;
      reel.dataset.i = String(i);
      vids[i].currentTime = 0;
      vids[(i + 1) % vids.length].preload = 'auto';
      segs.forEach((_, n) => fill(n, n < i ? 1 : 0));
      slides[i].classList.add('on'); caps[i].classList.add('on'); segs[i].setAttribute('aria-current', 'true');
      reel.dataset.moved = '';
      sync();
    };
    vids.forEach((v, k) => {
      v.addEventListener('playing', () => slides[k].classList.add('started'), { once: true });
      // a focused caption link must not vanish under the keyboard: replay the same loop until focus leaves it
      v.addEventListener('ended', () => { if (k !== i) return; if (caps[i].contains(document.activeElement)) { v.currentTime = 0; sync(); return; } go((i + 1) % vids.length); });
    });
    segs.forEach((s, k) => s.addEventListener('click', () => { if (k !== i) go(k); }));
    btn.addEventListener('click', () => { user = reel.dataset.state !== 'playing'; reel.dataset.user = ''; sync(); });
    new IntersectionObserver(([e]) => { shown = e.isIntersecting; sync(); }, { threshold: .5 }).observe(reel.querySelector('.stage')!);
    osCalm.addEventListener('change', sync);
    document.getElementById('calm')?.addEventListener('click', () => setTimeout(sync));
  }
</script>
</body>
</html>
