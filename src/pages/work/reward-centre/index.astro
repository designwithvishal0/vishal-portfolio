<div class="wrap">

  <header class="hero">
    <p class="eyebrow">Product design · Concept for a gaming app</p>
    <h1>Unified Reward Centre</h1>
    <p class="hook">Every reward. One place.</p>
    <p class="dek">A reward centre concept for a gaming app. Rewards from every source in one place, sorted by what the player can do with them right now.</p>
  </header>

  <div class="facts">
    <div><span class="k">Role</span><p>Product (UI/UX) Designer</p></div>
    <div><span class="k">Year</span><p>2026</p></div>
    <div><span class="k">Prototype</span><p>Built and prototyped in Figma</p></div>
    <div><span class="k">Scope</span><p>Four screens, one card component in six states, a token based system, and a working prototype.</p></div>
  </div>
  <p class="note">Solo project. I owned the problem framing, information architecture, flows, UI, design system and prototype.</p>
  <figure class="reel" style="margin-top:32px"><video data-inview class="shot wide" poster="img/00-hero-poster.jpg" width="1920" height="1080" muted loop playsinline preload="metadata" aria-label="Unified Reward Centre showreel"></video>
    <div class="pills"><button type="button" class="pill" data-act="play" aria-pressed="false" aria-label="Play"><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M7 5.3v13.4a1.2 1.2 0 0 0 1.8 1l10.6-6.7a1.2 1.2 0 0 0 0-2L8.8 4.3A1.2 1.2 0 0 0 7 5.3z" fill="currentColor"/></svg><span class="lb">PLAY</span></button><button type="button" class="pill fs" data-act="fs" aria-label="Full screen"><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9V5a1 1 0 0 1 1-1h4M15 4h4a1 1 0 0 1 1 1v4M20 15v4a1 1 0 0 1-1 1h-4M9 20H5a1 1 0 0 1-1-1v-4"/></svg><span class="lb">FULL SCREEN</span></button></div></figure>
  <script is:inline>(()=>{
    // This reel has no sound, so it only needs Play and Full screen. Same look and behaviour as the JARVIS reel otherwise.
    const f=document.currentScript.previousElementSibling, v=f.querySelector('video'); const tall=matchMedia('(max-width:620px)').matches; if(tall){v.poster='img/00-hero-poster-tall.jpg';v.width=1080;v.height=1920} v.src=tall?'showreel-tall.mp4':'showreel.mp4'; const pb=f.querySelector('[data-act=play]');
    const ip='<svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M7 5.3v13.4a1.2 1.2 0 0 0 1.8 1l10.6-6.7a1.2 1.2 0 0 0 0-2L8.8 4.3A1.2 1.2 0 0 0 7 5.3z" fill="currentColor"/></svg>', ia='<svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><rect x="6" y="4.5" width="4.2" height="15" rx="1.4" fill="currentColor"/><rect x="13.8" y="4.5" width="4.2" height="15" rx="1.4" fill="currentColor"/></svg>';
    const paint=()=>{pb.innerHTML=v.paused?ip+'<span class="lb">PLAY</span>':ia+'<span class="lb">PAUSE</span>';pb.setAttribute('aria-label',v.paused?'Play':'Pause');pb.setAttribute('aria-pressed',String(!v.paused))};
    const fb=f.querySelector('.fs'),fsOn=()=>document.fullscreenElement===f;
    fb.onclick=()=>{if(fsOn())document.exitFullscreen();else if(f.requestFullscreen)f.requestFullscreen();else if(v.webkitEnterFullscreen)v.webkitEnterFullscreen()};
    document.addEventListener('fullscreenchange',()=>{const o=fsOn();fb.setAttribute('aria-label',o?'Exit full screen':'Full screen');fb.querySelector('.lb').textContent=o?'EXIT FULL SCREEN':'FULL SCREEN'});
    pb.onclick=()=>{if(v.paused)v.play();else v.pause()};
    v.onclick=()=>pb.onclick();v.style.cursor='pointer';
