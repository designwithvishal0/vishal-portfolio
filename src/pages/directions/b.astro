---
import '@fontsource-variable/hanken-grotesk';
import { intro, work, caseHeader } from '../../data/home';
---
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title>Direction B, Quiet</title>
<style>
  :root{--bg:#F7F7F6;--ink:#1D1D1F;--muted:#6E6E73;--rule:#E2E2E0;--accent:#2B54D6;--card:#EDEDEB;--sans:'Hanken Grotesk Variable',system-ui,sans-serif}
  @media (prefers-color-scheme:dark){:root{--bg:#121214;--ink:#F2F2F3;--muted:#A1A1A6;--rule:#26262A;--accent:#7D9BFF;--card:#1C1C1F}}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font:400 18px/1.45 var(--sans)}
  .wrap{max-width:1180px;margin:0 auto;padding:0 24px}
  a{color:inherit}
  a:focus-visible{outline:2px solid var(--accent);outline-offset:4px;border-radius:2px}

  .top{display:flex;justify-content:space-between;gap:16px;padding:28px 0;font-size:15px}
  h1{font-size:15px;font-weight:600;margin:0}
  .status{color:var(--muted);display:inline-flex;align-items:center;gap:8px}
  .dot{width:7px;height:7px;border-radius:50%;background:#1F9D55}
  @media (max-width:640px){.top{flex-direction:column}}

  .hero{padding:120px 0 120px}
  .pos{font-size:clamp(44px,7.6vw,112px);line-height:1.0;letter-spacing:-.04em;font-weight:600;margin:0 0 40px;max-width:12ch}
  .sup{font-size:20px;color:var(--muted);max-width:52ch;margin:0 0 32px}
  .cta{display:flex;gap:12px;flex-wrap:wrap}
  .btn{display:inline-block;padding:12px 22px;border-radius:999px;text-decoration:none;font-weight:600;font-size:16px;border:1px solid var(--ink)}
  .btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
  @media (prefers-color-scheme:dark){.btn.primary{color:#0B1230}}

  .grid{display:grid;grid-template-columns:1fr 1fr;gap:64px 32px;padding:0 0 120px}
  @media (max-width:760px){.grid{grid-template-columns:1fr;gap:56px}}
  .card{text-decoration:none;display:block}
  .card .img{background:var(--card);border-radius:16px;overflow:hidden;aspect-ratio:4/3;display:grid;place-items:end center}
  .card img{width:78%;height:auto;display:block;transition:transform .3s ease}
  .card:hover img{transform:translateY(-6px)}
  .card .name{font-size:15px;color:var(--muted);margin:20px 0 6px}
  .card h3{font-size:28px;line-height:1.15;letter-spacing:-.02em;margin:0 0 8px;font-weight:600}
  .card:hover h3{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:5px}
  .card p{margin:0 0 10px;color:var(--muted);max-width:48ch}
  .card .meta{font-size:15px}

  .case{border-top:1px solid var(--rule);padding:120px 0 140px}
  .note{font-size:15px;color:var(--muted);margin:0 0 56px}
  .eyebrow{font-size:15px;color:var(--accent);font-weight:600;margin:0 0 20px}
  .case h2{font-size:clamp(40px,6vw,84px);line-height:1.02;letter-spacing:-.035em;font-weight:600;margin:0 0 32px;max-width:14ch}
  .sum{font-size:21px;max-width:60ch;margin:0 0 48px}
  .facts{display:flex;flex-wrap:wrap;gap:24px 56px;margin:0 0 56px}
  .facts dt{font-size:14px;color:var(--muted)}
  .facts dd{margin:4px 0 0;font-weight:600}
  .case .img{background:var(--card);border-radius:16px;overflow:hidden;display:grid;place-items:center;padding:48px 0 0}
  .case .img img{width:min(560px,80%);height:auto;display:block}
  @media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <h1>{intro.name}</h1>
    <span class="status"><span class="dot" aria-hidden="true"></span>{intro.availability}</span>
  </div>

  <section class="hero">
    <p class="pos">{intro.positioning}</p>
    <p class="sup">{intro.supporting}</p>
    <div class="cta">
      <a class="btn primary" href={intro.links[1].href}>{intro.links[1].label}</a>
      <a class="btn" href={intro.links[0].href}>{intro.links[0].label}</a>
    </div>
  </section>

  <section class="grid" aria-label="Selected work">
    {work.map(w => (
      <a class="card" href={`#${w.slug}`}>
        <div class="img"><img src={w.image} alt={w.alt} width="480" height="502" loading="lazy" decoding="async" /></div>
        <p class="name">{w.name}</p>
        <h3>{w.headline}</h3>
        <p>{w.problem}</p>
        <span class="meta">{w.type}, {w.year} · {w.detail}</span>
      </a>
    ))}
  </section>

  <section class="case" aria-labelledby="case">
    <p class="note">Case study header</p>
    <p class="eyebrow">{caseHeader.eyebrow}</p>
    <h2 id="case">{caseHeader.title}</h2>
    <p class="sum">{caseHeader.summary}</p>
    <dl class="facts">{caseHeader.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
    <div class="img"><img src={caseHeader.image} alt={work[0].alt} width="1464" height="1532" /></div>
  </section>
</div>
</body>
</html>
