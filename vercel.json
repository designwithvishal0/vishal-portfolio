{
  "git": {
    "deploymentEnabled": {
      "claude/**": false
    }
  },
  "redirects": [
    {
      "source": "/looks",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/looks/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/directions",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/directions/(.*)",
      "destination": "/",
      "permanent": false
    }
  ]
}
