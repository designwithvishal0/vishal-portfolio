  .protowrap.live{position:fixed;inset:0;z-index:1000;max-width:none;margin:0;padding:16px 16px calc(16px + env(safe-area-inset-bottom));background:rgba(7,14,6,.94);flex-direction:column;align-items:center;justify-content:center;gap:16px}
