---
// All work in one scrollable list (Vishal 2026-10-14): Work in the header opens this from every page except home.
// Grouped so the four case studies lead and graphics come last. Everything reads from src/data/home.ts, the same data as the home cards.
import '@fontsource-variable/hanken-grotesk';
import '../../styles/tokens.css';
import SiteHeader from '../../components/SiteHeader.astro';
import Boot from '../../components/Boot.astro';
import { work, loops, lead, more, pages, graphics, intro, email, social, contra, updated } from '../../data/home';
import '@fontsource-variable/bricolage-grotesque/standard.css';

const title = 'Work by Vishal Yadav, product designer';
const description = 'Every project by Vishal Yadav, product designer in Gurugram: four case studies, shipped campaign pages for CashKaro and EarnKaro, product concepts and graphic design.';
const canonical = new URL('/work/', Astro.site).href;
const book = intro.links.find(l => l.label === 'Book a call')!;
const resume = intro.links.find(l => l.label === 'Resume')!;

const shipped = [lead, ...pages.filter(p => p.tag.startsWith('Shipped'))];
const concepts = pages.filter(p => p.tag === 'Concept');
const groups = [
  { id: 'shipped', h: 'Shipped work', items: shipped },
  { id: 'product', h: 'More product work', items: more.map(m => ({ ...m, tag: '' })) },
  { id: 'concepts', h: 'Concept pages', items: concepts },
];

const ld = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url: canonical,
    author: { '@type': 'Person', name: 'Vishal Yadav' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: '/' },
    { '@type': 'ListItem', position: 2, name: 'Work', item: canonical },
  ] },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{title}</title>
<Boot />
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:type" content="website">
<meta property="og:image" content="/kinetic/thumbs/ixigo-wide.webp"><meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<style is:inline>
/* Same shell as the graphics pages: site tokens only, light and dark. The shared header reads --line --edge --btn --on-btn --bar --gut --out. */
:root{--line:var(--rule);--edge:var(--muted);--btn:var(--ink);--on-btn:var(--bg);--bar:56px;--gut:32px;--out:var(--ease-out);--max:1376px}
@media (max-width:759px){:root{--bar:52px;--gut:16px}}
*{box-sizing:border-box}
html{overflow-x:clip}
body{margin:0;background:var(--bg);color:var(--ink);font:400 var(--fs-body)/1.6 var(--sans);-webkit-font-smoothing:antialiased}
a{color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:var(--r-focus)}
.wrap{width:min(var(--max),100% - var(--gut) * 2);margin-inline:auto}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
/* group selector: stays under the header while you scroll, the group in view is filled */
.jump{margin:0 calc(var(--gut) * -1);padding:var(--s6) var(--gut) var(--s3);background:var(--bg)}
/* same frosted glass as the header bar above it, so the two read as one */
.jump ul{display:flex;gap:var(--s2);overflow-x:auto;scrollbar-width:none}
.jump ul::-webkit-scrollbar{display:none}
.jump a{display:inline-flex;align-items:center;min-height:40px;padding:0 16px;border:1px solid var(--rule);border-radius:var(--r-pill);font-size:var(--fs-meta);font-weight:600;white-space:nowrap;text-decoration:none;transition:border-color var(--hover) var(--ease-out),background-color var(--hover) var(--ease-out),color var(--hover) var(--ease-out)}
.jump a:hover{border-color:var(--ink)}
.jump a[aria-current]{background:var(--ink);border-color:var(--ink);color:var(--bg)}
section{padding-top:var(--s12);scroll-margin-top:calc(var(--bar) + 64px)}
section > h2{margin:0 0 var(--s6);padding-bottom:var(--s3);border-bottom:1px solid var(--rule);display:flex;justify-content:space-between;align-items:baseline;gap:var(--s4);font-size:var(--fs-h3);font-weight:var(--w-head);letter-spacing:var(--track-head)}
section > h2 small{font-size:var(--fs-meta);font-weight:500;color:var(--muted);letter-spacing:0}
ul{list-style:none;margin:0;padding:0}
img{display:block;width:100%;height:auto;background:var(--card)}
.meta{margin:0;font-size:var(--fs-meta);color:var(--muted);font-weight:500}
/* case studies: big rows, cover left, text right */
.cs{display:grid;gap:var(--s10)}
.cs a{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:var(--s8);align-items:center;text-decoration:none}
.cs img{border-radius:var(--r-card);aspect-ratio:16/9;object-fit:cover;transition:transform var(--hover) var(--ease-out)}
.cs .txt{display:grid;gap:var(--s3)}
.cs .name{margin:0;font-size:var(--fs-ui);font-weight:var(--w-strong)}
.cs h3{margin:0;font-size:var(--fs-h3);font-weight:var(--w-head);line-height:var(--lh-head);letter-spacing:var(--track-head);text-wrap:balance}
.cs .prob{margin:0;color:var(--muted);line-height:var(--lh-body);max-width:46ch}
.cs .go{font-size:var(--fs-ui);font-weight:var(--w-strong);text-decoration:underline;text-underline-offset:.25em;text-decoration-color:var(--rule);transition:text-decoration-color var(--hover)}
.cs a:hover img{transform:translateY(-2px)}
.cs a:hover .go{text-decoration-color:currentColor}
/* the rest: compact rows, small page preview beside the text */
/* Shipped, More product work, Concept pages (Vishal 2026-10-19): full thumbnails, never cropped, each card ends on View the case study */
.rows{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--s10) var(--s8)}
.rows a{display:grid;gap:var(--s4);align-content:start;text-decoration:none}
.rows img{width:100%;height:auto;border-radius:var(--r-card);transition:transform var(--hover) var(--ease-out)}
.rows .t{display:grid;gap:var(--s2);justify-items:start}
.rows .name{margin:0;font-size:var(--fs-lead);font-weight:var(--w-strong);line-height:1.3}
.rows .line{margin:0;color:var(--muted);line-height:var(--lh-body)}
.rows .stats{margin:0;display:flex;flex-wrap:wrap;gap:var(--s1) var(--s4);font-size:var(--fs-meta);color:var(--muted)}
.rows .stats b{color:var(--ink);font-weight:var(--w-strong)}
.tag{font-size:var(--fs-caption);font-weight:600;color:var(--muted);white-space:nowrap}
.rows .go{margin-top:var(--s1);font-size:var(--fs-ui);font-weight:var(--w-strong);text-decoration:underline;text-underline-offset:.25em;text-decoration-color:var(--rule);transition:text-decoration-color var(--hover)}
.rows a:hover img{transform:translateY(-2px)}
.rows a:hover .go{text-decoration-color:currentColor}
/* graphic design: small tiles */
.gfx{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:var(--s4)}
.gfx a{display:grid;gap:var(--s3);text-decoration:none}
.gfx img{aspect-ratio:4/3;object-fit:cover;border-radius:10px;transition:transform var(--hover) var(--ease-out)}
.gfx span{font-size:var(--fs-caption);font-weight:500;color:var(--muted);line-height:1.35}
.gfx a:hover img{transform:translateY(-2px)}
.gfx a:hover span{text-decoration:underline;text-underline-offset:.2em}
/* ending: the homepage's closing block and footer (Vishal 2026-10-15: same footer as home, nothing new) */
.end{--bg:#141416;--ink:#F2F1EC;--muted:#A7A7AE;--edge:#6B6B72;--line:#2A2A30;--btn:#F2F1EC;--on-btn:#0C0C0E;--live:#4CC38A;margin:var(--s32) 16px 16px;border-radius:32px;background:var(--bg);color:var(--ink);color-scheme:dark;font-family:'Bricolage Grotesque Variable',sans-serif}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]) .end{--bg:#18181B;box-shadow:inset 0 0 0 1px #26262B}}
:root[data-theme=dark] .end{--bg:#18181B;box-shadow:inset 0 0 0 1px #26262B}
.end .c{width:min(1376px,100% - 64px);margin-inline:auto}
.end .ct{padding:104px 0 0}
.end h2{margin:0 0 40px;font-size:clamp(56px,9vw,136px);font-weight:800;font-stretch:75%;line-height:.92;letter-spacing:-.025em;max-width:12ch}
@media (min-width:1000px){.end .ct .c{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:32px;align-items:end}.end h2{grid-column:1/8;margin:0}.end .ct-r{grid-column:8/13;padding-bottom:8px}}
.end .cta{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:28px}
.end .pill-btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 22px;border-radius:999px;font-size:15px;font-weight:650;line-height:1;white-space:nowrap;text-decoration:none;color:var(--ink);border:1px solid var(--edge);transition:transform 120ms var(--ease-out),background-color 200ms var(--ease-out)}
.end .pill-btn.primary{background:var(--btn);color:var(--on-btn);border-color:var(--btn)}
.end .pill-btn:active{transform:scale(.97)}
@media (hover:hover){.end .pill-btn:hover{background:color-mix(in oklab,var(--ink) 7%,transparent)}.end .pill-btn.primary:hover{background:color-mix(in oklab,var(--btn) 84%,var(--bg))}}
.end .ul{color:inherit;text-decoration:none;background:linear-gradient(color-mix(in srgb,currentColor 32%,transparent),color-mix(in srgb,currentColor 32%,transparent)) no-repeat 0 100%/100% 1px,linear-gradient(currentColor,currentColor) no-repeat 100% 100%/0 1px;transition:background-size 200ms var(--ease-out)}
.end .ul:hover,.end .ul:focus-visible{background-size:100% 1px,100% 1px;background-position:0 100%,0 100%}
.end .cl{font-size:18px;margin:10px 0 0;max-width:60ch}
.end .copy{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer;display:inline-flex;align-items:baseline;gap:8px;min-height:24px;position:relative;vertical-align:baseline}
.end .copy::after,.end .social a::after{content:"";position:absolute;inset:50% auto auto 50%;width:max(100%,44px);height:max(100%,44px);translate:-50% -50%}
.end .copy .tag{font-size:12px;font-weight:600;border:1px solid var(--edge);border-radius:999px;padding:0 8px}
.end .copy .t-done,.end .copy.done .t-copy{display:none}
.end .copy.done .t-done{display:inline}
.end .here{display:flex;align-items:center;gap:10px;margin:22px 0 0;font-size:15px;color:var(--muted)}
.end .here i{flex:none;width:8px;height:8px;border-radius:50%;background:var(--live);box-shadow:0 0 0 4px color-mix(in srgb,var(--live) 22%,transparent)}
.end .foot{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px;margin-top:112px;padding:28px 0 32px;border-top:1px solid var(--line);font-size:15px}
.end .social{display:flex;flex-wrap:wrap;gap:8px 24px}
.end .social a{position:relative;padding:10px 8px;margin-inline:-8px;background-origin:content-box;background-clip:content-box}
.end .copyr{margin:0;color:var(--muted)}
.end :focus-visible{outline-color:var(--ink)}
@media (max-width:759px){.end{margin:64px 8px 8px;border-radius:24px}.end .c{width:calc(100% - 32px)}.end .ct{padding-top:56px}.end h2{font-size:52px;margin-bottom:28px}.end .cl{font-size:16px}.end .cta{display:grid;grid-template-columns:1fr 1fr;gap:8px}.end .cta .pill-btn{min-height:52px}.end .foot{flex-direction:column;align-items:flex-start;margin-top:56px;padding-bottom:calc(32px + env(safe-area-inset-bottom))}}
@media (max-width:1000px){.gfx{grid-template-columns:repeat(3,minmax(0,1fr))}.rows{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:759px){
  .jump{padding-top:var(--s4)}
  section{padding-top:var(--s10)}
  .cs{gap:var(--s8)}
  .cs a{grid-template-columns:1fr;gap:var(--s4)}
  .rows{grid-template-columns:1fr;gap:var(--s12)}
  .gfx{grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--s3)}
  .gfx span{font-size:var(--fs-caption)}
  .gfx img{border-radius:8px}
  .btns{flex-direction:column;width:100%}.btn{width:100%}
}
@media (prefers-reduced-motion:reduce){.btn,.cs img,.gfx img{transition:none}}
html.calm .btn,html.calm .cs img,html.calm .gfx img{transition:none}
</style>
</head>

<SiteHeader home="/" book calm={false} />

<main>
  <div class="wrap">
    {/* no title block (Vishal 2026-10-14 03:34): the page opens on the group selector, then the work */}
    <h1 class="sr">Work by Vishal Yadav, product designer</h1>
    <nav class="jump" aria-label="Jump to">
      <ul>
        <li><a href="#case-studies">Case studies</a></li>
        {groups.map(g => <li><a href={`#${g.id}`}>{g.h}</a></li>)}
        <li><a href="#graphics">Graphic design</a></li>
      </ul>
    </nav>

    <section id="case-studies" aria-labelledby="cs-h">
      <h2 id="cs-h">Case studies <small>{work.length}</small></h2>
      <ul class="cs">
        {work.map((w, i) => (
          <li><a href={`/work/${w.slug}/`}>
            <img src={`/kinetic/thumbs/${loops[i]}-wide.webp`} width="2233" height="1256" alt={`${w.name} case study cover`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
            <div class="txt">
              <p class="name">{w.name}</p>
              <h3>{w.headline}</h3>
              <p class="prob">{w.problem}</p>
              <p class="meta">{w.type} · {w.role}</p>
              <span class="go">View the case study</span>
            </div>
          </a></li>
        ))}
      </ul>
    </section>

    {groups.map(g => (
      <section id={g.id} aria-labelledby={`${g.id}-h`}>
        <h2 id={`${g.id}-h`}>{g.h} <small>{g.items.length}</small></h2>
        <ul class="rows">
          {g.items.map(p => (
            <li><a href={p.href}>
              <img src={`/pages/${p.img}.webp`} width="960" height="1004" alt="" loading="lazy" decoding="async" />
              <div class="t">
                <p class="name">{p.name}</p>
                <p class="line">{p.line}</p>
                {'stats' in p && <p class="stats">{(p as typeof lead).stats.map(([n, l]) => <span><b>{n}</b> {l}</span>)}</p>}
                {p.tag && p.tag !== 'Concept' && <span class="tag">{p.tag}</span>}
                <span class="go">View the case study</span>
              </div>
            </a></li>
          ))}
        </ul>
      </section>
    ))}

    <section id="graphics" aria-labelledby="gfx-h">
      <h2 id="gfx-h">Graphic design <small>{graphics.length}</small></h2>
      <ul class="gfx">
        {graphics.map(g => <li><a href={`/work/graphics/${g.key}/`}><img src={`/graphics/${g.key}.webp`} alt={g.alt} width="800" height="600" loading="lazy" decoding="async" /><span>{g.cap}</span></a></li>)}
      </ul>
    </section>
  </div>

  <div class="end">
    <section class="ct" aria-labelledby="c-h">
      <div class="c">
        <h2 id="c-h">Hiring, or need a page that sells?</h2>
        <div class="ct-r">
          <div class="cta">
            <a class="pill-btn primary" href={book.href}>{book.label}</a>
            <a class="pill-btn" href={resume.href} target="_blank" rel="noopener">{resume.label}</a>
          </div>
          <p class="cl">Email me at <a class="ul" href={`mailto:${email}`}>{email}</a> <button class="copy" type="button" data-copy={email} aria-label="Copy email address"><span class="tag" aria-hidden="true"><span class="t-copy">Copy</span><span class="t-done">Copied</span></span></button><br />I reply within a day.</p>
          <p class="cl">Want a page fixed? Send me the link, and I’ll bring my top three fixes to the call.</p>
          <span class="sr" role="status" id="copied"></span>
          <p class="here"><i aria-hidden="true"></i><span id="clock">Based in Gurugram, India</span></p>
          {contra && <p class="cl">You can also hire me on <a class="ul" href={contra}>Contra</a>.</p>}
        </div>
      </div>
    </section>
    <footer class="foot c">
      <nav aria-label="Elsewhere" class="social">{social.map(([l, h]) => <a class="ul" href={h}>{l}</a>)}</nav>
      <p class="copyr">© 2026 Vishal Yadav. All rights reserved.</p>
      <p class="copyr colo">Designed and coded by me in Astro, with Claude as my coding partner. Updated {updated}.</p>
    </footer>
  </div>
</main>
<script is:inline>(()=>{const c=document.getElementById('clock'),f=new Intl.DateTimeFormat('en-IN',{timeZone:'Asia/Kolkata',hour:'numeric',minute:'2-digit',hour12:true}),t=()=>{c.textContent='It’s '+f.format(new Date()).toUpperCase()+' in Gurugram, India'};t();setInterval(t,30000);const st=document.getElementById('copied');document.querySelectorAll('[data-copy]').forEach(b=>b.addEventListener('click',async()=>{const x=b.dataset.copy;try{await navigator.clipboard.writeText(x)}catch{location.href='mailto:'+x;return}b.classList.add('done');st.textContent='Email address copied';setTimeout(()=>{b.classList.remove('done');st.textContent=''},2000)}))})()</script>
<script>
  // the selector fills the group whose heading was last scrolled past
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.jump a')];
  const secs = links.map(a => document.querySelector<HTMLElement>(a.hash)!);
  const set = () => {
    const y = innerHeight * 0.35;
    let i = 0;
    secs.forEach((s, k) => { if (s.getBoundingClientRect().top < y) i = k; });
    links.forEach((a, k) => k === i ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current'));
    // keep the filled chip in view by scrolling only the chip row sideways; scrollIntoView also nudged the page up, which brought the phone header back
    const row = links[i].closest('ul')!, a = links[i].getBoundingClientRect(), r = row.getBoundingClientRect();
    if (a.left < r.left) row.scrollLeft -= r.left - a.left; else if (a.right > r.right) row.scrollLeft += a.right - r.right;
  };
  addEventListener('scroll', set, { passive: true }); set();
</script>
