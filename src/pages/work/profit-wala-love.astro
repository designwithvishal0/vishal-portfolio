---
// Profit Wala Love: the Dribbble post as a page on this site (Vishal 2026-10-12), so the click keeps people here.
// Words are his Dribbble copy, word for word. Images are still served from Dribbble's CDN for this preview;
// swap them for local WebP files from his Downloads before this goes live.
import '@fontsource-variable/bricolage-grotesque/standard.css';
import fontUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-standard-normal.woff2?url';
import '../../styles/kinetic.css';
import Boot from '../../components/Boot.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Arrow from '../../components/Arrow.astro';
import { intro, email, social, contra, lead } from '../../data/home';

const book = intro.links.find(l => l.label === 'Book a call')!;
const resume = intro.links.find(l => l.label === 'Resume')!;
const dribbble = 'https://dribbble.com/shots/27168211-Valentines-Day-Landing-Page';
const img = (path: string) => `https://cdn.dribbble.com/userupload/${path}?resize=1600x&vertical=center`;
const hero = img('47011339/file/6038884f0b6689cfee88227827a992d1.png');
const icons = img('47011338/file/307044196d790aef8d1cd675e20b3baf.png');
const marketing = [
  ['47011340/file/13e493ac4a4b28fb0cc5411f1bc43fe3.png', 'Profit Wala Love home page banners'],
  ['47011341/file/9a0195ed0ad6f8e190b273b766f71533.png', 'Profit Wala Love in app placements'],
  ['47011342/file/6b1f2bbe9cebc91f6d4045cc5690c848.png', 'Profit Wala Love emailer'],
  ['47011451/file/e86e33b8af27ff63f71577a36864f9f8.png', 'Profit Wala Love marketing asset'],
].map(([p, alt]) => [img(p), alt]);
const video = 'https://cdn.dribbble.com/userupload/49194197/file/b5ea4872b979383b5dde81e412b95d5d.mp4';
const poster = 'https://cdn.dribbble.com/userupload/49194197/file/still-23caa99eabf84be7b18d9bfa8b260f3b.png';
const closing = img('49194717/file/c15bdaaea4976d7c10e63f3e02f05507.jpg');
// +51% is against a normal week (Vishal 2026-10-12)
const stats = [...lead.stats.map(([n, l]) => [n, n === '+51%' ? 'retailer commission vs a normal week' : l]), ['13,707', 'deal shares']];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Profit Wala Love, Valentine Week Campaign for CashKaro · Vishal Yadav</title>
<meta name="description" content="Valentine Week campaign Vishal Yadav designed for CashKaro: 1,542 transactions, ₹9.89 lakh GMV, 13,707 deal shares and a 51% lift in retailer commission." />
<meta name="robots" content="noindex" />
<meta name="color-scheme" content="light dark" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preload" as="font" type="font/woff2" href={fontUrl} crossorigin />
<link rel="preconnect" href="https://cdn.dribbble.com" />
<Boot />
<style is:inline>
.pw{padding:calc(var(--bar) + 72px) 0 120px}
.pw-head{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);column-gap:64px;align-items:center}
.pw h1{font-size:clamp(36px,3.8vw,60px);font-weight:800;font-stretch:80%;line-height:1;letter-spacing:-.025em;margin:18px 0 24px;text-wrap:balance}
.pw p{font-size:18px;line-height:1.6;color:var(--muted);max-width:66ch;margin:0 0 14px}
.pw .stats{display:grid;grid-template-columns:repeat(4,1fr);margin:72px 0 0;gap:32px 48px}
.pw .head-film{margin:0}
.pw .head-film video{aspect-ratio:4/3;object-fit:cover}
.pw .stats dd{font-size:clamp(40px,4.4vw,72px)}
.pw .stats dt{font-size:15px;color:var(--muted)}
.pw figure{margin:0}
.pw img,.pw video{display:block;width:100%;height:auto;border-radius:24px;background:var(--line)}
.pw .shot{margin:72px auto 0;max-width:960px}
.pw h2{font-size:clamp(28px,3vw,40px);font-weight:750;letter-spacing:-.02em;margin:120px 0 8px}
.pw h2 + p{margin-bottom:32px}
.pw .grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.pw .role{color:var(--ink);font-size:16px}
.pw .src{margin:8px 0 0;font-size:15px;color:var(--muted)}
.pw .src a{color:var(--ink)}
.pw .back{margin-top:72px}
@media (max-width:759px){
  .pw{padding-top:calc(var(--bar) + 40px)}
  .pw p{font-size:17px}
  .pw img,.pw video{border-radius:16px}
  .pw .grid{grid-template-columns:1fr;gap:16px}
  .pw .shot{margin-top:48px}
  .pw h2{margin-top:80px}
  .pw .stats dd{font-size:44px}
  .pw-head{grid-template-columns:1fr;row-gap:32px}
  .pw .stats{grid-template-columns:1fr 1fr;margin-top:48px;gap:24px 24px}
}
.pw-ct h2{font-size:clamp(40px,5vw,72px);font-weight:800;font-stretch:80%;line-height:1;letter-spacing:-.025em;margin:0}
</style>
</head>
<body>
<SiteHeader home="/looks/kinetic/" book />

<main class="pw">
  <div class="c">
    <div class="pw-head">
    <div class="pw-top">
      <span class="pill shipped">{lead.tag}</span>
      <h1>Profit Wala Love, Valentine Week Campaign for CashKaro</h1>
      <p>Valentine Week campaign I designed for CashKaro, India's largest cashback platform with 25M+ users. The goal: get users sharing Valentine deals and earning from every share, one day at a time.</p>
      <p>Each day from Rose Day to Promise Day got its own card with an inactive and an active state. Tapping a day lifts it and swaps the deal carousel to that day's gifts. Every deal card shows the retailer, the price hook and the profit you earn. Further down, a For Her / For Him switch changes the whole product edit while the categories stay in place. The same story ran across home banners, in app placements and the emailer.</p>
      <p class="role"><strong>My role:</strong> Solo designer, from the day cards to the emailer. CashKaro's developers built it.</p>
      <p class="src">Also on <a class="ul" href={dribbble}>Dribbble</a></p>
    </div>
    {/* the post's opening video, beside the intro like his Contra page: silent loop, plays unless motion is reduced */}
    <figure class="head-film"><video id="pwl-film" data-inview src={video} poster={poster} muted loop playsinline controls preload="metadata" aria-label="Profit Wala Love campaign video, no sound"></video></figure>
    <script is:inline>(()=>{const v=document.getElementById('pwl-film'),r=document.documentElement;if(matchMedia('(prefers-reduced-motion: reduce)').matches||r.classList.contains('calm'))return;v.play().catch(()=>{})})()</script>
    </div>

    <dl class="stats">{stats.map(([n, l]) => <div><dt>{l}</dt><dd>{n}</dd></div>)}</dl>

    <figure class="shot"><img src={hero} alt="Profit Wala Love landing page on CashKaro, with a card for each Valentine Week day and the deal carousel for that day" width="1600" height="1200" fetchpriority="high" /></figure>

    <h2>Assets</h2>
    <p>Icons for Day wise selection</p>
    <figure><img src={icons} alt="Category icons for each Valentine Week day, from Rose Day to Promise Day" width="1600" height="1200" loading="lazy" decoding="async" /></figure>

    <h2>Marketing Assets</h2>
    <p>Home Page Banners, In-App and Emailer</p>
    <div class="grid">{marketing.map(([src, alt]) => <figure><img src={src} alt={alt} width="1600" height="1200" loading="lazy" decoding="async" /></figure>)}</div>

    <figure class="shot"><img src={closing} alt="Profit Wala Love campaign" width="1600" height="1200" loading="lazy" decoding="async" /></figure>

    <a class="more go back" href="/looks/kinetic/#pages">Back to Pages that sell <Arrow /></a>
  </div>
</main>

<div class="end">
  <section class="ct pw-ct" id="contact" aria-labelledby="c-h">
    <div class="c">
      <h2 id="c-h">Hiring, or need a page that sells?</h2>
      <div class="ct-r">
      <div class="cta">
        <a class="pill-btn primary" href={book.href}>{book.label}</a>
        <a class="pill-btn" href={resume.href} target="_blank" rel="noopener">{resume.label}</a>
      </div>
      <p class="cl">Email me at <a class="ul" href={`mailto:${email}`}>{email}</a> <button class="copy chip" type="button" data-copy={email} aria-label="Copy email address"><span class="tag" aria-hidden="true"><span class="t-copy">Copy</span><span class="t-done">Copied</span></span></button>. I reply within a day.</p>
      <p class="cl">Share the page or store you want fixed, and I’ll bring my top three fixes to the call.</p>
      <span class="vh" role="status" id="copied"></span>
      <p class="here"><i aria-hidden="true"></i><span id="clock">Based in Gurugram, India</span></p>
      {contra && <p class="cl">You can also hire me on <a class="ul" href={contra}>Contra</a>.</p>}
      </div>
    </div>
  </section>
  <footer class="foot c">
    <nav aria-label="Elsewhere" class="social">{social.map(([l, h]) => <a class="ul" href={h}>{l}</a>)}</nav>
    <p class="copyr">© 2026 Vishal Yadav. All rights reserved.</p>
  </footer>
</div>
<script is:inline>(()=>{const c=document.getElementById('clock'),f=new Intl.DateTimeFormat('en-IN',{timeZone:'Asia/Kolkata',hour:'numeric',minute:'2-digit',hour12:true}),t=()=>{c.textContent='It’s '+f.format(new Date()).toUpperCase()+' in Gurugram'};t();setInterval(t,30000)})()</script>
<script is:inline src="/js/inview-video.js" defer></script>
<script>import '../../scripts/ui';</script>
</body>
</html>
