---
// The JARVIS case study's closing section ("footer"), in the home page ending's design language:
// dark rounded block, big condensed heading, pill buttons, socials row. Its words are the case study's own closing.
import '@fontsource-variable/bricolage-grotesque/standard.css';
import { social } from '../data/home';
---
<div class="end">
  <section class="ct" aria-labelledby="c-h">
    <div class="c">
      <div class="ct-l">
        <h2 id="c-h">JARVIS Alerts</h2>
        <p class="sub">Every correction, visible.</p>
      </div>
      <div class="ct-r">
        <div class="cta">
          <a class="pill-btn primary" href="https://www.figma.com/design/NEbmc8cqnHE2l7J1zSV3ER" target="_blank" rel="noopener">View the Figma file</a>
          <a class="pill-btn" href="/looks/kinetic/">Back to home</a>
        </div>
      </div>
    </div>
  </section>
  <footer class="foot c">
    <nav aria-label="Elsewhere" class="social">{social.map(([l, h]) => <a class="ul" href={h}>{l}</a>)}</nav>
    <p class="copyr">© 2026 Vishal Yadav. All rights reserved.</p>
  </footer>
</div>
<style is:global>
.end{--bg:#141416;--ink:#F2F1EC;--muted:#A7A7AE;--edge:#6B6B72;--line:#2A2A30;--btn:#F2F1EC;--on-btn:#0C0C0E;--live:#4CC38A;--t-acc:#8DB8E6;
  --e-out:cubic-bezier(.23,1,.32,1);--e-max:1376px;--e-gut:32px;
  margin:160px calc(16px - var(--page-pad,0px)) 16px;border-radius:32px;background:var(--bg);color:var(--ink);color-scheme:dark;
  font:400 18px/1.5 'Bricolage Grotesque Variable',system-ui,sans-serif;font-optical-sizing:auto;-webkit-font-smoothing:antialiased}
.end *{box-sizing:border-box}
.end p,.end h2{margin:0}
.end .c{width:min(var(--e-max),100% - var(--e-gut) * 2);margin-inline:auto}
.end .ul{color:inherit;text-decoration:none;background:linear-gradient(color-mix(in srgb,currentColor 32%,transparent),color-mix(in srgb,currentColor 32%,transparent)) no-repeat 0 100%/100% 1px,linear-gradient(currentColor,currentColor) no-repeat 100% 100%/0 1px;transition:background-size 200ms var(--e-out)}
.end .ul:hover,.end .ul:focus-visible{background-size:100% 1px,100% 1px;background-position:0 100%,0 100%}
.end .pill-btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 22px;border-radius:999px;font:inherit;font-size:15px;font-weight:650;line-height:1;text-decoration:none;color:var(--ink);background:transparent;border:1px solid var(--edge);transition:transform 120ms var(--e-out),background-color 200ms var(--e-out)}
.end .pill-btn.primary{background:var(--btn);color:var(--on-btn);border-color:var(--btn)}
.end .pill-btn:active{transform:scale(.97)}
@media (hover:hover) and (pointer:fine){
  .end .pill-btn:hover{background:color-mix(in oklab,var(--ink) 7%,transparent)}
  .end .pill-btn.primary:hover{background:color-mix(in oklab,var(--btn) 84%,var(--bg))}
}
.end .ct{padding:104px 0 0;display:block;max-width:none;margin:0}
.end .ct h2{font-size:clamp(56px,9vw,136px);font-weight:800;font-stretch:75%;line-height:.92;letter-spacing:-.025em;max-width:12ch;color:var(--ink)}
.end .sub{margin:18px 0 40px;font-size:clamp(22px,2.4vw,32px);font-weight:600;line-height:1.2;color:var(--t-acc)}
.end .cta{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:28px}
@media (min-width:1024px){
  .end .ct .c{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:32px;align-items:end}
  .end .ct-l{grid-column:1/8}
  .end .sub{margin-bottom:0}
  .end .ct-r{grid-column:8/13;padding-bottom:8px}
}
.end .foot{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px;margin-top:112px;padding:28px 0 32px;border-top:1px solid var(--line);font-size:15px}
.end .social{display:flex;flex-wrap:wrap;gap:8px 24px}
.end .social a{position:relative;padding:10px 8px;margin-inline:-8px;min-width:24px;text-align:center;background-origin:content-box;background-clip:content-box}
.end .social a::after{content:"";position:absolute;inset:50% auto auto 50%;width:max(100%,44px);height:max(100%,44px);translate:-50% -50%}
.end .copyr{color:var(--muted)}
.end :focus-visible{outline:2px solid var(--ink);outline-offset:3px;border-radius:4px}
@media (max-width:759px){
  .end{--e-gut:16px;margin:112px calc(8px - var(--page-pad,0px)) 8px;border-radius:24px}
  .end .ct{padding-top:56px}
  .end .ct h2{font-size:52px}
  .end .sub{margin:12px 0 28px}
  .end .cta{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .end .cta .pill-btn{min-height:52px;padding:0 12px;white-space:nowrap}
  .end .foot{flex-direction:column;align-items:flex-start;margin-top:56px;padding-bottom:calc(32px + env(safe-area-inset-bottom))}
}
</style>
